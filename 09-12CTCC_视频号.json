// ============================================================================
// CTCC 职业联赛（上海站）2026-09-12 · 视频号直播
// （手机 App 竖屏 592×1280；渠道七七）→ 结构化评论
//
// 素材 = 「/run/media/puyu/MyDisk/2026-09-12艾瑞泽8CTCC职业联赛（上海站）（渠道七七）/
// 视频号/奇瑞汽车/14：35-17：47.mp4」——**一段**录屏 193.6min，
// **直播约 16:30 结束**，其后是「直播已结束」的推荐流 / 保险广告页 ⇒
// 预先裁到直播末帧 **6902.7s**（115.0min；
// 判据 = 底部输入栏 `聊一聊` 最后一次出现在 6903.02s，再留 0.2s 余量）：
//   /run/media/puyu/C0DE6A4BDE6A39B4/out/2026-09-12艾瑞泽8CTCC职业联赛（上海站）（渠道七七）/media/
//       wx_14-35-17-47_live.mp4
// ⚠ 裁切是 **stream copy**（PyAV add_stream_from_template，不重编码）。
//   裁掉的后段（约 78min）实测是整屏广告（`万能账户悄悄吃掉你的收益` 之类），
//   不裁会当成几万条匿名评论。
// 单段素材仍写成 videos 数组（长度 1）⇒ 输出落在 <output.dir>/seg1，
// 与同批抖音/快手保持同一目录结构（逐段步跑一遍、collect 拼树）。
//
// 行版式：`[✦N 等级药丸] [粉丝药丸] 昵称：正文`（与 08-08CTCC / 08-09CTCC 视频号同族）
//   · 等级药丸画在昵称左边（`1` x∈[38,63]），OCR 有时把它并进正文（`+1幽兰黛尔：` /
//     `1元重培姬子`）⇒ badge_alias 归一见 CONFIG.md 的同名小节。
//   · 行首「粉丝」药丸（关注了主播的人才有）被 OCR 并进正文时按 text + 几何剥掉
//     （`粉丝春日序：` x1=26 / `粉丝Y**来了` x1=27 ⇒ fan_badge_x_max=66，真昵称 x1≈69）。
//   · 本批**有打码昵称**（系统行 `可**`、评论人也有 `穿越**：` 这类读法）⇒
//     account_key=**nickname_level_if_masked**（打码才按 (昵称, 等级) 认人）。
//     这一口径会**自动打开** parse.badge_reread。
//   · 评论列表底部压**广告卡**（`奇瑞汽车` / `HER` / `点击了解详情`，
//     y≈1074~1132、x≈25~236）⇒ skip_phrases + overlay_cards 两道闸。
//   · 系统行：`X 来了` / `X 赞了直播` / `X 关注了主播`（内置表覆盖）。
//
// 这块素材量到的（2026-11-10，每文件 6 帧 + 直播段补采样，592×1280）：
//   ✅ 行距 **33.0**（续行间距 24.5~26.5、独立评论/通知行 32.5~41.5，
//      两簇分别在 0.74~0.80 / 0.98~1.26 行距）
//   ✅ 首行中心 ≈676（rect y1=660 ⇒ 相位 ≈16；逐帧还会重估，这个只兜底）
//   ✅ x_text **66**：等级药丸 `1` x∈[38,63] · 真昵称 x1≈68~69 ·
//      药丸/粉丝并进正文的读法 x1≈26~33 · 折行续行 x1≈19~26。
//      取 66：真昵称落在右边；纯药丸碎片整块落在左边被丢；带冒号的正文不受影响。
//   ✅ 折行续行 ~24.5~26.5px = **0.74~0.80 行距** ⇒ wrap_gap_ratio **0.85**
//      （独立行 ≥32.5px = 0.98~1.26 行距）；续行顶在左沿 ⇒ wrap_indent 必开
//   ✅ rect **[0,660,592,1190]**：评论列表顶 ≈660（系统行 `可**来了` 在 619~647，
//      已切在外面）；输入栏 `聊一聊` 实测 1201~1229 ⇒ y2=1190 切在它之上；
//      x2=592 满宽（x2_from=window）。
//   ✅ 评论正文右沿最大 422；右侧旋转/礼物图标 x1≥500 ⇒ x_ignore_from=500。
//   ✅ 表情用视频号那套表（/run/media/puyu/C0DE6A4BDE6A39B4/out/wechat_emoji/wechat-emoji.json，109 个模板）
//   ⚠ 冒号：与 2026-11-01 给三个视频号账号加的口径一致（气泡半透明、底偏亮），
//      带 colon_bg_max_v / colon_v_delta / colon_text_fix* 三个 opt-in 键。
//
// 跑法（OCR 要带 rapidocr 的解释器）：
//   P=/home/puyu/anaconda3/envs/vlx/bin/python
//   ① 抽行（慢；裁后约 1.9h 直播）：
//        export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
//        $P -m livepipe run 09-12CTCC_视频号.json --only panels,parse
//        ⚠ 中断了直接重跑同一条命令：<段目录>/rows.jsonl 已在 ⇒ 自动零 OCR 复算/续跑。
//   ② 筛 + 判合格 + 出图 + 拼交付树（**要 key**，只走环境变量）：
//        NLP_API_KEY=sk-xxxx $P -m livepipe run 09-12CTCC_视频号.json \
//            --only filter,qualify,export,collect
//   ③ 先看后交：产物在
//        /run/media/puyu/C0DE6A4BDE6A39B4/out/2026-09-12艾瑞泽8CTCC职业联赛（上海站）（渠道七七）/视频号/all_users_正面_3张以上/
//
// 校验（不跑、安全）：
//   python3 -m livepipe check 09-12CTCC_视频号.json
//   python3 -m livepipe run   09-12CTCC_视频号.json --dry-run
// ============================================================================
{
  "base_dir": "/run/media/puyu/C0DE6A4BDE6A39B4",
  "version": 1,
  "name": "CTCC职业联赛 2026-09-12（上海站）（渠道七七）· 视频号手机 App · 竖屏",

  // -------------------------------------------------------------------------
  // 平台档案：面板文件里只填平台名，行距 / 表情表 / 裁切策略 / 药丸闸都从这里取。
  // 与 08-08CTCC / 08-09CTCC 的 `wechat_app` 同一版式；本件的数字按本素材复核。
  // -------------------------------------------------------------------------
  "platforms": {
    "wechat_app": {
      "label": "视频号直播（手机 App 竖屏；等级标 ✦N 在昵称左边，行首还可能有「粉丝」药丸）",
      "emoji": "wechat",                // → emoji.tables 的 wechat 表（内置，表已建好）

      // 交付认人口径：本批有打码昵称也有真昵称 ⇒ 只有打码名才按等级拆。
      //   见 livepipe/account_id.py 的 `nickname_level_if_masked` 小节。
      "account_key": "nickname_level_if_masked",

      // 行距（像素）—— **实测**（2026-11-10，每文件 6 帧 + 直播段补采样）：
      //   续行间距 24.5~26.5、独立评论/通知行 32.5~41.5；取 33.0。
      "row_pitch": 33.0,

      // 首行中心距面板顶（裁剪内坐标）—— 实测相位 **16**（首行中心 ≈676，rect y1=660）；
      //   逐帧还会重估，这个只兜底。
      "y_phase": 16,

      // 正文列左沿（徽章列右沿，**裁剪内**坐标；rect x1=0 ⇒ 原图坐标）—— **实测**：
      //   等级药丸 `1` x∈[38,63] · 真昵称块 x1≈68~69 · 药丸/粉丝并进正文的读法
      //   x1≈26~33。取 **66**（< 真昵称最小左沿 68），否则真昵称整块被当徽章碎片丢掉。
      "x_text": 66,

      // ROI 左沿（标注图/交付裁图圈的那一圈）—— 徽章列宽：66−44 = 22 圈住整颗药丸。
      "badge_span": 44,

      // 裁切右沿：**取窗口右沿**（App 评论列表满宽、不随内容伸缩）——超集，按构造不裁内容。
      "x2_from": "window",

      // 行首「粉丝」药丸被 OCR 并进正文时的几何闸：本批药丸行 x1≈26~27，
      //   真昵称从 x≈68 起 ⇒ 取 **66**（药丸行在闸内、真昵称在闸外）。
      "fan_badge_x_max": 66,

      // 允许「粉丝」药丸前还并着一个等级药丸（`+1粉丝若云：…`）。
      "fan_badge_with_level": true,

      // 行首等级药丸被 OCR 并进正文（`+1幽兰黛尔：` / `1元重培姬子`）⇒ 同一人被读成
      //   好几个账号，按几何见证归一（normalize_badge_alias）。
      "badge_alias": true,
      // 昵称末尾被检测框切掉 1~2px / 整个末字漏读 ⇒ 同一人被拆成两个账号，
      //   按「同一条评论的两种读法同现」归一（normalize_username_alias）。
      "username_alias": true,

      // 折行续行：本批续行顶在左沿（x1≈19~26），与首行同左沿 ⇒ 形状判据需要这个开关
      //   才能把「x1 < x_text 的无冒号块」当续行候选，再由间距闸定去留。
      "wrap_indent": true,

      // 续行间距比上限 —— 实测续行 24.5~26.5px = **0.74~0.80 行距**；
      //   独立评论/通知行实测 32.5~41.5px = 0.98~1.26 行距。取 0.85 夹在两簇中间。
      "wrap_gap_ratio": 0.85,

      // 直播间浮层/图标的左界（裁剪内 x）—— **实测**写死：评论正文块 x2 都 ≤422、
      //   右侧旋转/礼物图标 x1≥500 ⇒ 空带取 **500**。
      "x_ignore_from": 500,

      // 评论列表上的浮层卡（不是评论、又没有冒号）。内置表认「提示卡 / 主题卡 /
      //   公众号卡 / 点击了解详情」；本素材底部广告卡还有品牌行 `奇瑞汽车`（x1=111）
      //   和残块 `HER`（x1=25）—— 内置表故意不按内容猜品牌名（会误伤真评论的续行），
      //   所以在**素材级**补上（只作用于没有冒号的行）。
      "overlay_cards": "^奇瑞汽车$|^HER$",

      // 本场要**整行跳过**的词（opt-in，解析层 `parse_live_rows`）：整行（忽略空白）
      //   等于其中任一词就丢掉这一行。只认**整行**、不按后缀剥 —— 所以正文里提到
      //   `奇瑞汽车` 的真评论（`小王：奇瑞汽车真不错`）不受影响。
      //   典型：广告卡（`奇瑞汽车` / `HER` / `点击了解详情`）、主题卡第二行。
      "skip_phrases": [
        "奇瑞汽车>",
        "奇瑞汽车",
        "公众号奇瑞汽车>",
        "HER",
        "点击了解详情",
        "CTCC中国汽车场地职业联赛",
        "2026CTCC中国汽车场地职业联赛"
      ],

      // 冒号像素检测阈值（见 parsing/ocr/colon.py）：视频号气泡半透明、底偏亮，
      //   默认 bg_max_v=110 会整类短路 ⇒ 放开背景亮度、把亮度差降到 30。
      "colon_bg_max_v": 255,
      "colon_v_delta": 30,

      // OCR 把冒号吃掉时，按像素位置补回文本；打码昵称单星号形态也放行。
      "colon_text_fix": true,
      "colon_text_fix_masked_only": true
    }
  },

  // 表情表用内置的 `wechat`（/run/media/puyu/C0DE6A4BDE6A39B4/out/wechat_emoji/wechat-emoji.json）。
  // ⚠ 表是 **JSON + img/ 图片** 两部分；upload_livepipe_ssh.py 只传表 JSON、
  //   不传 img/（109 张 png）⇒ 远程解析时 109 条模板全缺图，会打
  //   "一条可用的模板都没有（图没下全？）" 并跳过表情识别。
  //   ⇒ 打开 build.enabled：run.sh 开头的预建表步骤在**远程**从
  //   codeload.github.com 拉 tarball（4.7MB，实测 2s）解出 img/ 再建表，
  //   落 <base_dir>/out/wechat_emoji/。本机 steps.skip 含 emoji_tables，不会重复建。
  //   不想刷新用 `LIVEPIPE_SKIP_EMOJI=1 ./run.sh …`。
  "emoji": {
    "tables": {
      "wechat": {
        "build": {"enabled": true}
      }
    }
  },

  "input": {
    // 单段素材也写成**数组**（长度 1）⇒ 与同批抖音/快手一样落 <output.dir>/seg1。
    "videos": [
      "/run/media/puyu/C0DE6A4BDE6A39B4/out/2026-09-12艾瑞泽8CTCC职业联赛（上海站）（渠道七七）/media/wx_14-35-17-47_live.mp4"
    ],
    "segment_names": null,              // 段名（= 子目录名）；null ⇒ seg1
    "video": null,                      // 单段写法（与 videos 互斥，本件用不到）              --video
    "rows": null,                       // 单段复算用；多段不用写（<段目录>/rows.jsonl 在就自动复算）
    "text": null,                       // 纯文本行文件；"-" 读 stdin                            --text
    "start": 0.0,                       // 起始时间（秒）                                      --start
    "duration": null,                   // 处理多长（秒）；null = 整段                          --duration
    "interval": 2.0,                    // 固定间隔抽样用（本件用 adaptive，此项不生效）          --interval
    "max_frames": null,                 // 最多抽几帧；null = 不限                              --max-frames
    "resume": true,                     // 断点续跑：rows.jsonl 已在就接着它跑（已处理帧跳过）   --resume

    // 抽帧策略：手机 App 是平滑滚动 ⇒ 长录屏用 adaptive（静止段几乎不拍、滚动段不漏条）。
    "sample": {
      "mode": "adaptive",               //   interval / backoff / adaptive                     --sample-mode
      "stride": 2,                      //   每 N 个解码帧估一次位移（1 = 每帧都估）
      "safety_rows": 5.0,               //   累计位移 ≥ 这么多行 ⇒ 强制拍（上限 5）
      "settle_frames": 3,               //   动过之后静止这么多帧 ⇒ 拍一次
      "eps_px": 1.0,                    //   位移小于它算「没动」
      "entry_thr": 8.0,                 //   底部入口行变化多少像素算「新评论弹进来」
      "max_gap_s": 5.0,                 //   最长多久必须拍一次（0 = 不限）
      "min_interval": 0.2,              //   两次拍摄的最小间隔（秒）
      "max_interval": 6.0,              //   两次拍摄的最大间隔（秒）
      "min_score": 0.3                  //   位移估计的匹配分下限
    }
  },

  // -------------------------------------------------------------------------
  // 面板：**手写**（评论列表位置已量好，不需要再跑模型定位）。
  // rect 是**原图像素**的评论区窗口：[x1, y1, x2, y2]
  //   · y1=660：评论列表顶（首行中心 ≈676）；其上是直播画面；
  //   · y2=1190：输入栏 `聊一聊` 实测 1201~1229，切在它之上；
  //   · x1=0 / x2=592：App 列表满宽（x2_from=window 取窗口右沿）。
  //   · 改了 rect 直接重跑即可：manual 下配置是唯一来源（与面板文件不一致时按配置重写）。
  // -------------------------------------------------------------------------
  "panels": {
    "mode": "manual",                   // manual=手写面板直接写进 file（交付走 manual）
    "file": null,                       // null ⇒ 每段各一个 <段目录>/panels.json
    "files": null,                      // 也可显式一份一段地列出面板文件路径（顺序 = 段顺序）
    "overwrite": false,                 // manual：配置与面板文件不一致就按配置重写；locate：已存在就不动
    "auto": {                           // 自动定位参数（mode=locate/auto/batch 时用；本件用不到）
      "method": "hybrid",
      "at": 900,
      "frames": 5,
      "span": null,
      "split_x": null,                  //   ⚠ null = **不切分**（竖屏单直播间是一列评论）
      "pad_x": 60,
      "pad_top": 80,
      "pad_y": 16,
      "sub_width": 500,                 //   ⚠ 竖屏整帧裁切必须降下来，否则 4bit 模型 CUDA OOM
      "model": "nvidia/LocateAnything-3B",
      "quant": "4bit",
      "device": "cuda",
      "platforms": {                    //   只在 mode=auto/builtin/batch 时用
        "left": "wechat_app",           //   不切分后唯一的窗口叫 left
        "right": null
      },
      "frame_width": 592                //   x2_from=window 的窗口右沿兜底（本素材宽 592）
    },
    // mode=manual：手写面板，**一段一项**（顺序与 input.videos 的段顺序一致）。
    "manual": [
      {                                //   seg1  `wx_14-35-17-47_live.mp4`  592×1280
        "comments": {"rect": [0, 730, 592, 1190], "platform": "wechat_app"}
      }
    ],
    "batch": {                          // mode=batch：稳定性研究（挑固定矩形用；不动 file）
      "count": 30,
      "start": 0.0,
      "span": 600.0,
      "anchor": "panel"
    }
  },

  "parse": {
    "sep": " ",                         // 续行拼接用的分隔符                                      --sep
    "max_username_len": 24,             // 冒号前超过这个长度就不当用户名                          --max-username-len
    "merge_continuation": true,         // 是否把「无用户名的行」并进上一条评论                   取反 --no-merge
    "adjacency": true,                  // 「续行必须相邻」守卫                                  取反 --no-adjacency
    "dedup": true,                      // 按滚动对齐跨帧去重出唯一评论表                        取反 --no-dedup
    // 关掉自标定：行距/相位/浮层界都已实测写死；自标定只在开头采 4 帧，
    //   开场系统提示卡会把样本带偏（与 08-08 / 09-09 同口径）。
    "calibrate": false,                 // 面板几何自标定（行距/浮层右界/续行；相位逐帧估）      取反 --no-calibrate
    // badge_reread 不写：account_key=nickname_level_if_masked ⇒ 自动打开（打码名要等级标）。
    "right_pad": 0,                     // ROI 右边界距面板右边的余量；0 = 贴面板边圈住框外表情    --right-pad
    "emoji_workers": 8                  // 表情扫描线程数；只影响速度、不改变结果
  },

  "output": {
    // 单段也按多段目录走（<dir>/seg1）；跨段产物落在这儿：merged_users.json；
    // 交付树见 collect.out。
    "dir": "/run/media/puyu/C0DE6A4BDE6A39B4/out/2026-09-12艾瑞泽8CTCC职业联赛（上海站）（渠道七七）/视频号",
    "write": true,                      // 是否写盘（comments.jsonl + summary.json 成对）
    "rows": true,                       // 另存 rows.jsonl（**可回喂复算**）
    "panels": true,                     // mode=auto 时把定位结果存成 panels.json
    // frames：**抽样帧**一张图 frames/<t>_roi.jpg（≈0.55MB/张），不是每条评论一张。
    "frames": true,                     // 取反 --no-frames
    "print": false                      // 除写盘外也把评论打到 stdout                            --print
  },

  // 评论 → 合格用户：用户名 ≥min_positive 条**正面**评论（正面由大模型判定，表情也发），
  // 并排除用户名命中关键词的官方侧账号。**要花钱**；key **只走环境变量**（本项目铁律）。
  //
  // ⚠ 本件是**单段素材**，`min_positive: 1` 与 qualify 的合计口径一致（单段即合计）。
  "filter": {
    "enabled": true,                    // 打开才会调模型；只想抽评论就先 --skip filter
    "source": null,                     // 评论来源；null ⇒ <段目录>/comments.jsonl
    "out": null,                        // 合格用户 JSONL；null ⇒ <段目录>/users.jsonl
    "cache": null,                      // 判定缓存；null ⇒ <output.dir>/judgments.jsonl
    "min_positive": 1,                  // 单段阈值（合格交给 qualify 判）
    "exclude_keywords": [               // 用户名含任一即排除（不区分大小写）
      // ⚠ 沿用**奇瑞那条线**的表（品牌 + 4S + 车型 + 高管姓名）；CTCC 官方号 / 车队 /
      //   裁判 / 赞助商还没按本场补。填错的代价是把真观众挡在名单外 ⇒ 等名单出来再逐条加。
      "奇瑞", "4s", "店", "qq3", "汽车",
      "尹同跃", "张国忠", "鲍思语", "王津华", "王孝伟", "胡敬源", "尹祥领",
      "王来春", "李晶", "商文江", "杨棉之", "叶盛基", "路风", "黎汝雄",
      "李学用", "张贵兵", "代立宏", "章红玉", "高新华", "戚士龙", "王琅"
    ],
    "nlp": {
      "api_key": null,                  // **留 null**：key 只走环境变量（本项目铁律）
      "api_key_env": "NLP_API_KEY",     // ← 环境变量的**名字**（把 key 写到这行永远取不到）
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "deepseek-v4.1-flash",   // ⚠ 模型名会随平台改，写错就是 404（不是 key 的问题）
      "batch_size": 20,
      "concurrency": 4,
      "timeout": 60.0,
      "retries": 3,
      "limit": null,                    // 最多调多少批（控成本）
      "prompt": null                    // null ⇒ 用 user_filter.DEFAULT_PROMPT
    }
  },

  // -------------------------------------------------------------------------
  // 跨段的两步（顺序有依赖：filter（逐段）→ qualify（跨段）→ export（逐段）→ collect（拼树））
  // -------------------------------------------------------------------------

  // 跨段判合格（**全局步**）：单段素材退化成「按本段判」，但保持与同批其它配置同结构。
  "qualify": {
    "enabled": true,
    "min_positive": 3,                  // 交付阈值（单段 = 本段正面 ≥3 条）—— 与 08-09CTCC 一致
    "stage_min": 1                      // filter/export 用的阈值（先出全量，合格留给这一步判）
  },

  // 逐段出交付图（**逐段步**）：读该段 users_qualified.jsonl，按**原帧**画绿框，一人一个目录
  // `<昵称>-<本段条数>`。
  "export": {
    "enabled": true,
    "base": "frame",                    // frame=原帧（参考语料形态）/ annotated=标注图      --base
    "labels": "正面",                   // 只出正面评论                                        --labels
    "min_positive": null,               // null ⇒ qualify.stage_min（合格已在 qualify 判完）
    "min_scope": "platform",            // 平台内各自够数                                       --min-scope
    "users": null,                      // null ⇒ <段目录>/users_qualified.jsonl
    "color": "0,255,0", "width": 3,     // 绿框（对齐参考语料）
    "pad": 0, "pad_ratio": 0.25, "quality": 90,
    "force": true                       // 重跑覆盖上一轮的导出目录
  },

  // 拼最终交付树（**全局步**）：把导出目录按账号身份整理成一人一个目录、图号 1..N，
  // 后缀取**合计**条数，顺带写 正面账号.txt + manifest.json。
  // out 显式写死：output.dir 已经带 `/视频号`，再让 collect 自动拼 `<平台目录>` 会变成
  // …/视频号/视频号/…。
  "collect": {
    "enabled": true,
    "stage_min": null,                  // 各段导出目录名里的数字；null ⇒ qualify.stage_min
    "platform_dir": null,               // 交付树里的平台目录名；null ⇒ 自动认（视频号）
    "out": "/run/media/puyu/C0DE6A4BDE6A39B4/out/2026-09-12艾瑞泽8CTCC职业联赛（上海站）（渠道七七）/视频号/all_users_正面_3张以上",
    "force": true                       // 目标非空时整棵重来（否则报错退出）
  },

  "draw": {                             // 独立描框步骤（draw_boxes.py）；核心解析已自带逐帧标注图，默认关
    "enabled": true,
    "source": null,
    "at": 8.0,
    "window": 5.0,
    "out": null,
    "width": 5,
    "quality": 90,
    "labels": true
  },

  "steps": {
    // 顺序**不能乱**：filter（逐段）→ qualify（跨段判合格）→ export（逐段）→ collect（拼树）。
    "order": ["emoji_tables", "panels", "parse", "filter", "qualify",
              "export", "collect", "draw"],
    "skip": ["emoji_tables", "draw"]    // 表情表已建好（/run/media/puyu/C0DE6A4BDE6A39B4/out/wechat_emoji/）；独立描框用不上
  }
}
