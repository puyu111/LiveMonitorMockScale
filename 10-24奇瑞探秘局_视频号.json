// （手机 App 竖屏 590×1280）→ 结构化评论
//
// 素材 = OSS `web/1/奇瑞汽车/直播看管/直播录屏/奇瑞探秘局/10.24/` 下按时间顺序的
// **四段**录屏（账号「奇瑞探秘局」，上午两场 + 下午两场）；2026-11-19 从百度
// `/直播录屏/奇瑞探秘局/` 直写入 OSS（字节与本地 MyDisk 原件逐一相同）：
//   seg1  `上午/8： 43-9： 40.mp4`     57.7min  直播到文件末尾
//   seg2  `上午/9： 41-10： 25.mp4`    44.9min  直播在 **1432.10s** 结束，之后是「直播已结束」页
//   seg3  `下午/12： 56-14： 10.mp4`   74.9min  直播到文件末尾
//   seg4  `下午/14： 10-14： 39.mp4`   29.9min  直播在 **1332.44s** 结束，之后是「直播已结束」页
//   ⇒ seg2 / seg4 已用 PyAV 判定最后直播帧后**无损流拷贝**裁掉结束页，裁后副本在
//       OSS `10.24/_live/`：
//       wx_am_09-41-10-25_live.mp4（1431.9s）· wx_pm_14-10-14-39_live.mp4（1332.2s）
//     判定口径只认**底部输入栏 `聊一聊`**（用 seg1 的输入栏模板做 NCC；
//     「直播已结束」字样出现时间不稳定，不可靠）。裁后末帧仍有 `聊一聊`。
//   录屏文件的 ffprobe creation_time（UTC）= 2026-10-24T01:41 / 02:26 / 06:10 / 06:40
//   ⇒ 北京时间 09:41 / 10:26 / 14:10 / 14:40，与文件名时间一致，确认本批为 10-24。
//
// ⚠ 素材目录里**只有视频号**（没有抖音 / 快手目录），所以本批只建这一份配置。
//   对应的撞库名单：`撞库名单/可用名单/10-24/10-24_探秘局_昵称.txt`（19 个昵称）。
//
// 量到的版式（2026-11-16，四段各 3 帧 + 逐帧扫描，全部 590×1280）：
//   ✅ 行距 **41.5**（相邻评论首行中心差 41~41.5，64 个样本；与 09-16 老章同网格）
//      rect y1=660 ⇒ 相位 **33**（评论首行中心 718~1150，mod 41.5 后落在 33）
//      x_text **64**（徽章列右沿）：无药丸昵称块 x1≈35~37 · 带药丸昵称 x1≈68~71 ·
//      ✦N 药丸块 x∈[32,46] · 续行 x1≈21~34
//      rect [0,660,590,1190]：视频画面下沿 ≈644（640 之后一行内从亮画面掉到暗底 48），
//        660 在它之下、封面/视频里的文字（最下到 y≈622）之上；
//        输入栏 `聊一聊` 上沿 1203 ⇒ y2=1190
//   ✅ 表情用内置 wechat 表（/home/puyu/oss-bucket/web/1/奇瑞汽车/直播看管/素材/out/wechat_emoji/wechat-emoji.json，109 个模板）
//   ⚠ 续行是**缩进/贴左沿**的（x1≈21~34）⇒ 必须开 wrap_indent；
//      续行间距实测 25~26.5px = 0.60~0.64 行距，独立行 41~42px≈1.0
//      ⇒ wrap_gap_ratio 取 **0.75**（31.1px）夹在两簇中间
//   ⚠ 评论昵称基本不打码（本批采样 0 条含 `*` 的昵称）⇒ account_key=username
//   ⚠ 评论区顶部会出现两类**常驻卡片**（只作用于没有冒号的行）：
//      ① 反诈提示卡：`通知` + 6 行「欢迎来到直播间。直播间内禁止未成年…及时投诉」
//      ② 主题卡：`主题` + `CTCC中国汽车场地职业联赛`
//      ⇒ overlay_cards 覆盖逐行短语，skip_phrases 整行丢掉 `通知`/`主题`/主题名。
//   右侧浮层：评论正文块 x1 都 ≤71（正文最长 x2≈430），分享图标在 x≈531
//   ⇒ x_ignore_from=350 兜底。
//
// 跑法（OCR 要带 rapidocr 的解释器）：
//   P=/home/puyu/anaconda3/envs/vlx/bin/python
//   ① 抽行（四段合计约 2.3h 录屏）：
//        export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
//        $P -m livepipe run 10-24奇瑞探秘局_视频号.json --only panels,parse
//        ⚠ 中断了直接重跑同一条命令：<段目录>/rows.jsonl 已在 ⇒ 自动零 OCR 复算/续跑。
//   ② 筛 + 判合格 + 出图 + 拼交付树（**要 key**，只走环境变量）：
//        NLP_API_KEY=sk-xxxx $P -m livepipe run 10-24奇瑞探秘局_视频号.json \
//            --only filter,qualify,export,collect
//   ③ 先看后交：产物在
//        /home/puyu/oss-bucket/web/1/奇瑞汽车/直播看管/直播产生结果/2026-10-24奇瑞探秘局/视频号/all_users_正面_3张以上/
//   ④ 撞库（名单只有昵称一列）：
//        $P -m livepipe match 撞库名单/可用名单/10-24/10-24_探秘局_昵称.txt \
//            /home/puyu/oss-bucket/web/1/奇瑞汽车/直播看管/直播产生结果/2026-10-24奇瑞探秘局/视频号 --platform 视频号
//
// 校验（不跑、安全）：
//   python3 -m livepipe check 10-24奇瑞探秘局_视频号.json
//   python3 -m livepipe run   10-24奇瑞探秘局_视频号.json --dry-run
// ============================================================================
{
  "base_dir": "/home/puyu/oss-bucket/web/1/奇瑞汽车/直播看管/素材",
  "version": 1,
  "name": "奇瑞探秘局 2026-10-24 · 视频号手机 App · 竖屏",

  // -------------------------------------------------------------------------
  // 平台档案：四段同一台设备、同一版 App（590×1280）⇒ 一套数字共用。
  // -------------------------------------------------------------------------
  "platforms": {
    "wechat_app": {
      "label": "视频号直播（手机 App 竖屏；等级标 ✦N 在昵称左边）",
      "emoji": "wechat",                // → /home/puyu/oss-bucket/web/1/奇瑞汽车/直播看管/素材/out/wechat_emoji/wechat-emoji.json

      // 本批评论昵称基本不打码 ⇒ 只看昵称。
      "account_key": "username",

      // 行距（像素）—— **实测**（2026-11-16，四段各 3 帧）：相邻评论首行中心差
      //   众数 41.5（64 个样本，41.0~42.5）。
      "row_pitch": 41.5,

      // 首行中心距面板顶（裁剪内坐标）—— rect y1=660 ⇒ 评论首行中心 718~1150
      //   mod 41.5 后稳定落在 **33**（取多帧循环平均）。
      "y_phase": 33,

      // 正文列左沿（徽章列右沿，**裁剪内**坐标）—— **实测**：
      //   无药丸昵称块 x1≈35~37 · 带药丸昵称 x1≈68~71 · ✦N 药丸块 x∈[32,46] ·
      //   续行 x1≈21~34。取 **64**：无冒号的药丸碎片整块落在左边被丢；
      //   带冒号的评论无论 x1 多大都保留。
      "x_text": 64,

      // 徽章列宽（ROI 左沿 = x_text − badge_span）—— 64−46 = 18 圈住 ✦N 药丸。
      "badge_span": 46,

      // 裁切右沿：**取窗口右沿**（App 评论列表满宽、不随内容伸缩）。
      "x2_from": "window",

      // 折行续行：视频号的续行**贴左沿/缩进**（x1≈21~34），而本档案 x_text=64
      //   ⇒ 必须显式开 wrap_indent。
      "wrap_indent": true,

      // 续行间距比上限 —— 实测续行 25~26.5px = **0.60~0.64 行距**；独立行 41~42px≈1.0。
      //   取 **0.75**（31.1px）夹在两簇中间；0.85 会误并 35px 的独立行。
      "wrap_gap_ratio": 0.75,

      // 行首等级药丸被 OCR 并进正文 / 昵称末尾被切 1~2px ⇒ 同一人多种读法归一。
      "badge_alias": true,
      "username_alias": true,

      // 右侧浮层左界（裁剪内 x）—— **实测**：评论正文块 x1 都 ≤71（正文最长 x2≈430），
      //   分享图标在 x≈531 ⇒ 取 **350** 兜底。
      "x_ignore_from": 350,

      // 冒号像素检测阈值（见 parsing/ocr/colon.py）：视频号气泡半透明、底偏亮，
      //   默认 bg_max_v=110 会整类短路 ⇒ 放开背景亮度、把亮度差降到 30。
      "colon_bg_max_v": 255,
      "colon_v_delta": 30,
      "colon_v_min": 80,
      "colon_text_fix": true,
      "colon_text_fix_masked_only": true,

      // 评论列表上的浮层卡 / 通知（**只作用于没有冒号的行**）：
      //   反诈提示卡逐行、主题卡标签、分享图标、直播结束后的推荐页、纯拉丁/数字行。
      "overlay_cards": "欢迎来到直播间|直播间内禁|未成年人打赏|禁止主播|诱导观|私下交易|违法违规|色情低俗|诱导欺诈|抽烟酗酒|理性消费|谨慎判断|财产及人身损失|及时投诉|^通知$|^主题$|^口$|^》口$|^\\+\\+$|推荐了直播|直播已结束|推荐直播|前往直播广场|加入粉丝团|送出粉丝牌|等\\d+人在说|人在说|^[A-Za-z0-9@#%&+=×?·._\\-/]{1,16}$",

      // 整行**完全等于**这些词就丢（忽略空白）。只认整行，真评论（`小王：…`）不受影响。
      //   典型：反诈卡的 `通知` 标签、主题卡的 `主题` 标签与主题名、直播结束页按钮。
      "skip_phrases": [
        "通知",
        "主题",
        "CTCC中国汽车场地职业联赛",
        "2026CTCC中国汽车场地职业联赛",
        "直播已结束",
        "推荐直播",
        "前往直播广场",
        "广告",
        "点击了解详情"
      ]
    }
  },

  // 表情表用内置的 `wechat`（/home/puyu/oss-bucket/web/1/奇瑞汽车/直播看管/素材/out/wechat_emoji/wechat-emoji.json）。
  // ⚠ 远程只传表 JSON、不传 img/ ⇒ 打开 build.enabled，run.sh 预建表步骤在远程
  //   从 codeload.github.com 拉 tarball 重建。本机 steps.skip 含 emoji_tables，不会重复建。
  "emoji": {
    "enabled": true,
    "tables": {
      "wechat": {
        "build": {"enabled": true}
      }
    }
  },

  "input": {
    // 四段素材：**显式数组**（段顺序 = 时间顺序），全部读 OSS（`~/oss-bucket` 挂桶根）。
    //   seg2 / seg4 用裁掉「直播已结束」页的副本（见文件头 ⚠）。
    "videos": [
      "/home/puyu/oss-bucket/web/1/奇瑞汽车/直播看管/直播录屏/奇瑞探秘局/10.24/上午/8： 43-9： 40.mp4",
      "/home/puyu/oss-bucket/web/1/奇瑞汽车/直播看管/直播录屏/奇瑞探秘局/10.24/_live/wx_am_09-41-10-25_live.mp4",
      "/home/puyu/oss-bucket/web/1/奇瑞汽车/直播看管/直播录屏/奇瑞探秘局/10.24/下午/12： 56-14： 10.mp4",
      "/home/puyu/oss-bucket/web/1/奇瑞汽车/直播看管/直播录屏/奇瑞探秘局/10.24/_live/wx_pm_14-10-14-39_live.mp4"
    ],
    "segment_names": null,              // 段名（= 子目录名）；null ⇒ seg1..seg4
    "video": null,                      // 单段写法（与 videos 互斥，本件用不到）
    "rows": null,                       // 单段复算用；多段不用写（<段目录>/rows.jsonl 在就自动复算）
    "text": null,                       // 纯文本行文件；"-" 读 stdin
    "start": 0.0,                       // 起始时间（秒）
    "duration": null,                   // 处理多长（秒）；null = 整段
    "interval": 2.0,                    // 固定间隔抽样用（本件用 adaptive，此项不生效）
    "max_frames": null,                 // 最多抽几帧；null = 不限
    "resume": true,                     // 断点续跑：rows.jsonl 已在就接着它跑

    // 抽帧策略：手机 App 是平滑滚动 ⇒ 长录屏用 adaptive。
    "sample": {
      "mode": "adaptive",
      "stride": 2,
      "safety_rows": 5.0,
      "settle_frames": 3,
      "eps_px": 1.0,
      "entry_thr": 8.0,
      "max_gap_s": 5.0,
      "min_interval": 0.2,
      "max_interval": 6.0,
      "min_score": 0.3
    }
  },

  // 面板：**手写**（评论区位置已量好；四段同一设备同一 App 版式）。
  // rect 是**原图像素**的评论区窗口：[x1, y1, x2, y2]
  //   · y1=660：视频画面下沿 ≈644；660 在它之下、视频里的文字（最下 y≈622）之上；
  //   · y2=1190：输入栏 `聊一聊` 上沿实测 1203，切在它之上；
  //   · x1=0 / x2=590：列表满宽（x2_from=window）。
  //   · 四段同一台设备、同一版 App（590×1280）⇒ 共用一套 rect。
  "panels": {
    "mode": "manual",
    "file": null,
    "files": null,
    "overwrite": false,
    "auto": {
      "method": "hybrid",
      "at": 900,
      "frames": 5,
      "span": null,
      "split_x": null,                  // null = 不切分（竖屏单直播间是一列评论）
      "pad_x": 60,
      "pad_top": 80,
      "pad_y": 16,
      "sub_width": 500,
      "model": "nvidia/LocateAnything-3B",
      "quant": "4bit",
      "device": "cuda",
      "platforms": {"left": "wechat_app", "right": null},
      "frame_width": 590
    },
    // mode=manual：手写面板，**一段一项**（顺序与 input.videos 的段顺序一致）。
    "manual": [
      {  //   seg1  `8： 43-9： 40.mp4`  直播到文件末尾
        "comments": {"rect": [0, 660, 590, 1190], "platform": "wechat_app"}
      },
      {  //   seg2  `wx_am_09-41-10-25_live.mp4`（裁后 1431.9s）
        "comments": {"rect": [0, 660, 590, 1190], "platform": "wechat_app"}
      },
      {  //   seg3  `12： 56-14： 10.mp4`  直播到文件末尾
        "comments": {"rect": [0, 660, 590, 1190], "platform": "wechat_app"}
      },
      {  //   seg4  `wx_pm_14-10-14-39_live.mp4`（裁后 1332.2s）
        "comments": {"rect": [0, 660, 590, 1190], "platform": "wechat_app"}
      }
    ],
    "batch": {"count": 30, "start": 0.0, "span": 600.0, "anchor": "panel"}
  },

  "parse": {
    "sep": " ",
    "max_username_len": 24,
    "merge_continuation": true,
    "adjacency": true,
    "dedup": true,
    // 自标定关掉：行距/相位/续行开关都已实测写死；开场有整屏通知卡，样本会被带偏
    //（与 10-31 / 09-16 / 10-04 视频号同口径）。
    "calibrate": false,
    "right_pad": 0,
    "emoji_workers": 8
  },

  "output": {
    // 多段时这是段的父目录：实际各写 <dir>/seg1..seg4；
    // 跨段产物（merged_users.json）落在这儿；交付树见 collect.out。
    // ⚠ 结果也直接写 OSS（直播产生结果/…），不在本地留产物。
    "dir": "/home/puyu/oss-bucket/web/1/奇瑞汽车/直播看管/直播产生结果/2026-10-24奇瑞探秘局/视频号",
    "write": true,
    "rows": true,
    "panels": true,
    "frames": true,
    "print": false
  },

  // 评论 → 合格用户。**要花钱**；key 只走环境变量（项目铁律）。
  // 四段素材：逐段先出全量（min_positive=1），跨段合计交给 qualify。
  "filter": {
    "enabled": true,
    "source": null,
    "out": null,
    "cache": null,
    "min_positive": 1,
    "exclude_keywords": [
      "奇瑞", "4s", "店", "qq3", "汽车",
      "尹同跃", "张国忠", "鲍思语", "王津华", "王孝伟", "胡敬源", "尹祥领",
      "王来春", "李晶", "商文江", "杨棉之", "叶盛基", "路风", "黎汝雄",
      "李学用", "张贵兵", "代立宏", "章红玉", "高新华", "戚士龙", "王琅"
    ],
    "nlp": {
      "api_key": null,                  // **留 null**：key 只走环境变量（本项目铁律）
      "api_key_env": "NLP_API_KEY",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "deepseek-v4.1-flash",
      "batch_size": 20,
      "concurrency": 4,
      "timeout": 60.0,
      "retries": 3,
      "limit": null,
      "prompt": null
    }
  },

  // 跨段判合格：按账号**合计**正面条数，≥3 条回写到每段 users_qualified.jsonl。
  "qualify": {
    "enabled": true,
    "min_positive": 3,
    "stage_min": 1
  },

  // 逐段出交付图：读 users_qualified.jsonl，按原帧画绿框，一人一个目录。
  "export": {
    "enabled": true,
    "base": "frame",
    "labels": "正面",
    "min_positive": null,
    "min_scope": "platform",
    "users": null,
    "color": "0,255,0", "width": 3,
    "pad": 0, "pad_ratio": 0.25, "quality": 90,
    "force": true
  },

  // 拼最终交付树：同名账号合并、图号跨段连续。
  "collect": {
    "enabled": true,
    "stage_min": null,
    "platform_dir": null,
    "out": "/home/puyu/oss-bucket/web/1/奇瑞汽车/直播看管/直播产生结果/2026-10-24奇瑞探秘局/视频号/all_users_正面_3张以上",
    "force": true
  },

  "draw": {"enabled": true, "source": null, "at": 8.0, "window": 5.0,
           "out": null, "width": 5, "quality": 90, "labels": true},

  "steps": {
    "order": ["emoji_tables", "panels", "parse", "filter", "qualify",
              "export", "collect", "draw"],
    "skip": ["emoji_tables", "draw"]
  }
}
