// ============================================================================
// 风云A9L年型车上市直播维护 2026-08-07 · 抖音直播（手机 App 竖屏）→ 结构化评论
//
// 素材 = 「10-2026-08-07风云A9L年型车上市直播维护」抖音/ 下的**两段**录屏
// （同一场直播、时间**不重叠**，中间 9：34~9：49 缺录）：
//   seg1  `8：35-9：34.mp4`   720×1600  58.7min
//   seg2  `9：49-10：13.mp4`  720×1600  24.2min
//   合计 82.9min。两段一次配全（input.videos 吃通配符，按文件名排序 = 时间顺序），
//   每段在 output.dir 下开一个子目录（seg1/seg2），逐段步各跑一遍、跨段步
//   （qualify/collect）整批跑一次。管线本身串行循环（并行 OCR 会 OOM）。
//
// 行版式：`[◆N 粉丝团药丸] 昵称***：正文`（与风云T7同族：药丸在昵称左边、独占徽章列）
//   · 药丸 = 菱形图标 + 粉丝团等级数字（`2`/`11`/`25`/`31`…），画在 x∈[38,96]；
//     OCR 有时把数字并进正文块（`11莲***：`），同一个人被算成好几个账号 ⇒ badge_alias。
//   · 昵称一律打码成 `X***`（抖音打 3 颗星）；**没有药丸**的观众（非粉丝团）昵称顶到 x≈35
//     （实测 `N***：姚飞是奇瑞集团级的吗？看着像领导`，x1=38）。
//   · 直播间右侧会压**商品讲解卡**（`讲解中` / `奇瑞风云` / 营销图 / `新款上市` / `16人已预约`），
//     实测左沿 477 ⇒ `x_ignore_from=460` 把卡块整块丢掉（见档案里该键的说明）。
//
// ⚠⚠ 平台名取 `douyin_app`（与风云T7同一个档案口径），**不要**用内置 `douyin`：
//   内置那份量的是**桌面网页版**（row_pitch 68 / y_phase 17 / x_text 70）。
//   本件的数字全部在下面重新量过（不是照抄风云T7），证据写在每个键的行内注释里。
//
// 这块素材量到的（2026-11-01，17 帧 × 720×1600）：
//   ✅ 行距 53.5（58 个相邻行中心差的中位；分布 52~56 占 2/3）
//   ✅ 相位 10（行中心 − 面板顶 的众数；逐帧估不准时兜底）
//   ✅ x_text 96（药丸列右沿：药丸 44~96、真昵称 100~176、正文 182~193 三簇分得开）
//   ✅ 裁切右沿按内容：评论侧文字右沿最大 **583** ⇒ rect x2 取 620
//   ✅ 浮层左界 460：卡片侧文字最小 x1 **477**、评论侧块 x1 都 <200 ⇒ 中间空带取 460
//   ✅ rect y1=1000（评论列表顶；其上是直播画面/多机位小窗）· y2=1420（输入框上沿 ≈1430，
//      `说点什么…` 占位文字在 1443~1476）
//   ✅ 表情用抖音那套表（out/douyin_emoji/douyin-emoji.json，已建好）
//   ⚠ 已知残留 / 风险（量的时候看见的，别当没发生）：
//      ① 顶部渐隐带（约 y1000~1040）里的评论 OCR 常读不出昵称（只读到正文）——
//         它们是往上滚之前的旧行，跨帧去重会用滚下来时的干净读数补上；y1 不再往上加，
//         再往上就进了直播画面/多机位小窗。
//      ② 商品卡的营销图里有文字（`进化不止 智领新章`、`2027款风云A9L 全球真C级旗舰`），
//         由 x_ignore_from 丢；卡**最左**那块实测 477，闸门 460 两边各留 ~17/23px。
//      ③ 长评论可能横向伸进卡片区间（评论侧实测 x2 最大 583 > 477）：若 OCR 把一行切成
//         「评论前段 + 卡块 + 评论后段」，后段（x1≥460）会被闸门丢掉 —— 与风云T7 seg7
//         同一个结构性代价，调这个数解决不了；宁可少后段，不把卡读成评论。
//      ④ `X***分享了直播` 这类系统行会漏成匿名评论（内置 `_NOTICE_RE` 没有 `分享了直播`）；
//         本件按项目惯例**不**在素材配置里塞正则（改内置表要在六套语料上逐条 diff）。
//      ⑤ 顶部 UI 通知 `非主驾开播 请注意驾驶安全`（x1≈56）落在徽章碎片带 [46,96)、
//         又没有冒号 ⇒ 按徽章碎片丢掉；另外也挂进了 overlay_cards 的短语表当第二道闸。
//      ⑥ 用户名仍有残留丢失：60s 试跑 seg1 10/34、seg2 19/41 条（约 3~5 成）。原因是
//         RapidOCR 把冒号读丢（约 1/4 行）而像素冒号也偶尔找不到（冒号点太小/压在半透明
//         滚动残影里）。已用 colon_* 三个键 + colon_text_fix 把能救的救回来；剩下的
//         属于 OCR 本身，调阈值收益递减，先照实交付并在名单里留意匿名项。
//
// 跑法（OCR 要带 rapidocr 的解释器）：
//   P=/home/puyu/anaconda3/envs/vlx/bin/python
//   ① 抽行（免费、慢：60s 切片实测两段共 ~5.8min ⇒ 83min 全量约 4~5h）：
//        export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
//        $P -m livepipe run 风云A9L.json --only panels,parse
//        ⚠ 中断了直接重跑同一条命令：<段目录>/rows.jsonl 已在 ⇒ 自动零 OCR 复算/续跑。
//   ② 筛 + 判合格 + 出图 + 拼交付树（**要 key**，只走环境变量）：
//        NLP_API_KEY=sk-xxxx $P -m livepipe run 风云A9L.json \
//            --only filter,qualify,export,collect
//   ③ 先看后交：产物在
//        out/10-2026-08-07风云A9L年型车上市直播维护/抖音/all_users_正面_2张以上/
//
// 校验（不跑、安全）：
//   python3 -m livepipe check 风云A9L.json
//   python3 -m livepipe run   风云A9L.json --dry-run
// ============================================================================
{
  "version": 1,
  "name": "风云A9L年型车上市维护 2026-08-07 · 抖音手机 App · 竖屏",

  // -------------------------------------------------------------------------
  // 平台档案：面板文件里只填平台名，行距 / 表情表 / 裁切策略 / 药丸闸都从这里取。
  // 与风云T7的 douyin_app 同一套版式，但每个数字都在本素材上重新量过。
  // -------------------------------------------------------------------------
  "platforms": {
    "douyin_app": {
      "label": "抖音直播（手机 App 竖屏；行首 ◆N 粉丝团药丸在昵称左边）",
      "emoji": "douyin",                // → emoji.tables 的 douyin 表（内置，表已建好）

      // 行距（像素）—— **实测**（2026-11-01，两段共 17 帧）：
      //   相邻「评论行中心」差的中位 53.5（58 个样本；52/54 最多，均值 52.9）
      "row_pitch": 53.5,

      // 首行中心距面板顶（裁剪内坐标）—— **实测**：行中心 − y1=1000 的众数落在 10
      //   （逐帧估相位；这个值只在某帧行数不足估不出时兜底）
      "y_phase": 10,

      // 正文列左沿 = 徽章列右沿（**裁剪内坐标**）—— **实测**三簇（rect x1=0 时）：
      //   药丸 44~96（数字；药丸图形左沿 ~38）· 真昵称 100~176 · 正文 182~193。
      //   ⚠ rect 左沿改成 **x1=15** 后，裁剪内坐标整体减 15 ⇒ 取 **81**（原 96）：
      //     真昵称 85~89 落在 x_text 右边 ⇒ `_has_own_badge` 成立；
      //     药丸块 23~81 落在左边 ⇒ 没有冒号的纯药丸碎片才能被当徽章丢掉。
      //   ⚠ 以后改 rect 的 x1，这里要同步加减同样的量（x_text 是裁剪内坐标）。
      "x_text": 81,

      // ROI 左沿（标注图/交付裁图圈的那一圈）—— 徽章列宽：从 x_text 往左量多少。
      //   取 **74**（与风云T7同值）：81−74 = 7（裁剪内）= 原图 22，在药丸墨迹左沿 ~38
      //   以左，整颗药丸进框。
      "badge_span": 74,

      // 裁切右沿：**按内容**。评论侧文字右沿实测最大 **583**（两段）、气泡再宽几 px；
      //   rect x2=620 留余量。右侧图标在输入框那一行（y≥1430），不在评论区内。
      "x2_from": "content",

      // 行首**药丸数字被并进正文** ⇒ 同一人被读成好几个账号，按几何见证归一（同风云T7口径）。
      //   本素材实测：并进药丸的读法 x1 ∈ [47,60]（`11莲***：`）、干净读法 x1 ∈ [100,104]
      //   ⇒ 两簇相距 ≥40px；MIN_GAP=20 夹在中间，也能排除「OCR 丢一个行首字」。
      //   判据：等级标（`◆N`）一致才算同一个人（详见 CONFIG.md 同名小节）。
      "badge_alias": true,
      // 昵称末尾被检测框切掉 1~2px / 整个末字漏读 ⇒ 同一人被拆成两个账号，
      // 按「同一条评论的两种读法同现」归一（normalize_username_alias，见 CONFIG.md）。
      "username_alias": true,

      // 等级药丸与昵称被 OCR 并成一块（`12小***`）时，昵称只剩在 badge_text 里、正文
      //   没有冒号 ⇒ 用户名空。形状**明确**（1~2 位等级 + 无数字昵称 + 星号）时把昵称
      //   拼回用户名（见 parsing/layout/paragraphs.py 的 _RECOVER_BADGE_NAME_RE）；
      //   `121***` 这种等级/昵称首字都是数字的歧义形状不猜，宁可留空。
      "badge_name_recover": true,

      // 交付这一层认人：**按 (昵称, 等级标 ◆N)** —— 昵称在屏幕上打码成 `X***`，
      //   一个显示名下是几十个不同的人；只按昵称聚合会把别人的评论记错人。
      "account_key": "nickname_level",

      // 直播间浮层的左界（裁剪内 x）—— **实测写死**（2026-11-01，17 帧）：
      //   评论侧文字块 x1 最大 ~193（长评论的块起点仍 <200）；
      //   商品讲解卡的文字块最小 x1 = **477**（`16人已预约` 477 / `讲解中` 488 /
      //   `新款上市` 533 / `奇瑞风云` 574）⇒ 空带 [200, 477) 取 **460**。
      //   ⚠ 不能交给自标定：卡只在一部分时间出现，采样帧里没有卡就标不出界；
      //     手写值不受这个影响（见 calibrate_panels 的「写了就不覆盖」）。
      "x_ignore_from": 460,

      // 评论列表上的浮层卡（不是评论、又没有冒号）。本素材的商品卡已由 x_ignore_from 消掉；
      // 这里留内置的 UI 短语 + 顶部通知的第二道闸。取值给字符串 = 内置短语表 + 这段正则；
      // 给 true 只有内置表。判据只作用于**没有冒号的行**，真评论不会被误伤。
      "overlay_cards": "非主驾开播|吸烟酗酒|低俗色情|人身财产损失|严禁未成年人|诱导打赏",

      // 冒号像素检测的阈值（见 parsing/ocr/colon.py 的 colon_box_by_pixels）——
      //   本素材的评论气泡是**浅灰**（直播画面亮、气泡半透明，实测背景 V≈146~189）。
      //   默认值是给暗底白字量的：「背景亮过 110 就放弃像素法」+「要比背景亮 60」，
      //   在这里整类失效 ⇒ 用户名只能靠 OCR 读出冒号。60s 试跑实测 34/58 条丢失。
      //   放开后像素法能工作：冒号是两个 2px 彩色小点（上点 V≈205、下点 ≈165、背景 146），
      //   亮 30 就能成对；v_min 保持默认 100。
      "colon_bg_max_v": 255,
      "colon_v_delta": 30,

      // OCR 把冒号整个吃掉时（本素材约 1/4 的行），文本里没有「：」⇒ username/content
      //   切不开，用户名只能算丢。像素已经找到冒号位置，就按字宽把它**补回文本**
      //   （见 parsing/ocr/colon.py 的 insert_colon_by_pixels）。opt-in：不写这个键的
      //   平台与旧行为逐字节相同 —— 风云T7 同类行只有 0~6%，本素材是 24%。
      "colon_text_fix": true
    }
  },

  // 表情表用内置的 `douyin`（out/douyin_emoji/douyin-emoji.json）
  // ⇒ 这里一个字段都不用写：emoji.tables 的默认值就是它，emoji.enabled 默认 true。

  "input": {
    // 两段素材：通配符展开后按**文件名排序** = 时间顺序
    //   `8：35-9：34.mp4` < `9：49-10：13.mp4` ⇒ seg1、seg2
    "videos": "/run/media/puyu/A1B7-2982/A1_正式录屏及产出/10-2026-08-07风云A9L年型车上市直播维护/抖音/*.mp4",
    "segment_names": null,              // 段名（= 子目录名）；null ⇒ seg1、seg2…
    "video": null,                      // 单段写法（与 videos 互斥，本件用不到）              --video
    "rows": null,                       // 单段复算用；多段不用写这个（<段目录>/rows.jsonl 在就自动复算）
    "text": null,                       // 纯文本行文件；"-" 读 stdin                            --text
    "start": 0.0,                       // 起始时间（秒）                                      --start
    "duration": null,                   // 处理多长（秒）；null = 整段                          --duration
    "interval": 2.0,                    // 固定间隔抽样用（本配置用 adaptive，此项不生效）        --interval
    "max_frames": null,                 // 最多抽几帧；null = 不限                              --max-frames
    "resume": true,                     // 断点续跑：rows.jsonl 已在就接着它跑（已处理帧跳过）   --resume

    // 抽帧策略：手机 App 是平滑滚动（相位逐帧变），固定间隔会在两次拍摄之间漏条
    // ⇒ 长录屏用 adaptive。下面这组沿用风云T7当前调过的值（max_gap_s 25）。
    "sample": {
      "mode": "adaptive",               //   interval / backoff / adaptive                     --sample-mode
      "stride": 2,                      //   每 N 个解码帧估一次位移（1 = 每帧都估）
      "safety_rows": 5.0,               //   累计位移 ≥ 这么多行 ⇒ 强制拍（上限 5，防重复评论）
      "settle_frames": 3,               //   动过之后静止这么多帧 ⇒ 拍一次（抓住稳定的一屏）
      "eps_px": 1.0,                    //   位移小于它算「没动」
      "entry_thr": 8.0,                 //   底部入口行变化多少像素算「新评论弹进来」
      "max_gap_s": 25.0,                //   最长多久必须拍一次（0 = 不限）
      "min_interval": 0.2,              //   两次拍摄的最小间隔（秒）
      "max_interval": 6.0,              //   两次拍摄的最大间隔（秒）
      "min_score": 0.3                  //   位移估计的匹配分下限
    }
  },

  // -------------------------------------------------------------------------
  // 面板：**手写**（两段的评论区位置已量好，不需要再跑模型定位）。
  // rect 是**原图像素**的评论区窗口：[x1, y1, x2, y2]
  //   · y1=1000：评论列表顶；其上是直播画面（有时是多机位小窗），切在它之下。
  //   · y2=1420：输入框上沿 ≈1430（`说点什么…` 占位文字 1443~1476），切在框之上。
  //   · x1=0 / x2=620：列表满宽；评论文字右沿实测最大 583，620 留余量。
  //   · 两段同一台设备、同一版 App（720×1600）⇒ 共用一套 rect（17 帧两段复核）。
  //   · 改了 rect 直接重跑即可：manual 下配置是唯一来源（与面板文件不一致时按配置重写）。
  // -------------------------------------------------------------------------
  "panels": {
    "mode": "manual",                   // manual=手写面板直接写进 file（交付走 manual）
    "file": null,                       // null ⇒ 每段各一个 <段目录>/panels.json（多段）
    "files": null,                      // 也可显式一份一段地列出面板文件路径（顺序 = 段顺序）
    "overwrite": false,                 // manual：配置与面板文件不一致就按配置重写（true=无条件重写）；
                                        //   locate：已存在就不动（保住人工标注）
    "auto": {                           // 自动定位参数（mode=locate/auto/batch 时用；本配置用不到）
      "method": "hybrid",
      "at": 1000,
      "frames": 5,
      "span": null,
      "split_x": null,                  //   ⚠ null = **不切分**（整帧一个窗口）。竖屏单直播间是
                                        //   一列评论，按半宽切会把它劈成两半。
      "pad_x": 60,
      "pad_top": null,
      "pad_y": 16,
      "sub_width": 500,                 //   ⚠ 竖屏整帧裁切必须降下来，否则 4bit 模型 CUDA OOM
      "model": "nvidia/LocateAnything-3B",
      "quant": "4bit",
      "device": "cuda",
      "platforms": {                    //   只在 mode=auto/builtin/batch 时用
        "left": "douyin_app",           //   不切分后唯一的窗口叫 left
        "right": null
      },
      "frame_width": null
    },
    // mode=manual：手写面板，**一段一项**（顺序与 input.videos 展开的段顺序一致）。
    // **配置是唯一来源**：段目录里的 panels.json 只是它的落盘副本。
    "manual": [
      {                                //   seg1  `8：35-9：34.mp4`  720×1600
        "comments": {"rect": [15, 1100, 700, 1420], "platform": "douyin_app"}
      },
      {                                //   seg2  `9：49-10：13.mp4` 720×1600
        "comments": {"rect": [15, 1100, 700, 1420], "platform": "douyin_app"}
      }
    ],
    "batch": {                          // mode=batch：稳定性研究（挑固定矩形用；不动 file）
      "count": 30,
      "start": 0.0,
      "span": 600.0,
      "anchor": "panel"
    }
  },

  "parse": {
    "sep": " ",                         // 续行拼接用的分隔符                                      --sep
    "max_username_len": 24,             // 冒号前超过这个长度就不当用户名                          --max-username-len
    "merge_continuation": true,         // 是否把「无用户名的行」并进上一条评论；false ⇒ 不并    取反 --no-merge
    "adjacency": true,                  // 「续行必须相邻」守卫；false ⇒ 回到纯文本判续行        取反 --no-adjacency
    "dedup": true,                      // 按滚动对齐跨帧去重出唯一评论表；false ⇒ 每帧各一条    取反 --no-dedup
    "badge_reread": true,               // 等级标二次读数（面板整屏读不出的药丸按行裁带补读）    --badge-reread
    "calibrate": true,                  // 面板几何自标定（行距/浮层右界/续行；相位逐帧估）     取反 --no-calibrate
    "right_pad": 0,                     // ROI 右边界距面板右边的余量；0 = 贴面板边圈住框外表情   --right-pad
    "emoji_workers": 8                  // 表情扫描线程数；只影响速度、不改变结果
  },

  "output": {
    // 多段时这里是**段的父目录**：实际各写 <dir>/seg1、<dir>/seg2；
    // 跨段的两个产物落在这儿：merged_users.json（qualify）；collect 的交付树见 collect.out。
    // 按平台分目录：同素材另有「视频号/」，将来配视频号时各用各的 output.dir，段目录不会撞。
    "dir": "out/10-2026-08-07风云A9L年型车上市直播维护/抖音",   // 输出根目录                    --out
    "write": true,                      // 是否写盘（comments.jsonl + summary.json 成对）
    "rows": true,                       // 另存 rows.jsonl（**可回喂复算**）             --dump-rows <段目录>/rows.jsonl
    "panels": true,                     // mode=auto 时把定位结果存成 panels.json         --dump-panels <段目录>/panels.json
    // frames：**抽样帧**一张图 frames/<t>_roi.jpg（≈0.55MB/张），不是每条评论一张。
    // 两段整段跑估计 ≈1200 帧 ≈ 0.7GB ⇒ 默认开；嫌占地方就关（取反 --no-frames）。
    "frames": true,                     // 取反 --no-frames
    "print": false                      // 除写盘外也把评论打到 stdout                            --print
  },

  // 评论 → 合格用户：用户名 ≥min_positive 条**正面**评论（正面由大模型判定，表情也发），
  // 并排除用户名命中关键词的官方侧账号。**要花钱**，所以默认关；
  // key **只走环境变量**（本项目铁律：不写进任何配置文件）：
  //   NLP_API_KEY=sk-… $P -m livepipe run 风云A9L.json --only filter
  //
  // ⚠ 本件是**两段素材**，交付要求「该账号 ≥2 条正面」是**按两段合计**判的 ⇒
  //   这里 `min_positive: 1`（只出全量用户表），合格与否交给 `qualify` 步按合计判。
  "filter": {
    "enabled": true,                    // 打开才会调模型；只想抽评论就先 --skip filter
    "source": null,                     // 评论来源；null ⇒ <段目录>/comments.jsonl
    "out": null,                        // 合格用户 JSONL；null ⇒ <段目录>/users.jsonl
    "cache": null,                      // 判定缓存；null ⇒ 多段共用 <output.dir>/judgments.jsonl
    "min_positive": 1,                  // 单段阈值（**合计口径见上面 ⚠**；qualify 一开就自动取 stage_min）
    "exclude_keywords": [               // 用户名含任一即排除（不区分大小写）
      // ⚠ 这份表沿用**奇瑞那条线**的（品牌 + 4S + 车型 + 高管姓名）—— 风云是奇瑞旗下品牌，
      //   主播/官方号名字里带「奇瑞」，所以这份表对它有效；要不要按本场补官方侧账号
      //   （`风云新能源` 这种主播自己号 / 经销商号），**等名单出来再逐条加**：
      //   填错的代价是**把真观众挡在名单外**，所以宁可先不填。
      "奇瑞", "4s", "店", "qq3", "汽车",
      "尹同跃", "张国忠", "鲍思语", "王津华", "王孝伟", "胡敬源", "尹祥领",
      "王来春", "李晶", "商文江", "杨棉之", "叶盛基", "路风", "黎汝雄",
      "李学用", "张贵兵", "代立宏", "章红玉", "高新华", "戚士龙", "王琅"
    ],
    "nlp": {
      "api_key": null,                  // **留 null**：key 只走环境变量（本项目铁律）
      "api_key_env": "NLP_API_KEY",     // ← 环境变量的**名字**（把 key 写到这行永远取不到）
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "deepseek-v4.1-flash",   // ⚠ 模型名会随平台改，写错就是 404（不是 key 的问题）
      "batch_size": 20,                 // 一次调用判几条：越大越省，越大越怕一条坏整批
      "concurrency": 4,
      "timeout": 60.0,
      "retries": 3,
      "limit": null,                    // 最多调多少批（控成本）
      "prompt": null                    // null ⇒ 用 user_filter.DEFAULT_PROMPT
    }
  },

  // -------------------------------------------------------------------------
  // 跨段的两步（顺序有依赖：filter（逐段）→ qualify（跨段判合格）→ export（逐段）→ collect（拼树））
  // -------------------------------------------------------------------------

  // 跨段判合格（**全局步**，整批只跑一次）：把两段的 users.jsonl 按**账号合计**算正面条数，
  // ≥min_positive 的才算合格，再把合格用户**回写**成每段的 users_qualified.jsonl 交给 export。
  "qualify": {
    "enabled": true,                    // 单段素材开着也无害（退化成「按本段判」）
    "min_positive": 2,                  // 交付阈值（**跨段合计**）—— 沿用 2026-10-14 拍板的「降到 2」
                                        // （参考语料是 3；读数修准后拆出来的档变多，3 会把「真人只说了
                                        //  两次」的一律判掉。交付树目录名跟着是 `all_users_正面_2张以上`）
    "stage_min": 1                      // 各段 filter/export 用的阈值（先出全量，合格留给这一步判）
  },

  // 逐段出交付图（**逐段步**）：读该段 users_qualified.jsonl，按**原帧**画绿框，一人一个目录
  // `<昵称>-<本段条数>`（跨段同名目录由 collect 并成一个）。
  "export": {
    "enabled": true,
    "base": "frame",                    // frame=原帧（参考语料形态）/ annotated=标注图      --base
    "labels": "正面",                   // 只出正面评论                                        --labels
    "min_positive": null,               // null ⇒ qualify.stage_min（合格已在 qualify 判完）
    "min_scope": "platform",            // 平台内各自够数；两段同一平台 ⇒ 等同于按合计         --min-scope
    "users": null,                      // null ⇒ <段目录>/users_qualified.jsonl
    "color": "0,255,0", "width": 3,     // 绿框（对齐参考语料）
    "pad": 0, "pad_ratio": 0.25, "quality": 90,
    "force": true                       // 重跑覆盖上一轮的导出目录
  },

  // 拼最终交付树（**全局步**）：把两段的导出目录按账号身份并成一个目录、图号 1..N **跨段连续**，
  // 后缀取**合计**条数，顺带写 正面账号.txt + manifest.json。
  // out 显式写死：output.dir 已经带 `/抖音`，再让 collect 自动拼 `<平台目录>` 会变成 …/抖音/抖音/…。
  "collect": {
    "enabled": true,
    "stage_min": null,                  // 各段导出目录名里的数字；null ⇒ qualify.stage_min
    "platform_dir": null,               // 交付树里的平台目录名；null ⇒ 自动认（douyin_app → 抖音）
    "out": "out/10-2026-08-07风云A9L年型车上市直播维护/抖音/all_users_正面_2张以上",
    "force": true                       // 目标非空时整棵重来（否则报错退出）
  },

  "draw": {                             // 独立描框步骤（draw_boxes.py）；核心解析已自带逐帧标注图
    "enabled": true,
    "source": null,
    "at": 8.0,
    "window": 5.0,
    "out": null,
    "width": 5,
    "quality": 90,
    "labels": true
  },

  "steps": {
    // 顺序**不能乱**：filter（逐段）→ qualify（跨段判合格）→ export（逐段）→ collect（拼树）。
    // 逐段步（panels/parse/filter/export/draw）两段各跑一遍；全局步（emoji_tables/qualify/collect）整批一次。
    "order": ["emoji_tables", "panels", "parse", "filter", "qualify",
              "export", "collect", "draw"],
    "skip": ["emoji_tables", "draw"]    // 表情表已建好（out/douyin_emoji/）；独立描框用不上
  }
}

// ---------------------------------------------------------------------------
// panels.mode 取值：
//   locate   ① 定位评论区 → 写出面板文件（platform 留空），交给人工标注。**工作流第一步**
//   reuse    ② 复用面板文件（人工标注过 platform）→ 按平台处理
//   manual   手写面板（rect + platform）直接写进 file。**本配置**（rect 已量好）
//   auto     解析时自己定位，平台按 auto.platforms 归属（无人值守快捷路径，需 GPU）
//   batch    跑批量定位 + 稳定性统计（挑固定矩形用；不动 file）
//   builtin  用脚本内置的 DEFAULT_PANELS（只对特定录屏有效）
//
// 本件与其它配置的关系：
//   · 风云T7.json —— 同为抖音**手机 App** 竖屏（720×1600），档案口径同族：
//     行距 53.5 / 相位 10 / x_text 96 / badge_span 74 一致；差异只在本素材的 rect
//     （y1 1000 · y2 1420 · x2 620）与浮层左界 460（风云T7 是 400、卡片位置不同）。
//   · csj.json —— 抖音/视频号的**桌面网页版**（row_pitch 68 / x_text 70，双窗口），不是一套数字。
//
// 换素材要重新量的量：
//   ① 行距/相位：抽一帧看连续几行中心间隔；② x_text：带冒号的行左沿直方图，找
//   「真昵称簇」与「药丸并进正文簇」之间；③ rect：评论列表顶/输入框上沿/内容右沿各抓一帧；
//   ④ 浮层左界：评论侧块最大 x1 与卡片侧块最小 x1 之间的空带。
// ---------------------------------------------------------------------------
