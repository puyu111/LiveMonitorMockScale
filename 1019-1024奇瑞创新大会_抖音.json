// ============================================================================
// 奇瑞「2026 全球创新大会（CGIC 2026 · 芜湖）」2026-10-19~24 · 抖音直播
// （手机 App 竖屏 590×1280）→ 结构化评论
//
// 素材 = 「/run/media/puyu/MyDisk/2026-1019-1024奇瑞创新大会/抖音-奇瑞汽车/」
//   下的**四段**录屏（同一场直播、账号「奇瑞汽车」；文件夹只有抖音这一个平台）：
//     seg1  `7：58-9：33.mp4`   96.7min
//     seg2  `9：35-10：50.mp4`  75.9min
//     seg3  `10：51-12：08.mp4` 77.8min
//     seg4  `12：09-13：15.mp4` 66.9min
//   四段合计约 317.3min（5.3h），时间上首尾相接（段间只差 1~2 分钟换文件）。
//   四段一次配全（input.videos 显式数组 = 时间顺序）。每段在 output.dir 下开一个
//   子目录（seg1..seg4），逐段步各跑一遍、跨段步（qualify/collect）整批跑一次。
//   ⚠ 末段最后一帧仍是直播态（底部输入栏 `说点什么...` 在）⇒ 不需要裁「直播已结束」页。
//   ⚠ 文件夹名带的是**大会日期区间**（10-19~10-24），录屏本身只是一天上午的一场
//     （7:58~13:15），配置文件名沿用区间，避免误以为是某一天的单独一场。
//
// 行版式：`[◆N 粉丝团药丸] 昵称：正文`（与 09-14 艾瑞泽8CTCC / 10-31 抖音同族，
//   同为 590×1280 手机 App；数字仍按本批素材复核）。
//   · 昵称**不打码**（`活在当下2046` / `武欢欢` / `u菲u~（菜鸟王者发疯版~）`）⇒ account_key=username。
//   · 直播间右侧长期压着**商品讲解卡**（`讲解中` / `CHANGE改变` / `2026奇瑞全球创新大会` /
//     `瑞虎9 2.0T` / `19人已预约` / `立即预约`，x1≥390）⇒ x_ignore_from=380 整块丢弃。
//
// 这块素材量到的（2026-11-11，每文件 3~8 帧，590×1280）：
//   ✅ 行距 **43.8**（相邻评论首行中心差 41~45、10 行跨度实测 437.5~438px ⇒ 43.75~43.8；
//      与同分辨率的 09-14 一致）
//   ✅ 评论列表顶（渐隐带底）实测：视频画面到 ≈591，其上 y≈522 的
//      `!CHANGE! 2026奇瑞全球创新大会` 是**视频里的下三分之一横幅**（不是置顶评论）；
//      列表顶部有一条 ~70px 的渐隐带（半透明行，OCR 能读出零碎字）到 ≈672 才全亮
//      ⇒ rect y1=**672**（用户口径：顶部有虚化就把框再放低）
//   ✅ 输入栏 `说点什么...` 实测 1220~1251 ⇒ rect y2=1196
//   ✅ x_text **86**：◆N 药丸块 x∈[28,92] · 真昵称 x1≈79~110 · 无药丸昵称 x1≈31~35 ·
//      折行续行 x1≈26~35（< 86−58+8=36 ⇒ 走「贴左沿=整行正文」那一支，不需要 wrap_indent）
//   ✅ badge_span **74**（ROI 左沿 = 86−74 = 12，圈住 x≈20 起的整颗药丸）
//   ✅ rect [0,672,590,1196]：x1=0 / x2=590 满宽；右侧商品卡由 x_ignore_from 丢
//   ✅ 表情用抖音那套表（/run/media/puyu/C0DE6A4BDE6A39B4/out/douyin_emoji/douyin-emoji.json，已建好）
//   ⚠ 折行续行间距 ~27.5~32px（0.63~0.73 行距），独立行 ~41~43px（0.94~0.98）
//      ⇒ wrap_gap_ratio 0.85（与 09-14 同口径，0.85 夹在两簇中间）
//
// 跑法（OCR 要带 rapidocr 的解释器）：
//   P=/home/puyu/anaconda3/envs/vlx/bin/python
//   ① 抽行（慢；四段合计约 5.3h 录屏）：
//        export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
//        $P -m livepipe run 1019-1024奇瑞创新大会_抖音.json --only panels,parse
//        ⚠ 中断了直接重跑同一条命令：<段目录>/rows.jsonl 已在 ⇒ 自动零 OCR 复算/续跑。
//   ② 筛 + 判合格 + 出图 + 拼交付树（**要 key**，只走环境变量）：
//        NLP_API_KEY=sk-xxxx $P -m livepipe run 1019-1024奇瑞创新大会_抖音.json \
//            --only filter,qualify,export,collect
//   ③ 先看后交：产物在
//        /run/media/puyu/C0DE6A4BDE6A39B4/out/2026-1019-1024奇瑞创新大会/抖音/all_users_正面_3张以上/
//
// 校验（不跑、安全）：
//   python3 -m livepipe check 1019-1024奇瑞创新大会_抖音.json
//   python3 -m livepipe run   1019-1024奇瑞创新大会_抖音.json --dry-run
// ============================================================================
{
  "base_dir": "/run/media/puyu/C0DE6A4BDE6A39B4",
  "version": 1,
  "name": "奇瑞2026全球创新大会（CGIC 2026·芜湖）2026-10-19~24 · 抖音手机 App · 竖屏",

  // -------------------------------------------------------------------------
  // 平台档案：面板文件里只填平台名，行距 / 表情表 / 裁切策略 / 药丸闸都从这里取。
  // 与 09-14 艾瑞泽8CTCC / 10-31 抖音同一版式（590×1280）；本件的数字按本批素材复核。
  // -------------------------------------------------------------------------
  "platforms": {
    "douyin_app": {
      "label": "抖音直播（手机 App 竖屏 590×1280；行首 ◆N 粉丝团药丸在昵称左边）",
      "emoji": "douyin",                // → emoji.tables 的 douyin 表（内置，表已建好）

      // 交付认人口径：本批昵称不打码 ⇒ 只看昵称。见 CONFIG.md 的 `account_key` 小节。
      "account_key": "username",

      // 行距（像素）—— **实测**（2026-11-11，四文件共 20 帧）：相邻评论首行中心差
      //   41~45，10 个相邻间距的跨度实测 437.5~438px（⇒ 43.75~43.8）。取 **43.8**。
      "row_pitch": 43.8,

      // 首行中心距面板顶（裁剪内坐标）—— 本批实测首行中心 ≈682~713
      //   （rect y1=672 ⇒ 相位 ~10~41）；相位逐帧估，这个值只在估不出时兜底。
      "y_phase": 22,

      // 正文列左沿 = 徽章列右沿（**裁剪内坐标**；rect x1=0 ⇒ 原图坐标）—— **实测**：
      //   ◆N 药丸块 x∈[28,92] · 真昵称 x1≈79~110 · 无药丸昵称 x1≈31~35 ·
      //   折行续行 x1≈26~35。
      //   取 **86**：① 药丸碎片整块落在左边被丢；② 「贴左沿」门槛 86−58+8 = 36
      //   落在续行 26~35 之上 ⇒ 续行走整行正文那一支，**不依赖** wrap_indent 自标定。
      "x_text": 86,

      // ROI 左沿（标注图/交付裁图圈的那一圈）—— 徽章列宽：药丸墨迹左沿 ≈20，
      //   86−74 = 12 ⇒ 整颗药丸都进框，左边还留余量。
      "badge_span": 74,

      // 裁切右沿：**按内容**。评论正文最长读到 475，rect x2=590 是满宽。
      "x2_from": "content",

      // 行首**药丸数字被并进正文**（`13316:奇瑞` / `2清风雅逸：` / `26晚安：`）
      //   ⇒ 同一人被读成好几个账号，按几何见证归一。
      "badge_alias": true,

      // 昵称**末尾**被检测框切掉 1~2px（或整个末字漏读）⇒ 同一人被拆成两个账号，
      //   按「同一条评论的两种读法同现」归一（normalize_username_alias）。
      "username_alias": true,

      // 等级药丸与昵称被 OCR 并成一块时，把昵称拼回用户名。
      "badge_name_recover": true,

      // 折行续行间距比上限 —— 实测续行 ~27.5~32px = **0.63~0.73 行距**；
      //   独立评论/通知行实测 ~41~43px = 0.94~0.98。取 0.85 夹在两簇中间。
      "wrap_gap_ratio": 0.85,

      // 右侧商品讲解卡的左界（裁剪内 x）—— **实测**：卡块 x1≥390
      //   （`讲解中` 405 / `CHANGE改变` 402 / `2026奇瑞全球创新大会` 402 /
      //   `瑞虎9 2.0T` 390 / `19人已预约` 391 / `立即预约` 436）⇒ 取 **380**
      //   整块丢弃；评论正文 x1≤277。
      "x_ignore_from": 380,

      // 评论列表上的浮层卡 / 提示卡（只作用于**没有冒号**的行）：
      //   · 开场平台提示卡（被折行切成 8 块，短语取「每块里都还在」的词）：
      //     `欢迎来到直播间！抖音严禁未成年人` / `直播或礼物消费。严禁出现违法违` /
      //     `规、低俗色情、吸烟酗酒、人身伤害` / `等直播内容。理性消费…` /
      //     `播中以不当方式诱导打赏…` / `别。切勿私下交易…` / `失，谨防网络诈骗…` /
      //     `明示信息为准。`；
      //   · 三方管理工具卡：`本直播间已接入三方管理工具，以便` + `主播及其工作人员高效回应你的评`
      //     + `论。`（后两块靠折行续行拼回一句，所以短语要能命中**拼好的整句**）；
      //   · 主题卡：`当科技切实改变生活，创新` + `的价值才能真正体现。`；
      //   · 商品讲解卡（多数已由 x_ignore_from 丢，这里按短语兜底）；
      //   · 系统通知的折行碎片（`分享了直播` / `推荐了直播` 不在内置表里，本批补上；
      //     `…关注了主播奇瑞汽车` 被切成两行时，后半截整行就是 `奇瑞汽车` ⇒ 锚行首尾丢）。
      "overlay_cards": "本直播间已接入|三方管理工具|欢迎来到直播间|直播或礼物消费|严禁出现违法违|低俗色情|吸烟酗酒|人身伤害|理性消费|诱导打赏|私下交易|人身财产损|网络诈骗|明示信息为准|实际下载应用|工作人员高效回应|在不当方式|当科技切实改变生活|价值才能真正体现|讲解中|立即预约|人已预约|关注了主|赞了直播|加入了直播|分享了直播|推荐了直播|为主播点赞|^奇瑞汽车$|^CHERY$|^讲解虫$",

      // 冒号像素检测阈值（见 parsing/ocr/colon.py）：抖音气泡半透明、底偏亮，
      //   默认 bg_max_v=110 会整类短路 ⇒ 放开背景亮度、把亮度差降到 30。
      "colon_bg_max_v": 255,
      "colon_v_delta": 30,

      // OCR 把冒号吃掉时，按像素位置补回文本。
      "colon_text_fix": true,

      // 长表情评论折成多行：第二行没有 OCR 文字、落在两条已检出行之间
      //   ⇒ 抽行时在空档里补扫（emoji_gap_sweep），parse 时把纯表情续行并进上一条
      //   （merge_emoji_continuation）。两个都开才完整。
      "merge_emoji_continuation": true,
      "emoji_gap_sweep": true
    }
  },

  // 表情表用内置的 `douyin`（/run/media/puyu/C0DE6A4BDE6A39B4/out/douyin_emoji/douyin-emoji.json）。
  // ⚠ 远程只传表 JSON、不传 img/ ⇒ 打开 build.enabled，run.sh 预建表步骤在远程
  //   调官方表情接口重建（214 张）。本机 steps.skip 含 emoji_tables，不会重复建。
  //   不想刷新用 `LIVEPIPE_SKIP_EMOJI=1 ./run.sh …`。
  "emoji": {
    "tables": {
      "douyin": {
        "build": {"enabled": true}
      }
    }
  },

  "input": {
    // 四段素材：**显式数组**（段顺序 = 时间顺序）。
    "videos": [
      "/run/media/puyu/MyDisk/2026-1019-1024奇瑞创新大会/抖音-奇瑞汽车/7：58-9：33.mp4",
      "/run/media/puyu/MyDisk/2026-1019-1024奇瑞创新大会/抖音-奇瑞汽车/9：35-10：50.mp4",
      "/run/media/puyu/MyDisk/2026-1019-1024奇瑞创新大会/抖音-奇瑞汽车/10：51-12：08.mp4",
      "/run/media/puyu/MyDisk/2026-1019-1024奇瑞创新大会/抖音-奇瑞汽车/12：09-13：15.mp4"
    ],
    "segment_names": null,              // 段名（= 子目录名）；null ⇒ seg1..seg4
    "video": null,                      // 单段写法（与 videos 互斥，本件用不到）              --video
    "rows": null,                       // 单段复算用；多段不用写（<段目录>/rows.jsonl 在就自动复算）
    "text": null,                       // 纯文本行文件；"-" 读 stdin                            --text
    "start": 0.0,                       // 起始时间（秒）                                      --start
    "duration": null,                   // 处理多长（秒）；null = 整段                          --duration
    "interval": 2.0,                    // 固定间隔抽样用（本件用 adaptive，此项不生效）          --interval
    "max_frames": null,                 // 最多抽几帧；null = 不限                              --max-frames
    "resume": true,                     // 断点续跑：rows.jsonl 已在就接着它跑（已处理帧跳过）   --resume

    // 抽帧策略：手机 App 是平滑滚动 ⇒ 长录屏用 adaptive（静止段几乎不拍、滚动段不漏条）。
    "sample": {
      "mode": "adaptive",               //   interval / backoff / adaptive                     --sample-mode
      "stride": 2,                      //   每 N 个解码帧估一次位移（1 = 每帧都估）
      "safety_rows": 5.0,               //   累计位移 ≥ 这么多行 ⇒ 强制拍（上限 5）
      "settle_frames": 3,               //   动过之后静止这么多帧 ⇒ 拍一次
      "eps_px": 1.0,                    //   位移小于它算「没动」
      "entry_thr": 8.0,                 //   底部入口行变化多少像素算「新评论弹进来」
      "max_gap_s": 5.0,                 //   最长多久必须拍一次（0 = 不限）
      "min_interval": 0.2,              //   两次拍摄的最小间隔（秒）
      "max_interval": 6.0,              //   两次拍摄的最大间隔（秒）
      "min_score": 0.3                  //   位移估计的匹配分下限
    }
  },

  // -------------------------------------------------------------------------
  // 面板：**手写**（评论列表位置已量好，不需要再跑模型定位）。
  // rect 是**原图像素**的评论区窗口：[x1, y1, x2, y2]
  //   · y1=672：视频画面到 ≈591，列表顶部渐隐带（半透明行）到 ≈672 才全亮 ——
  //     框取在渐隐带之下，避开被糊掉、OCR 读成碎片的顶部半行（用户明确要求「框要低一点」）；
  //   · y2=1196：输入栏 `说点什么...` 上沿实测 1220，切在它之上；
  //   · x1=0 / x2=590：列表满宽；右侧商品卡由 x_ignore_from 丢。
  //   · 四段同一台设备、同一版 App（590×1280）⇒ 共用一套 rect。
  // -------------------------------------------------------------------------
  "panels": {
    "mode": "manual",                   // manual=手写面板直接写进 file（交付走 manual）
    "file": null,                       // null ⇒ 每段各一个 <段目录>/panels.json（多段）
    "files": null,                      // 也可显式一份一段地列出面板文件路径（顺序 = 段顺序）
    "overwrite": false,                 // manual：配置与面板文件不一致就按配置重写
    "auto": {                           // 自动定位参数（mode=locate/auto/batch 时用；本件用不到）
      "method": "hybrid",
      "at": 900,
      "frames": 5,
      "span": null,
      "split_x": null,                  //   ⚠ null = **不切分**（竖屏单直播间是一列评论）
      "pad_x": 60,
      "pad_top": 80,
      "pad_y": 16,
      "sub_width": 500,                 //   ⚠ 竖屏整帧裁切必须降下来，否则 4bit 模型 CUDA OOM
      "model": "nvidia/LocateAnything-3B",
      "quant": "4bit",
      "device": "cuda",
      "platforms": {                    //   只在 mode=auto/builtin/batch 时用
        "left": "douyin_app",           //   不切分后唯一的窗口叫 left
        "right": null
      },
      "frame_width": 590
    },
    // mode=manual：手写面板，**一段一项**（顺序与 input.videos 的段顺序一致）。
    "manual": [
      {                                //   seg1  `7：58-9：33.mp4`
        "comments": {"rect": [0, 672, 590, 1196], "platform": "douyin_app"}
      },
      {                                //   seg2  `9：35-10：50.mp4`
        "comments": {"rect": [0, 672, 590, 1196], "platform": "douyin_app"}
      },
      {                                //   seg3  `10：51-12：08.mp4`
        "comments": {"rect": [0, 672, 590, 1196], "platform": "douyin_app"}
      },
      {                                //   seg4  `12：09-13：15.mp4`
        "comments": {"rect": [0, 672, 590, 1196], "platform": "douyin_app"}
      }
    ],
    "batch": {                          // mode=batch：稳定性研究（挑固定矩形用；不动 file）
      "count": 30,
      "start": 0.0,
      "span": 600.0,
      "anchor": "panel"
    }
  },

  "parse": {
    "sep": " ",                         // 续行拼接用的分隔符                                      --sep
    "max_username_len": 24,             // 冒号前超过这个长度就不当用户名                          --max-username-len
    "merge_continuation": true,         // 是否把「无用户名的行」并进上一条评论                   取反 --no-merge
    "adjacency": true,                  // 「续行必须相邻」守卫                                  取反 --no-adjacency
    "dedup": true,                      // 按滚动对齐跨帧去重出唯一评论表                        取反 --no-dedup
    // 关掉自标定：行距/相位/浮层界都已实测写死；自标定只在开头采 4 帧，
    //   开场提示卡会把样本带偏（与 10-31 / 艾瑞泽8 同口径）。
    "calibrate": false,                 // 面板几何自标定（行距/浮层右界/续行；相位逐帧估）      取反 --no-calibrate
    "right_pad": 0,                     // ROI 右边界距面板右边的余量；0 = 贴面板边圈住框外表情    --right-pad
    "emoji_workers": 8                  // 表情扫描线程数；只影响速度、不改变结果
  },

  "output": {
    // 多段时这里是**段的父目录**：实际各写 <dir>/seg1..seg4；
    // 跨段产物落在这儿：merged_users.json（qualify）；交付树见 collect.out。
    "dir": "/run/media/puyu/C0DE6A4BDE6A39B4/out/2026-1019-1024奇瑞创新大会/抖音",
    "write": true,                      // 是否写盘（comments.jsonl + summary.json 成对）
    "rows": true,                       // 另存 rows.jsonl（**可回喂复算**）
    "panels": true,                     // mode=auto 时把定位结果存成 panels.json
    // frames：**抽样帧**一张图 frames/<t>_roi.jpg（≈0.55MB/张），不是每条评论一张。
    "frames": true,                     // 取反 --no-frames
    "print": false                      // 除写盘外也把评论打到 stdout                            --print
  },

  // 评论 → 合格用户：用户名 ≥min_positive 条**正面**评论（正面由大模型判定，表情也发），
  // 并排除用户名命中关键词的官方侧账号。**要花钱**；key **只走环境变量**（本项目铁律）。
  //
  // ⚠ 本件是**四段素材**，交付要求「该账号 ≥3 条正面」是**按四段合计**判的 ⇒
  //   这里 `min_positive: 1`（只出全量用户表），合格与否交给 `qualify` 步按合计判。
  "filter": {
    "enabled": true,                    // 打开才会调模型；只想抽评论就先 --skip filter
    "source": null,                     // 评论来源；null ⇒ <段目录>/comments.jsonl
    "out": null,                        // 合格用户 JSONL；null ⇒ <段目录>/users.jsonl
    "cache": null,                      // 判定缓存；null ⇒ 四段共用 <output.dir>/judgments.jsonl
    "min_positive": 1,                  // 单段阈值（**合计口径见上面 ⚠**；qualify 一开就自动取 stage_min）
    "exclude_keywords": [               // 用户名含任一即排除（不区分大小写）
      // ⚠ 沿用**奇瑞那条线**的表（品牌 + 4S + 车型 + 高管姓名）；本场官方号 / 主播 /
      //   讲解员还没按本场补。填错的代价是把真观众挡在名单外 ⇒ 等名单出来再逐条加。
      "奇瑞", "4s", "店", "qq3", "汽车",
      "尹同跃", "张国忠", "鲍思语", "王津华", "王孝伟", "胡敬源", "尹祥领",
      "王来春", "李晶", "商文江", "杨棉之", "叶盛基", "路风", "黎汝雄",
      "李学用", "张贵兵", "代立宏", "章红玉", "高新华", "戚士龙", "王琅"
    ],
    "nlp": {
      "api_key": null,                  // **留 null**：key 只走环境变量（本项目铁律）
      "api_key_env": "NLP_API_KEY",     // ← 环境变量的**名字**（把 key 写到这行永远取不到）
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "deepseek-v4.1-flash",   // ⚠ 模型名会随平台改，写错就是 404（不是 key 的问题）
      "batch_size": 20,
      "concurrency": 4,
      "timeout": 60.0,
      "retries": 3,
      "limit": null,                    // 最多调多少批（控成本）
      "prompt": null                    // null ⇒ 用 user_filter.DEFAULT_PROMPT
    }
  },

  // -------------------------------------------------------------------------
  // 跨段的两步（顺序有依赖：filter（逐段）→ qualify（跨段）→ export（逐段）→ collect（拼树））
  // -------------------------------------------------------------------------

  // 跨段判合格（**全局步**）：把四段的 users.jsonl 按**账号合计**算正面条数，≥min_positive
  // 的才算合格，再把合格用户**回写**成每段的 users_qualified.jsonl 交给 export。
  "qualify": {
    "enabled": true,                    // 单段素材开着也无害（退化成「按本段判」）
    "min_positive": 3,                  // 交付阈值（**跨段合计**）—— 与 08-09CTCC 参考语料一致
    "stage_min": 1                      // 各段 filter/export 用的阈值（先出全量，合格留给这一步判）
  },

  // 逐段出交付图（**逐段步**）：读该段 users_qualified.jsonl，按**原帧**画绿框，一人一个目录
  // `<昵称>-<本段条数>`（跨段同名目录由 collect 并成一个）。
  "export": {
    "enabled": true,
    "base": "frame",                    // frame=原帧（参考语料形态）/ annotated=标注图      --base
    "labels": "正面",                   // 只出正面评论                                        --labels
    "min_positive": null,               // null ⇒ qualify.stage_min（合格已在 qualify 判完）
    "min_scope": "platform",            // 平台内各自够数；四段同一平台 ⇒ 等同于按合计         --min-scope
    "users": null,                      // null ⇒ <段目录>/users_qualified.jsonl
    "color": "0,255,0", "width": 3,     // 绿框（对齐参考语料）
    "pad": 0, "pad_ratio": 0.25, "quality": 90,
    "force": true                       // 重跑覆盖上一轮的导出目录
  },

  // 拼最终交付树（**全局步**）：把四段的导出目录按账号身份并成一个目录、图号 1..N
  // **跨段连续**，后缀取**合计**条数，顺带写 正面账号.txt + manifest.json。
  // out 显式写死：output.dir 已经带 `/抖音`，再让 collect 自动拼 `<平台目录>` 会变成
  // …/抖音/抖音/…。
  "collect": {
    "enabled": true,
    "stage_min": null,                  // 各段导出目录名里的数字；null ⇒ qualify.stage_min
    "platform_dir": null,               // 交付树里的平台目录名；null ⇒ 从各段导出目录自动认（抖音）
    "out": "/run/media/puyu/C0DE6A4BDE6A39B4/out/2026-1019-1024奇瑞创新大会/抖音/all_users_正面_3张以上",
    "force": true                       // 目标非空时整棵重来（否则报错退出）
  },

  "draw": {                             // 独立描框步骤（draw_boxes.py）；核心解析已自带逐帧标注图，默认关
    "enabled": true,
    "source": null,
    "at": 8.0,
    "window": 5.0,
    "out": null,
    "width": 5,
    "quality": 90,
    "labels": true
  },

  "steps": {
    // 顺序**不能乱**：filter（逐段）→ qualify（跨段判合格）→ export（逐段）→ collect（拼树）。
    // 逐段步（panels/parse/filter/export/draw）四段各跑一遍；全局步（emoji_tables/qualify/collect）整批一次。
    "order": ["emoji_tables", "panels", "parse", "filter", "qualify",
              "export", "collect", "draw"],
    "skip": ["emoji_tables", "draw"]    // 表情表已建好（/run/media/puyu/C0DE6A4BDE6A39B4/out/douyin_emoji/）；独立描框用不上
  }
}
