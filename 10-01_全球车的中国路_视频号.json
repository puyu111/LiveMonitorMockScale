//   实际平台重新归档；裁剪副本在 `_live/`（stream copy，不重编码）。
//
// 量到的几何（2026-11-16，手机 App）：行距见 platforms 段；
//   每段 rect 见 panels.manual（OCR 在直播段内的多帧上量的）。
//
// 跑法（OCR 要带 rapidocr 的解释器）：
//   P=/home/puyu/anaconda3/envs/vlx/bin/python
//   export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
//   $P -m livepipe run 10-01_全球车的中国路_视频号.json --only panels,parse
//   # 中断后重跑同一条命令：<段目录>/rows.jsonl 已在 ⇒ 零 OCR 续跑
//   NLP_API_KEY=sk-xxxx $P -m livepipe run 10-01_全球车的中国路_视频号.json \
//       --only filter,qualify,export,collect
// 产物：/run/media/puyu/C0DE6A4BDE6A39B4/out/2026-0930-1006全球车的中国路/10-01/视频号/
// 校验：python3 -m livepipe check <本文件>
// ============================================================================
{
  "base_dir": "/home/puyu/livepipe_assets",
  "version": 1,
  "name": "全球车的中国路 2026-10-01 · 视频号手机 App · 竖屏",

  // -------------------------------------------------------------------------
  // 平台档案：591/592×1280 手机 App，版式与 09-12 CTCC 视频号同族；数字按本素材复核。
  // -------------------------------------------------------------------------
  "platforms": {
    "wechat_app": {
      "label": "视频号直播（手机 App 竖屏；等级标 ✦N 在昵称左边，行首可能有「粉丝」药丸）",
      "emoji": "wechat",                // → /run/media/puyu/C0DE6A4BDE6A39B4/out/wechat_emoji/wechat-emoji.json

      // 本批评论昵称基本不打码 ⇒ 只看昵称。
      "account_key": "username",

      // 行距 —— **实测**（2026-11-16，多帧）：相邻评论首行中心差众数 41.0。
      "row_pitch": 41.0,
      "y_phase": 10,

      // 正文列左沿 —— **实测**：等级药丸/数字块 x∈[37,63] · 真昵称 x1≈68 ·
      //   药丸并进正文的读法 x1≈26~37。取 66：纯药丸碎片被丢；
      //   带冒号的正文不受影响；续行（x1≈26~30）走「贴左沿」/缩进带。
      "x_text": 66,
      "badge_span": 44,

      // 裁切右沿：取窗口右沿（App 评论列表满宽）。
      "x2_from": "window",

      // 行首「粉丝」药丸被 OCR 并进正文的几何闸（药丸行 x1≈26~27，真昵称 ≥68）。
      "fan_badge_x_max": 66,
      "fan_badge_with_level": true,

      // 等级药丸并进正文 / 昵称末尾被切 1~2px ⇒ 同一人多种读法归一。
      "badge_alias": true,
      "username_alias": true,

      // 折行续行：贴左沿 / 缩进；间距闸上限 0.85 行距（独立行 ≈1.0）。
      "wrap_indent": true,
      "wrap_gap_ratio": 0.85,

      // 右侧浮层左界 —— **实测**：评论正文块 x1 都 ≤100；
      //   「若主播7天内再次开播 / 提醒一次」订阅卡文字块 x1≈450 ⇒ 空带取 440。
      "x_ignore_from": 440,

      // 浮层卡：主题卡 / 公众号卡 / 订阅提醒卡 / 本场活动文案（只作用于没有冒号的行）。
      "overlay_cards": "全球车的中国路|奇瑞风云QQ国庆接力巡礼大美山河|奇瑞汽车>|公众号奇瑞汽车>|若主播7天|再次开播|提醒一次",
      // 整行等于这些词就丢掉（主题卡 / 公众号卡）。
      "skip_phrases": [
        "奇瑞汽车>",
        "公众号奇瑞汽车>",
        "全球车的中国路",
        "奇瑞风云QQ国庆接力巡礼大美山河"
      ],

      // 冒号像素检测：视频号气泡半透明、底偏亮；冒号点亮度下限放到 80。
      "colon_bg_max_v": 255,
      "colon_v_delta": 30,
      "colon_v_min": 80,
      "colon_text_fix": true,
      "colon_text_fix_masked_only": true
    }
  },

  // 表情表用内置的 `wechat`（/run/media/puyu/C0DE6A4BDE6A39B4/out/wechat_emoji/wechat-emoji.json，109 个模板）。
  "emoji": {
    "enabled": true,
    "tables": {
      "wechat": {"build": {"enabled": true}}
    }
  },

  "input": {
    // 段顺序 = 时间顺序；每段在 output.dir 下开一个 segN 子目录。
    "videos": [
      "/home/puyu/oss-bucket/直播data/录屏/2026-0930-1006《全球车的中国路》/10.01/视频号/1/10：00-11：16.mp4",
      "/home/puyu/oss-bucket/直播data/录屏/2026-0930-1006《全球车的中国路》/10.01/视频号/1/11：16-12：43.mp4",
      "/home/puyu/oss-bucket/web/1/奇瑞汽车/直播看管/直播录屏/2026-0930-1006《全球车的中国路》/_live/1001_wechat_12-43-14-00_0-2854.mp4",
      "/home/puyu/oss-bucket/直播data/录屏/2026-0930-1006《全球车的中国路》/10.01/视频号/2/15：52-17：23.mp4"
    ],
    "segment_names": null,
    "video": null,
    "rows": null,
    "text": null,
    "start": 0.0,
    "duration": null,
    "interval": 2.0,
    "max_frames": null,
    "resume": true,

    // 手机 App 平滑滚动 ⇒ adaptive（静止段几乎不拍、滚动段不漏条）。
    "sample": {
      "mode": "adaptive",
      "stride": 2,
      "safety_rows": 5.0,
      "settle_frames": 3,
      "eps_px": 1.0,
      "entry_thr": 8.0,
      "max_gap_s": 5.0,
      "min_interval": 0.2,
      "max_interval": 6.0,
      "min_score": 0.3
    }
  },

  // 面板：**手写**（评论区位置已逐段量好；同一设备同一 App 版式）。
  // rect 是原图像素 [x1, y1, x2, y2]；mode=manual 下配置是唯一来源。
  "panels": {
    "mode": "manual",
    "file": null,
    "files": null,
    "overwrite": false,
    "auto": {
      "method": "hybrid",
      "at": 900,
      "frames": 5,
      "span": null,
      "split_x": null,                  // null = 不切分（竖屏单直播间一列评论）
      "pad_x": 60,
      "pad_top": 80,
      "pad_y": 16,
      "sub_width": 500,
      "model": "nvidia/LocateAnything-3B",
      "quant": "4bit",
      "device": "cuda",
      "platforms": {"left": "wechat_app", "right": null},
      "frame_width": 590
    },
    "manual": [
      {  //   seg1  `10：00-11：16.mp4`  590×1280 · 整段直播
        "comments": {"rect": [0, 633, 590, 1185], "platform": "wechat_app"}
      },
      {  //   seg2  `11：16-12：43.mp4`  590×1280 · 整段直播
        "comments": {"rect": [0, 634, 590, 1185], "platform": "wechat_app"}
      },
      {  //   seg3  `12：43-14：00.mp4`  590×1280 · 直播 0-2854s（裁后）
        "comments": {"rect": [0, 633, 590, 1185], "platform": "wechat_app"}
      },
      {  //   seg4  `15：52-17：23.mp4`  590×1280 · 整段直播
        "comments": {"rect": [0, 634, 590, 1185], "platform": "wechat_app"}
      }
    ],
    "batch": {"count": 30, "start": 0.0, "span": 600.0, "anchor": "panel"}
  },

  "parse": {
    "sep": " ",
    "max_username_len": 24,
    "merge_continuation": true,
    "adjacency": true,
    "dedup": true,
    // 自标定关掉：行距/相位/续行/浮层界已按本素材实测写死（同 10-31 / 09-12 口径）。
    "calibrate": false,
    "right_pad": 0,
    "emoji_workers": 8
  },

  "output": {
    // 多段时这是段的父目录：实际写 <dir>/seg1、seg2…；跨段产物也落在这里。
    "dir": "/run/media/puyu/C0DE6A4BDE6A39B4/out/2026-0930-1006全球车的中国路/10-01/视频号",
    "write": true,
    "rows": true,
    "panels": true,
    "frames": true,
    "print": false
  },

  // 评论 → 合格用户。**要花钱**；key 只走环境变量（项目铁律）。
  // 多段素材先逐段出全量（min_positive=1），跨段合计交给 qualify。
  "filter": {
    "enabled": true,
    "source": null,
    "out": null,
    "cache": null,
    "min_positive": 1,
    "exclude_keywords": [
      "奇瑞", "4s", "店", "qq3", "汽车",
      "尹同跃", "张国忠", "鲍思语", "王津华", "王孝伟", "胡敬源", "尹祥领",
      "王来春", "李晶", "商文江", "杨棉之", "叶盛基", "路风", "黎汝雄",
      "李学用", "张贵兵", "代立宏", "章红玉", "高新华", "戚士龙", "王琅"
    ],
    "nlp": {
      "api_key": null,                  // 留 null：key 只走环境变量
      "api_key_env": "NLP_API_KEY",
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "deepseek-v4.1-flash",
      "batch_size": 20,
      "concurrency": 4,
      "timeout": 60.0,
      "retries": 3,
      "limit": null,
      "prompt": null
    }
  },

  // 跨段判合格：按账号**合计**正面条数，≥3 条回写到每段 users_qualified.jsonl。
  "qualify": {
    "enabled": true,
    "min_positive": 3,
    "stage_min": 1
  },

  // 逐段出交付图：读 users_qualified.jsonl，按原帧画绿框，一人一个目录。
  "export": {
    "enabled": true,
    "base": "frame",
    "labels": "正面",
    "min_positive": null,
    "min_scope": "platform",
    "users": null,
    "color": "0,255,0", "width": 3,
    "pad": 0, "pad_ratio": 0.25, "quality": 90,
    "force": true
  },

  // 拼最终交付树：同名账号合并、图号跨段连续。
  "collect": {
    "enabled": true,
    "stage_min": null,
    "platform_dir": null,
    "out": "/run/media/puyu/C0DE6A4BDE6A39B4/out/2026-0930-1006全球车的中国路/10-01/视频号/all_users_正面_3张以上",
    "force": true
  },

  "draw": {"enabled": true, "source": null, "at": 8.0, "window": 5.0,
           "out": null, "width": 5, "quality": 90, "labels": true},

  "steps": {
    "order": ["emoji_tables", "panels", "parse", "filter", "qualify",
              "export", "collect", "draw"],
    "skip": ["emoji_tables", "draw"]
  }
}
