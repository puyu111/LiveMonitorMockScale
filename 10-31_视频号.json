// ============================================================================
// 奇瑞「电感智行·大美中国 48小时周末出游计划」2026-10-31 · 视频号直播
// （手机 App 竖屏 590×1280）→ 结构化评论
//
// 素材 = 「/run/media/puyu/A1B7-2982/10.31」视频号/ 下的**三段**录屏
// （同一场直播、时间**不重叠**，都是奇瑞汽车官方号）：
//   seg1  `16： 01-17： 21.mp4`  80.5min
//   seg2  `17： 21-18： 43.mp4`  82.7min
//   seg3  `18： 44-20： 08.mp4`  85.5min
//   三段一次配全（input.videos 显式数组 = 时间顺序），每段在 output.dir 下开一个
//   子目录（seg1/seg2/seg3），逐段步各跑一遍、跨段步（qualify/collect）整批跑一次。
//   管线本身串行循环（这台机器并行 OCR 会 OOM）。
//
// 行版式：`[✦N 等级药丸] 昵称：正文`（与 08-09CTCC / 风云A9L 视频号 App 同族）
//   · ✦N 画在昵称左边、独占徽章列；OCR 常把它并进正文（`+1丽塔：…` / `2徐路央：…`）
//     ⇒ badge_alias 归一见 CONFIG.md 的同名小节。
//   · 本场昵称**有的是打码的**（`乐**` / `幸**` / `A**`），交付按昵称认人
//     （与 08-09CTCC / 风云A9L 视频号同口径，不设 account_key=nickname_level）。
//   · 评论列表顶部会压「进房通知」（`乐** 来了` / `X 赞了直播`）和公众号/主题卡；
//     都按内置通知短语与 overlay_cards 吃掉（只作用于无冒号的行）。
//
// 这块素材量到的（2026-11-05，seg1 六帧，590×1280）：
//   ✅ 行距 41.0（相邻评论**首行**中心差 39~43、中位 41；自标定实测 41.0，置信度 0.68）
//   ✅ 相位 21（首行中心 ≈702，rect y1=640 ⇒ 62；62 mod 41 ≈ 21）
//   ✅ x_text 30（徽章列右沿）：真昵称块 x1≈34~36 · 药丸并进正文的读法 x1≈22~32 ⇒
//      取 30，小于真昵称的最小左沿 34，否则真昵称整块会被当徽章碎片丢掉。
//   ✅ rect [0,640,590,1185]：y1=640 在最早一条评论（y≈649）之上、直播画面底沿之下；
//      y2=1185 在输入栏 `聊一聊`（实测 1201~1231）之上；列表满宽 ⇒ x2_from=window
//   ✅ 折行续行在首行下方 ~26px（≈0.63 行距），自标定的 wrap_gap_ratio 会用这个量
//   ✅ 表情用内置 wechat 表（out/wechat_emoji/wechat-emoji.json，已建好）
//
// 跑法（OCR 要带 rapidocr 的解释器）：
//   P=/home/puyu/anaconda3/envs/vlx/bin/python
//   ① 抽行（慢；三段合计约 4.1h 录屏）：
//        export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
//        $P -m livepipe run 10-31_视频号.json --only panels,parse
//        ⚠ 中断了直接重跑同一条命令：<段目录>/rows.jsonl 已在 ⇒ 自动零 OCR 复算/续跑。
//   ② 筛 + 判合格 + 出图 + 拼交付树（**要 key**，只走环境变量）：
//        NLP_API_KEY=sk-xxxx $P -m livepipe run 10-31_视频号.json \
//            --only filter,qualify,export,collect
//   ③ 先看后交：产物在
//        out/10.31/视频号/all_users_正面_3张以上/
//
// 校验（不跑、安全）：
//   python3 -m livepipe check 10-31_视频号.json
//   python3 -m livepipe run   10-31_视频号.json --dry-run
// ============================================================================
{
  "version": 1,
  "name": "奇瑞电感智行·大美中国 2026-10-31 · 视频号手机 App · 竖屏",

  // -------------------------------------------------------------------------
  // 平台档案：面板文件里只填平台名，行距 / 表情表 / 裁切策略 / 药丸闸都从这里取。
  // 与 08-09CTCC / 风云A9L 视频号的 `wechat_app` 同一版式；本件的数字按本素材复核。
  // -------------------------------------------------------------------------
  "platforms": {
    "wechat_app": {
      "label": "视频号直播（手机 App 竖屏；等级标 ✦N 在昵称左边）",
      "emoji": "wechat",                // → emoji.tables 的 wechat 表（内置，表已建好）

      // 行距（像素）—— **实测**（2026-11-05，seg1 六帧）：相邻评论首行中心差
      //   39~43、中位 41。
      //   ⚠ **必须手写、不能交给自标定**（2026-11-05 用户全量跑翻车）：`calibrate_panels`
      //   只在开头采 4 帧，而本素材开头（t≈0~6s）评论稀疏、首行间距是 62/101.5/39/61.5/63/41.5
      //   ⇒ 中位 62，标定把行距从 41.0 抬到 **~62**（置信度 0.6 刚好过闸）。行距比真实行距
      //   大 1.5 倍后，相邻两条评论（实际 ~41px）落进**同一个行槽** ⇒ `assemble_row` 把两条
      //   拼成一句、ROI 取两行并集（用户报的 `符华-35/30.jpg`：框里圈进了下一条
      //   `小燕子：奇瑞造车很多年了…`）。实测该轮全量 27.7% 的评论带这个污染。
      "row_pitch": 41.0,

      // 首行中心距面板顶（裁剪内坐标）—— 兜底值（逐帧由 estimate_phase 重估）。
      //   实测首行中心 ≈740、rect y1=730（用户 2026-11-05 从 640 改到 730，避开顶部
      //   进房通知）⇒ 相位 ≈10；改回 y1=640 时应同步改成 21。
      "y_phase": 10,

      // 正文列左沿（徽章列右沿，**裁剪内**坐标）—— **实测**：
      //   真昵称块 x1≈34~36（顶在正文列）· 药丸并进正文的读法 x1≈22~32 ·
      //   纯等级数字块 x1≈27。取 **30**（< 真昵称最小左沿 34），否则真昵称整块被当徽章碎片丢掉。
      "x_text": 30,

      // 裁切右沿：**取窗口右沿**（App 评论列表满宽、不随内容伸缩）——超集，按构造不裁内容。
      "x2_from": "window",

      // 折行续行：视频号的续行**贴左沿**（x1≈22~30），而本档案 x_text=30 ⇒ 几何闸里
      //   「贴左沿」的门槛 = 30−58+8 = **−20**，走不到那一支 ⇒ **必须**显式开
      //   `wrap_indent`，让缩进带里的无冒号块按形状认续行（再由间距闸定去留）。
      //   纯数字药丸碎片由 `_is_junk` 挡在外面；关掉自标定后这个开关只能手写，
      //   否则续行整类会被当徽章碎片丢掉。
      "wrap_indent": true,

      // 续行间距比上限 —— 实测续行在首行下方 ~26px = **0.63 行距**；自标定在干净切片上
      //   量到 0.75。取 0.75（仍远小于 1.0 ⇒ 占满一个行距的系统通知照旧被挡掉）。
      "wrap_gap_ratio": 0.75,

      // 折行续行的**软入口**（与微博同一套，见 group_rows 的 `_text_left_candidates`）：
      //   本素材的续行左沿实测 **21~37**，与首行昵称的 34~36 重叠 —— 表情/首字字宽会把
      //   续行推回正文列（`合适` 的 `合` 左沿 33~37），`wrap_indent` 的形状带
      //   [x_text−50, x_text) = [−20, 30) **接不住** x1=33~37 的那些。后果分两种，
      //   2026-11-05 都在用户报的帧上出现过（seg1 t=4637）：
      //     · 落到下一整数槽 ⇒ 自成一条匿名评论（`合适` 单独成一条）；
      //     · 与首行挤进同一槽 ⇒ `assemble_row` 按 x 拼字（`摸鱼的西红柿` + `合活` +
      //       `在泉州…`，正文变成 `摸鱼的西红柿合活在泉州…`）。
      //   软入口按**间距**判（无冒号、x1 ≤ x_text+8、离上一行 0.15~0.75 个行距 ⇒ 续行；
      //   占满一个行距的照旧是独立评论），不依赖左沿形状。
      "wrap_at_text_left": true,

      // 行首等级药丸被 OCR 并进正文 ⇒ 同一人被读成好几个账号，按几何见证归一。
      "badge_alias": true,

      // 昵称末尾被**检测框切掉** 1~2px（或整个末字漏读）⇒ 同一个人被拆成两个账号，
      //   按「同一条评论的两种读法同现」归一（见 normalize_username_alias）。
      //   本素材实测：`W.`/`W`（句点被切）、`李素熵`/`李素`（末字漏读）、
      //   `期待sj`/`期待si`（`j` 的降部被框切 1px，同一份像素换个框高就读成 `i`）。
      "username_alias": true,

      // 评论列表上的浮层卡：内置表认「提示卡 / 主题卡 / 公众号卡」（`欢迎来到直播间…`
      //   / `主题…` / `公众号…`）；本素材的主题卡第二行 `电感智行大美中国` 与公众号卡
      //   品牌行（`奇瑞汽车>`）没有通用特征词，按**素材短语**补进来。
      //   判据只作用于**没有冒号的行**，真评论（`章衡：…`）不受影响。
      "overlay_cards": "电感智行大美中国|奇瑞汽车>|公众号奇瑞汽车>",

      // 本场要**整行跳过**的词（opt-in，解析层 `parse_live_rows`）：整行（忽略空白）
      //   等于其中任一词就丢掉这一行。只认**整行**、不按后缀剥 —— 正文里提到
      //   `奇瑞汽车` 的真评论（`小王：奇瑞汽车真不错`）不受影响。
      //   典型：公众号卡（OCR 只剩 `奇瑞汽车>`）、主题卡第二行（`电感智行大美中国`）。
      "skip_phrases": [
        "奇瑞汽车>",
        "公众号奇瑞汽车>",
        "电感智行大美中国"
      ],

      // 冒号像素检测阈值（见 parsing/ocr/colon.py）：视频号气泡半透明、底偏亮，
      //   默认 bg_max_v=110 会整类短路 ⇒ 放开背景亮度、把亮度差降到 30。
      "colon_bg_max_v": 255,
      "colon_v_delta": 30,
      // 冒号的**绝对亮度下限**（默认 100 太高）：灰色冒号的两个点只有 2×2，评论靠近面板
      //   下沿、列表滚动时被重采样，下点的 V 会掉到 **78~86**（实测 t=4630.9 上点
      //   129/116、下点 86/78）⇒ v_min=100 把下点整颗滤掉、点对凑不齐，昵称与正文粘成
      //   `摸鱼的西红柿在泉州…`（用户名丢失）。80 仍高于暗背景（V≈20）与噪声，点对几何
      //   （同列 ±2px、同宽高、间隙 3~14px、孤立）不变。
      "colon_v_min": 80,

      // OCR 把冒号吃掉时，按像素位置补回文本；打码昵称单星号形态也放行。
      "colon_text_fix": true,
      "colon_text_fix_masked_only": true
    }
  },

  // 表情表用内置的 `wechat`（out/wechat_emoji/wechat-emoji.json）
  // ⇒ 这里一个字段都不用写：emoji.tables 的默认值就是它，emoji.enabled 默认 true。

  "input": {
    // 三段素材：**显式数组**（段顺序 = 时间顺序）。
    "videos": [
      "/run/media/puyu/A1B7-2982/10.31/视频号/16： 01-17： 21.mp4",
      "/run/media/puyu/A1B7-2982/10.31/视频号/17： 21-18： 43.mp4",
      "/run/media/puyu/A1B7-2982/10.31/视频号/18： 44-20： 08.mp4"
    ],
    "segment_names": null,              // 段名（= 子目录名）；null ⇒ seg1、seg2、seg3
    "video": null,                      // 单段写法（与 videos 互斥，本件用不到）              --video
    "rows": null,                       // 单段复算用；多段不用写（<段目录>/rows.jsonl 在就自动复算）
    "text": null,                       // 纯文本行文件；"-" 读 stdin                            --text
    "start": 0.0,                       // 起始时间（秒）                                      --start
    "duration": null,                   // 处理多长（秒）；null = 整段                          --duration
    "interval": 2.0,                    // 固定间隔抽样用（本件用 adaptive，此项不生效）          --interval
    "max_frames": null,                 // 最多抽几帧；null = 不限                              --max-frames
    "resume": true,                     // 断点续跑：rows.jsonl 已在就接着它跑（已处理帧跳过）   --resume

    // 抽帧策略：手机 App 是平滑滚动 ⇒ 长录屏用 adaptive（静止段几乎不拍、滚动段不漏条）。
    "sample": {
      "mode": "adaptive",               //   interval / backoff / adaptive                     --sample-mode
      "stride": 2,                      //   每 N 个解码帧估一次位移（1 = 每帧都估）
      "safety_rows": 5.0,               //   累计位移 ≥ 这么多行 ⇒ 强制拍（上限 5）
      "settle_frames": 3,               //   动过之后静止这么多帧 ⇒ 拍一次
      "eps_px": 1.0,                    //   位移小于它算「没动」
      "entry_thr": 8.0,                 //   底部入口行变化多少像素算「新评论弹进来」
      "max_gap_s": 5.0,                 //   最长多久必须拍一次（0 = 不限）
      "min_interval": 0.2,              //   两次拍摄的最小间隔（秒）
      "max_interval": 6.0,              //   两次拍摄的最大间隔（秒）
      "min_score": 0.3                  //   位移估计的匹配分下限
    }
  },

  // -------------------------------------------------------------------------
  // 面板：**手写**（评论列表位置已在每段首帧量好，不需要再跑模型定位）。
  // rect 是**原图像素**的评论区窗口：[x1, y1, x2, y2]
  //   · y1=640：评论列表顶（最早一条评论 y≈649）；其上是直播画面。
  //   · y2=1185：输入栏 `聊一聊` 实测 1201~1231，切在它之上。
  //   · x1=0 / x2=590：App 列表满宽（x2_from=window 取窗口右沿）。
  //   · 三段同一台设备、同一版 App（590×1280）⇒ 共用一套 rect。
  //   · 改了 rect 直接重跑即可：manual 下配置是唯一来源（与面板文件不一致时按配置重写）。
  // -------------------------------------------------------------------------
  "panels": {
    "mode": "manual",                   // manual=手写面板直接写进 file（交付走 manual）
    "file": null,                       // null ⇒ 每段各一个 <段目录>/panels.json（多段）
    "files": null,                      // 也可显式一份一段地列出面板文件路径（顺序 = 段顺序）
    "overwrite": false,                 // manual：配置与面板文件不一致就按配置重写；locate：已存在就不动
    "auto": {                           // 自动定位参数（mode=locate/auto/batch 时用；本件用不到）
      "method": "hybrid",
      "at": 900,
      "frames": 5,
      "span": null,
      "split_x": null,                  //   ⚠ null = **不切分**（竖屏单直播间是一列评论）
      "pad_x": 60,
      "pad_top": 80,
      "pad_y": 16,
      "sub_width": 500,                 //   ⚠ 竖屏整帧裁切必须降下来，否则 4bit 模型 CUDA OOM
      "model": "nvidia/LocateAnything-3B",
      "quant": "4bit",
      "device": "cuda",
      "platforms": {                    //   只在 mode=auto/builtin/batch 时用
        "left": "wechat_app",           //   不切分后唯一的窗口叫 left
        "right": null
      },
      "frame_width": 590
    },
    // mode=manual：手写面板，**一段一项**（顺序与 input.videos 的段顺序一致）。
    // **配置是唯一来源**：段目录里的 panels.json 只是它的落盘副本。
    "manual": [
      {                                //   seg1  `16： 01-17： 21.mp4`  590×1280
        "comments": {"rect": [0, 730, 590, 1185], "platform": "wechat_app"}
      },
      {                                //   seg2  `17： 21-18： 43.mp4`  590×1280
        "comments": {"rect": [0, 730, 590, 1185], "platform": "wechat_app"}
      },
      {                                //   seg3  `18： 44-20： 08.mp4`  590×1280
        "comments": {"rect": [0,730, 590, 1185], "platform": "wechat_app"}
      }
    ],
    "batch": {                          // mode=batch：稳定性研究（挑固定矩形用；不动 file）
      "count": 30,
      "start": 0.0,
      "span": 600.0,
      "anchor": "panel"
    }
  },

  "parse": {
    "sep": " ",                         // 续行拼接用的分隔符                                      --sep
    "max_username_len": 24,             // 冒号前超过这个长度就不当用户名                          --max-username-len
    "merge_continuation": true,         // 是否把「无用户名的行」并进上一条评论                   取反 --no-merge
    "adjacency": true,                  // 「续行必须相邻」守卫                                  取反 --no-adjacency
    "dedup": true,                      // 按滚动对齐跨帧去重出唯一评论表                        取反 --no-dedup
    // ⚠ 关掉自标定（2026-11-05 用户全量跑翻车）：`calibrate_panels` 只在开头采 4 帧，
    //   本素材开头评论稀疏（首行间距 62/101.5/39/61.5/63/41.5 ⇒ 中位 62），标定把行距
    //   从 41.0 抬到 ~62 ⇒ 相邻两条评论（实际 ~41px）落进同一个行槽、被拼成一句
    //   （用户报的 `符华-35/30.jpg` 圈进下一条评论；该轮 27.7% 的评论带此污染）。
    //   行距 41.0 / 相位 / 续行开关都已实测写死，关掉最稳（与 10-31 抖音/快手同口径）。
    "calibrate": false,                 // 面板几何自标定（行距/浮层右界/续行；相位逐帧估）      取反 --no-calibrate
    "right_pad": 0,                     // ROI 右边界距面板右边的余量；0 = 贴面板边圈住框外表情    --right-pad
    "emoji_workers": 8                  // 表情扫描线程数；只影响速度、不改变结果
  },

  "output": {
    // 多段时这里是**段的父目录**：实际各写 <dir>/seg1、seg2、seg3；
    // 跨段产物落在这儿：merged_users.json（qualify）；交付树见 collect.out。
    // 按平台分目录：同素材另有「抖音/」「快手/」，各用各的 output.dir，段目录不会撞。
    "dir": "out/10.31/视频号",          // 输出根目录                                             --out
    "write": true,                      // 是否写盘（comments.jsonl + summary.json 成对）
    "rows": true,                       // 另存 rows.jsonl（**可回喂复算**）
    "panels": true,                     // mode=auto 时把定位结果存成 panels.json
    // frames：**抽样帧**一张图 frames/<t>_roi.jpg（≈0.55MB/张），不是每条评论一张。
    "frames": true,                     // 取反 --no-frames
    "print": false                      // 除写盘外也把评论打到 stdout                            --print
  },

  // 评论 → 合格用户：用户名 ≥min_positive 条**正面**评论（正面由大模型判定，表情也发），
  // 并排除用户名命中关键词的官方侧账号。**要花钱**；key **只走环境变量**（本项目铁律）。
  //
  // ⚠ 本件是**三段素材**，交付要求「该账号 ≥3 条正面」是**按三段合计**判的 ⇒
  //   这里 `min_positive: 1`（只出全量用户表），合格与否交给 `qualify` 步按合计判。
  "filter": {
    "enabled": true,                    // 打开才会调模型；只想抽评论就先 --skip filter
    "source": null,                     // 评论来源；null ⇒ <段目录>/comments.jsonl
    "out": null,                        // 合格用户 JSONL；null ⇒ <段目录>/users.jsonl
    "cache": null,                      // 判定缓存；null ⇒ 三段共用 <output.dir>/judgments.jsonl
    "min_positive": 1,                  // 单段阈值（**合计口径见上面 ⚠**；qualify 一开就自动取 stage_min）
    "exclude_keywords": [               // 用户名含任一即排除（不区分大小写）
      // ⚠ 沿用**奇瑞那条线**的表（品牌 + 4S + 车型 + 高管姓名）；本场官方号 / 主播 /
      //   试驾员还没按本场补。填错的代价是把真观众挡在名单外 ⇒ 等名单出来再逐条加。
      "奇瑞", "4s", "店", "qq3", "汽车",
      "尹同跃", "张国忠", "鲍思语", "王津华", "王孝伟", "胡敬源", "尹祥领",
      "王来春", "李晶", "商文江", "杨棉之", "叶盛基", "路风", "黎汝雄",
      "李学用", "张贵兵", "代立宏", "章红玉", "高新华", "戚士龙", "王琅"
    ],
    "nlp": {
      "api_key": null,                  // **留 null**：key 只走环境变量（本项目铁律）
      "api_key_env": "NLP_API_KEY",     // ← 环境变量的**名字**（把 key 写到这行永远取不到）
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "deepseek-v4.1-flash",   // ⚠ 模型名会随平台改，写错就是 404（不是 key 的问题）
      "batch_size": 20,
      "concurrency": 4,
      "timeout": 60.0,
      "retries": 3,
      "limit": null,                    // 最多调多少批（控成本）
      "prompt": null                    // null ⇒ 用 user_filter.DEFAULT_PROMPT
    }
  },

  // -------------------------------------------------------------------------
  // 跨段的两步（顺序有依赖：filter（逐段）→ qualify（跨段）→ export（逐段）→ collect（拼树））
  // -------------------------------------------------------------------------

  // 跨段判合格（**全局步**）：把三段的 users.jsonl 按**账号合计**算正面条数，≥min_positive
  // 的才算合格，再把合格用户**回写**成每段的 users_qualified.jsonl 交给 export。
  "qualify": {
    "enabled": true,                    // 单段素材开着也无害（退化成「按本段判」）
    "min_positive": 3,                  // 交付阈值（**跨段合计**）—— 与 08-09CTCC 参考语料一致
    "stage_min": 1                      // 各段 filter/export 用的阈值（先出全量，合格留给这一步判）
  },

  // 逐段出交付图（**逐段步**）：读该段 users_qualified.jsonl，按**原帧**画绿框，一人一个目录
  // `<昵称>-<本段条数>`（跨段同名目录由 collect 并成一个）。
  "export": {
    "enabled": true,
    "base": "frame",                    // frame=原帧（参考语料形态）/ annotated=标注图      --base
    "labels": "正面",                   // 只出正面评论                                        --labels
    "min_positive": null,               // null ⇒ qualify.stage_min（合格已在 qualify 判完）
    "min_scope": "platform",            // 平台内各自够数；三段同一平台 ⇒ 等同于按合计         --min-scope
    "users": null,                      // null ⇒ <段目录>/users_qualified.jsonl
    "color": "0,255,0", "width": 3,     // 绿框（对齐参考语料）
    "pad": 0, "pad_ratio": 0.25, "quality": 90,
    "force": true                       // 重跑覆盖上一轮的导出目录
  },

  // 拼最终交付树（**全局步**）：把三段的导出目录按账号身份并成一个目录、图号 1..N
  // **跨段连续**，后缀取**合计**条数，顺带写 正面账号.txt + manifest.json。
  // out 显式写死：output.dir 已经带 `/视频号`，再让 collect 自动拼 `<平台目录>` 会变成
  // …/视频号/视频号/…。
  "collect": {
    "enabled": true,
    "stage_min": null,                  // 各段导出目录名里的数字；null ⇒ qualify.stage_min
    "platform_dir": null,               // 交付树里的平台目录名；null ⇒ 从各段导出目录自动认（视频号）
    "out": "out/10.31/视频号/all_users_正面_3张以上",
    "force": true                       // 目标非空时整棵重来（否则报错退出）
  },

  "draw": {                             // 独立描框步骤（draw_boxes.py）；核心解析已自带逐帧标注图，默认关
    "enabled": true,
    "source": null,
    "at": 8.0,
    "window": 5.0,
    "out": null,
    "width": 5,
    "quality": 90,
    "labels": true
  },

  "steps": {
    // 顺序**不能乱**：filter（逐段）→ qualify（跨段判合格）→ export（逐段）→ collect（拼树）。
    // 逐段步（panels/parse/filter/export/draw）三段各跑一遍；全局步（emoji_tables/qualify/collect）整批一次。
    "order": ["emoji_tables", "panels", "parse", "filter", "qualify",
              "export", "collect", "draw"],
    "skip": ["emoji_tables", "draw"]    // 表情表已建好（out/wechat_emoji/）；独立描框用不上
  }
}
