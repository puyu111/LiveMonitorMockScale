//        NLP_API_KEY=sk-xxxx $P -m livepipe run 09-14艾瑞泽8CTCC_视频号.json \
//            --only filter,qualify,export,collect
//   ③ 先看后交：产物在
//        /run/media/puyu/C0DE6A4BDE6A39B4/out/2026-09-14艾瑞泽8CTCC职业联赛（上海站）（渠道七七）/视频号/all_users_正面_3张以上/
