// ============================================================================
// CTCC 职业联赛（上海站）2026-09-12 · 抖音直播
// （手机 App 竖屏 590×1280；渠道七七）→ 结构化评论
//
// 素材 = 「/run/media/puyu/MyDisk/2026-09-12艾瑞泽8CTCC职业联赛（上海站）（渠道七七）/
// 抖音/奇瑞汽车/」下的**两段**录屏（同一场直播、时间不重叠，账号「奇瑞汽车」）：
//   seg1  `14：36-16：04.mp4`  88.7min（整段直播）
//   seg2  `16：05-17：49.mp4`  103.8min 原片，**直播约 16:30 结束**，其后是「直播已结束」
//         的推荐流 / 广告页 ⇒ 预先裁到直播末帧 **1505.1s**（25.1min；
//         判据 = 底部输入栏 `说点什么` 最后一次出现在 1505.34s，再留 0.2s 余量）：
//           /run/media/puyu/C0DE6A4BDE6A39B4/out/2026-09-12艾瑞泽8CTCC职业联赛（上海站）（渠道七七）/media/
//               dy_eve_16-05-17-49_live.mp4
//         ⚠ 裁切是 **stream copy**（PyAV add_stream_from_template，不重编码）。
//   两段一次配全（input.videos 显式数组 = 时间顺序）。每段在 output.dir 下开一个
//   子目录（seg1/seg2），逐段步各跑一遍、跨段步（qualify/collect）整批跑一次。
//   管线本身串行循环（这台机器并行 OCR 会 OOM）。
//
// 行版式：`[◆N 粉丝团药丸] 昵称：正文`（与 08-08CTCC / 09-05~09-09 猎鹰抖音同族）。
//   · 药丸 = 菱形图标 + 粉丝团等级数字（`5`/`17`/`21`…），画在 x∈[39,82]；
//     OCR 有时把数字并进正文块（`18慢行人：` / `8七七柒：`）⇒ badge_alias 归一。
//   · 本批**有打码昵称**（系统行 `可**`、评论人也有 `穿越**：亚克力` 这类读法），
//     也有大量真昵称 ⇒ account_key=**nickname_level_if_masked**
//     （打码才按 (昵称, 等级) 认人，不打码只看昵称；见 livepipe/account_id.py）。
//     这一口径会**自动打开** parse.badge_reread（打码名要等级标做身份）。
//   · 直播间右侧压**商品讲解卡**（`讲解中` / `CHERY` / `2026CTCC` /
//     `中国汽车场地职业联赛` / `上海站` / `CTCC-上海站` / `立即预约`），
//     卡块左沿实测 **390** ⇒ x_ignore_from=380 把卡整块丢掉。
//   · 系统行：`X 来了` / `X 为主播点赞了` / `X 关注了主播`（内置表覆盖）。
//
// 这块素材量到的（2026-11-10，每文件 6 帧，590×1280）：
//   ✅ 行距 **35.0**（续行间距 28~30.5、独立评论/通知行 38~45.8，
//      两簇分别在 0.80~0.87 / 1.09~1.31 行距）
//   ✅ 首行中心 ≈675（rect y1=655 ⇒ 相位 ≈20；逐帧还会重估，这个只兜底）
//   ✅ x_text **78**：药丸数字 x∈[41,82]（`+5`/`17`/`21`）· 真昵称 x1≈80~85 ·
//      折行续行 x1≈32~34。取 78：纯药丸碎片整块落在左边被丢；带冒号的正文
//      （含药丸并进正文的 `18慢行人：`，x1=39）无论 x1 多大都保留。
//   ✅ 折行续行 ~28~30.5px = **0.80~0.87 行距**；独立行 ≥38px ⇒
//      wrap_gap_ratio **0.95**（夹在两簇中间）；续行是**缩进**的 ⇒ wrap_indent 必开
//      （缩进带判据 = x_text−badge_span+8 = 28，续行 x1=32~34 全在带内）。
//   ✅ rect **[0,655,590,1210]**：视频区/评论区分界 ≈655、输入栏
//      `说点什么...` 实测 1221~1251 ⇒ y2=1210 切在它之上；x2=590 满宽。
//   ✅ 评论正文右沿最大 362；商品卡文字 x1≥390 ⇒ x_ignore_from=380。
//   ✅ 表情用抖音那套表（/run/media/puyu/C0DE6A4BDE6A39B4/out/douyin_emoji/douyin-emoji.json，已建好）。
//   ✅ 两段同一分辨率（590×1280）⇒ 一个平台档案即可。
//
// 跑法（OCR 要带 rapidocr 的解释器）：
//   P=/home/puyu/anaconda3/envs/vlx/bin/python
//   ① 抽行（慢；两段合计约 1.9h 直播）：
//        export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
//        $P -m livepipe run 09-12CTCC_抖音.json --only panels,parse
//        ⚠ 中断了直接重跑同一条命令：<段目录>/rows.jsonl 已在 ⇒ 自动零 OCR 复算/续跑。
//   ② 筛 + 判合格 + 出图 + 拼交付树（**要 key**，只走环境变量）：
//        NLP_API_KEY=sk-xxxx $P -m livepipe run 09-12CTCC_抖音.json \
//            --only filter,qualify,export,collect
//   ③ 先看后交：产物在
//        /run/media/puyu/C0DE6A4BDE6A39B4/out/2026-09-12艾瑞泽8CTCC职业联赛（上海站）（渠道七七）/抖音/all_users_正面_3张以上/
//
// 校验（不跑、安全）：
//   python3 -m livepipe check 09-12CTCC_抖音.json
//   python3 -m livepipe run   09-12CTCC_抖音.json --dry-run
// ============================================================================
{
  "base_dir": "/run/media/puyu/C0DE6A4BDE6A39B4",
  "version": 1,
  "name": "CTCC职业联赛 2026-09-12（上海站）（渠道七七）· 抖音手机 App · 竖屏",

  // -------------------------------------------------------------------------
  // 平台档案：面板文件里只填平台名，行距 / 表情表 / 裁切策略 / 药丸闸都从这里取。
  // 与 08-08CTCC 的 douyin_app 同一版式；本件数字按本素材复核（分辨率变成 590×1280）。
  // -------------------------------------------------------------------------
  "platforms": {
    "douyin_app": {
      "label": "抖音直播（手机 App 590×1280；行首 ◆N 粉丝团药丸在昵称左边）",
      "emoji": "douyin",                // → emoji.tables 的 douyin 表（内置，表已建好）

      // 交付认人口径：本批有打码昵称（`穿越**`）也有真昵称 ⇒ 只有打码名才按等级拆。
      //   见 livepipe/account_id.py 的 `nickname_level_if_masked` 小节。
      "account_key": "nickname_level_if_masked",

      // 行距（像素）—— **实测**（2026-11-10，每文件 6 帧）：
      //   续行间距 28~30.5、独立评论/通知行 38~45.8；取 35.0 夹在两簇之间。
      "row_pitch": 35.0,

      // 首行中心距面板顶（裁剪内坐标）—— 实测相位 **20**（首行中心 ≈675，rect y1=655）；
      //   逐帧还会重估，这个只兜底。
      "y_phase": 20,

      // 正文列左沿 = 徽章列右沿（**裁剪内坐标**；rect x1=0 ⇒ 原图坐标）—— **实测**：
      //   药丸数字块 x∈[41,82] · 真昵称 x1≈80~85 · 折行续行 x1≈32~34。
      //   取 **78**：纯药丸碎片整块落在左边被丢；带冒号的正文不受影响。
      "x_text": 78,

      // ROI 左沿（标注图/交付裁图圈的那一圈）—— 徽章列宽：78−58 = 20 圈住整颗药丸。
      "badge_span": 58,

      // 裁切右沿：**按内容**。评论正文右沿实测最大 362，rect x2=590 留余量；
      //   再往右是商品卡区间（卡块由 x_ignore_from 丢，不进正文）。
      "x2_from": "content",

      // 行首**药丸数字被并进正文**（`18慢行人：` / `8七七柒：`）⇒ 同一人被读成
      //   好几个账号，按几何见证归一（normalize_badge_alias，见 CONFIG.md）。
      "badge_alias": true,

      // 昵称末尾被检测框切掉 1~2px / 整个末字漏读 ⇒ 同一人被拆成两个账号，
      //   按「同一条评论的两种读法同现」归一（normalize_username_alias）。
      "username_alias": true,

      // 等级药丸与昵称被 OCR 并成一块时，把昵称拼回用户名。
      "badge_name_recover": true,

      // 折行续行：本批续行**缩进**（x1≈32~34），落在缩进带 [28,78) 里 ⇒ 必须开
      //   wrap_indent，否则整条续行会被当徽章碎片丢掉（多行评论散成幽灵匿名评论）。
      "wrap_indent": true,

      // 折行续行间距比上限 —— 实测续行 28~30.5px = **0.80~0.87 行距**；
      //   独立评论/通知行实测 38~45.8px = 1.09~1.31 行距。取 0.95 夹在两簇中间。
      "wrap_gap_ratio": 0.95,

      // 直播间浮层的左界（裁剪内 x）—— **实测**写死：评论正文块 x2 都 ≤362、
      //   商品讲解卡文字块最小 x1=390（`CTCC-上海站`）⇒ 空带取 **380**。
      //   ⚠ 不交给自标定：卡只在一部分时间出现，采样帧里没有卡就标不出界。
      "x_ignore_from": 380,

      // 评论列表上的浮层卡（不是评论、又没有冒号）。商品卡已由 x_ignore_from 消掉，
      //   这里按短语兜底（只作用于**没有冒号**的行）：
      //   `2026CTCC` 标题卡 / `中国汽车场地职业联赛` 主题卡 / `上海站` / `CTCC-上海站` /
      //   `讲解中` / `CHERY` / `立即预约`。
      "overlay_cards": "^2026CTCC.*|^中国汽车场地职业联赛.*|^上海站$|^CTCC-上海站.*|^讲解中$|^CHERY$|^立即预约$|^\\d+人已预约$",

      // 本场直播的**专用词**（商品卡/浮层文字）—— OCR 会把它们接在评论行尾。
      //   parse 时按**行尾**剥掉；整行都是这些词时当作这一行不存在。
      //   正文中间的真提及不动（只剥后缀）。
      "strip_phrases": [
        "讲解中", "立即预约", "人已预约", "2026CTCC", "CTCC-上海站"
      ],

      // 冒号像素检测阈值（见 parsing/ocr/colon.py）：抖音气泡半透明、底偏亮，
      //   默认 bg_max_v=110 会整类短路 ⇒ 放开背景亮度、把亮度差降到 30。
      "colon_bg_max_v": 255,
      "colon_v_delta": 30,

      // OCR 把冒号吃掉时，按像素位置补回文本。
      "colon_text_fix": true,

      // 长表情评论折成多行：第二行没有 OCR 文字、落在两条已检出行之间
      //   ⇒ 抽行时在空档里补扫（emoji_gap_sweep），parse 时把纯表情续行并进上一条
      //   （merge_emoji_continuation）。两个都开才完整。
      "merge_emoji_continuation": true,
      "emoji_gap_sweep": true
    }
  },

  // 表情表用内置的 `douyin`（/run/media/puyu/C0DE6A4BDE6A39B4/out/douyin_emoji/douyin-emoji.json）。
  // ⚠ 表是 **JSON + img/ 图片** 两部分；upload_livepipe_ssh.py 只传表 JSON、
  //   不传 img/（214 张 webp）⇒ 远程解析时 214 条模板全缺图，会打
  //   "一条可用的模板都没有（图没下全？）" 并跳过表情识别。
  //   ⇒ 打开 build.enabled：run.sh 开头的预建表步骤在**远程**调官方表情接口
  //   （www.douyin.com/aweme/v1/web/emoji/list，实测 214 张、约 1 分钟）重建表，
  //   落 <base_dir>/out/douyin_emoji/。本机 steps.skip 含 emoji_tables，不会重复建。
  //   不想刷新用 `LIVEPIPE_SKIP_EMOJI=1 ./run.sh …`。
  "emoji": {
    "tables": {
      "douyin": {
        "build": {"enabled": true}
      }
    }
  },

  "input": {
    // 两段素材：**显式数组**（段顺序 = 时间顺序）。
    //   seg2 用**裁到直播末帧**的副本（原片 16：05-17：49 的后 78min 全是结束页/推荐流）。
    "videos": [
      "/run/media/puyu/MyDisk/2026-09-12艾瑞泽8CTCC职业联赛（上海站）（渠道七七）/抖音/奇瑞汽车/14：36-16：04.mp4",
      "/run/media/puyu/C0DE6A4BDE6A39B4/out/2026-09-12艾瑞泽8CTCC职业联赛（上海站）（渠道七七）/media/dy_eve_16-05-17-49_live.mp4"
    ],
    "segment_names": null,              // 段名（= 子目录名）；null ⇒ seg1、seg2
    "video": null,                      // 单段写法（与 videos 互斥，本件用不到）              --video
    "rows": null,                       // 单段复算用；多段不用写（<段目录>/rows.jsonl 在就自动复算）
    "text": null,                       // 纯文本行文件；"-" 读 stdin                            --text
    "start": 0.0,                       // 起始时间（秒）                                      --start
    "duration": null,                   // 处理多长（秒）；null = 整段                          --duration
    "interval": 2.0,                    // 固定间隔抽样用（本件用 adaptive，此项不生效）          --interval
    "max_frames": null,                 // 最多抽几帧；null = 不限                              --max-frames
    "resume": true,                     // 断点续跑：rows.jsonl 已在就接着它跑（已处理帧跳过）   --resume

    // 抽帧策略：手机 App 是平滑滚动 ⇒ 长录屏用 adaptive（静止段几乎不拍、滚动段不漏条）。
    "sample": {
      "mode": "adaptive",               //   interval / backoff / adaptive                     --sample-mode
      "stride": 2,                      //   每 N 个解码帧估一次位移（1 = 每帧都估）
      "safety_rows": 5.0,               //   累计位移 ≥ 这么多行 ⇒ 强制拍（上限 5）
      "settle_frames": 3,               //   动过之后静止这么多帧 ⇒ 拍一次
      "eps_px": 1.0,                    //   位移小于它算「没动」
      "entry_thr": 8.0,                 //   底部入口行变化多少像素算「新评论弹进来」
      "max_gap_s": 5.0,                 //   最长多久必须拍一次（0 = 不限）
      "min_interval": 0.2,              //   两次拍摄的最小间隔（秒）
      "max_interval": 6.0,              //   两次拍摄的最大间隔（秒）
      "min_score": 0.3                  //   位移估计的匹配分下限
    }
  },

  // -------------------------------------------------------------------------
  // 面板：**手写**（评论列表位置已在每段首帧量好，不需要再跑模型定位）。
  // rect 是**原图像素**的评论区窗口：[x1, y1, x2, y2]
  //   · y1=655：评论列表顶（首行中心 ≈675）；其上是直播画面；
  //   · y2=1210：输入栏 `说点什么...` 实测 1221~1251，切在它之上；
  //   · x1=0 / x2=590：列表满宽（x2_from=content 按内容取右沿）。
  //   · 两段同一分辨率（590×1280）⇒ 共用一套 rect。
  //   · 改了 rect 直接重跑即可：manual 下配置是唯一来源（与面板文件不一致时按配置重写）。
  // -------------------------------------------------------------------------
  "panels": {
    "mode": "manual",                   // manual=手写面板直接写进 file（交付走 manual）
    "file": null,                       // null ⇒ 每段各一个 <段目录>/panels.json（多段）
    "files": null,                      // 也可显式一份一段地列出面板文件路径（顺序 = 段顺序）
    "overwrite": false,                 // manual：配置与面板文件不一致就按配置重写；locate：已存在就不动
    "auto": {                           // 自动定位参数（mode=locate/auto/batch 时用；本件用不到）
      "method": "hybrid",
      "at": 900,
      "frames": 5,
      "span": null,
      "split_x": null,                  //   ⚠ null = **不切分**（竖屏单直播间是一列评论）
      "pad_x": 60,
      "pad_top": 80,
      "pad_y": 16,
      "sub_width": 500,                 //   ⚠ 竖屏整帧裁切必须降下来，否则 4bit 模型 CUDA OOM
      "model": "nvidia/LocateAnything-3B",
      "quant": "4bit",
      "device": "cuda",
      "platforms": {                    //   只在 mode=auto/builtin/batch 时用
        "left": "douyin_app",           //   不切分后唯一的窗口叫 left
        "right": null
      },
      "frame_width": 590
    },
    // mode=manual：手写面板，**一段一项**（顺序与 input.videos 的段顺序一致）。
    "manual": [
      {                                //   seg1  `14：36-16：04.mp4`  590×1280
        "comments": {"rect": [0, 690, 590, 1210], "platform": "douyin_app"}
      },
      {                                //   seg2  `dy_eve_16-05-17-49_live.mp4`  590×1280
        "comments": {"rect": [0, 690, 590, 1210], "platform": "douyin_app"}
      }
    ],
    "batch": {                          // mode=batch：稳定性研究（挑固定矩形用；不动 file）
      "count": 30,
      "start": 0.0,
      "span": 600.0,
      "anchor": "panel"
    }
  },

  "parse": {
    "sep": " ",                         // 续行拼接用的分隔符                                      --sep
    "max_username_len": 24,             // 冒号前超过这个长度就不当用户名                          --max-username-len
    "merge_continuation": true,         // 是否把「无用户名的行」并进上一条评论                   取反 --no-merge
    "adjacency": true,                  // 「续行必须相邻」守卫                                  取反 --no-adjacency
    "dedup": true,                      // 按滚动对齐跨帧去重出唯一评论表                        取反 --no-dedup
    // 关掉自标定：行距/相位/浮层界都已实测写死；自标定只在开头采 4 帧，
    //   开场系统提示卡会把样本带偏（与 09-09 / 08-08 同口径）。
    "calibrate": false,                 // 面板几何自标定（行距/浮层右界/续行；相位逐帧估）      取反 --no-calibrate
    // badge_reread 不写：account_key=nickname_level_if_masked ⇒ 自动打开（打码名要等级标）。
    "right_pad": 0,                     // ROI 右边界距面板右边的余量；0 = 贴面板边圈住框外表情    --right-pad
    "emoji_workers": 8                  // 表情扫描线程数；只影响速度、不改变结果
  },

  "output": {
    // 多段时这里是**段的父目录**：实际各写 <dir>/seg1、seg2；
    // 跨段产物落在这儿：merged_users.json（qualify）；交付树见 collect.out。
    "dir": "/run/media/puyu/C0DE6A4BDE6A39B4/out/2026-09-12艾瑞泽8CTCC职业联赛（上海站）（渠道七七）/抖音",
    "write": true,                      // 是否写盘（comments.jsonl + summary.json 成对）
    "rows": true,                       // 另存 rows.jsonl（**可回喂复算**）
    "panels": true,                     // mode=auto 时把定位结果存成 panels.json
    // frames：**抽样帧**一张图 frames/<t>_roi.jpg（≈0.55MB/张），不是每条评论一张。
    "frames": true,                     // 取反 --no-frames
    "print": false                      // 除写盘外也把评论打到 stdout                            --print
  },

  // 评论 → 合格用户：用户名 ≥min_positive 条**正面**评论（正面由大模型判定，表情也发），
  // 并排除用户名命中关键词的官方侧账号。**要花钱**；key **只走环境变量**（本项目铁律）。
  //
  // ⚠ 本件是**两段素材**，交付要求「该账号 ≥3 条正面」是**按两段合计**判的 ⇒
  //   这里 `min_positive: 1`（只出全量用户表），合格与否交给 `qualify` 步按合计判。
  "filter": {
    "enabled": true,                    // 打开才会调模型；只想抽评论就先 --skip filter
    "source": null,                     // 评论来源；null ⇒ <段目录>/comments.jsonl
    "out": null,                        // 合格用户 JSONL；null ⇒ <段目录>/users.jsonl
    "cache": null,                      // 判定缓存；null ⇒ 两段共用 <output.dir>/judgments.jsonl
    "min_positive": 1,                  // 单段阈值（**合计口径见上面 ⚠**；qualify 一开就自动取 stage_min）
    "exclude_keywords": [               // 用户名含任一即排除（不区分大小写）
      // ⚠ 沿用**奇瑞那条线**的表（品牌 + 4S + 车型 + 高管姓名）；CTCC 官方号 / 车队 /
      //   裁判 / 赞助商还没按本场补。填错的代价是把真观众挡在名单外 ⇒ 等名单出来再逐条加。
      "奇瑞", "4s", "店", "qq3", "汽车",
      "尹同跃", "张国忠", "鲍思语", "王津华", "王孝伟", "胡敬源", "尹祥领",
      "王来春", "李晶", "商文江", "杨棉之", "叶盛基", "路风", "黎汝雄",
      "李学用", "张贵兵", "代立宏", "章红玉", "高新华", "戚士龙", "王琅"
    ],
    "nlp": {
      "api_key": null,                  // **留 null**：key 只走环境变量（本项目铁律）
      "api_key_env": "NLP_API_KEY",     // ← 环境变量的**名字**（把 key 写到这行永远取不到）
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "deepseek-v4.1-flash",   // ⚠ 模型名会随平台改，写错就是 404（不是 key 的问题）
      "batch_size": 20,
      "concurrency": 4,
      "timeout": 60.0,
      "retries": 3,
      "limit": null,                    // 最多调多少批（控成本）
      "prompt": null                    // null ⇒ 用 user_filter.DEFAULT_PROMPT
    }
  },

  // -------------------------------------------------------------------------
  // 跨段的两步（顺序有依赖：filter（逐段）→ qualify（跨段）→ export（逐段）→ collect（拼树））
  // -------------------------------------------------------------------------

  // 跨段判合格（**全局步**）：把两段的 users.jsonl 按**账号合计**算正面条数，≥min_positive
  // 的才算合格，再把合格用户**回写**成每段的 users_qualified.jsonl 交给 export。
  "qualify": {
    "enabled": true,                    // 单段素材开着也无害（退化成「按本段判」）
    "min_positive": 3,                  // 交付阈值（**跨段合计**）—— 与 08-09CTCC 参考语料一致
    "stage_min": 1                      // 各段 filter/export 用的阈值（先出全量，合格留给这一步判）
  },

  // 逐段出交付图（**逐段步**）：读该段 users_qualified.jsonl，按**原帧**画绿框，一人一个目录
  // `<昵称>-<本段条数>`（跨段同名目录由 collect 并成一个）。
  "export": {
    "enabled": true,
    "base": "frame",                    // frame=原帧（参考语料形态）/ annotated=标注图      --base
    "labels": "正面",                   // 只出正面评论                                        --labels
    "min_positive": null,               // null ⇒ qualify.stage_min（合格已在 qualify 判完）
    "min_scope": "platform",            // 平台内各自够数；两段同一平台 ⇒ 等同于按合计         --min-scope
    "users": null,                      // null ⇒ <段目录>/users_qualified.jsonl
    "color": "0,255,0", "width": 3,     // 绿框（对齐参考语料）
    "pad": 0, "pad_ratio": 0.25, "quality": 90,
    "force": true                       // 重跑覆盖上一轮的导出目录
  },

  // 拼最终交付树（**全局步**）：把两段的导出目录按账号身份并成一个目录、图号 1..N
  // **跨段连续**，后缀取**合计**条数，顺带写 正面账号.txt + manifest.json。
  // out 显式写死：output.dir 已经带 `/抖音`，再让 collect 自动拼 `<平台目录>` 会变成
  // …/抖音/抖音/…。
  "collect": {
    "enabled": true,
    "stage_min": null,                  // 各段导出目录名里的数字；null ⇒ qualify.stage_min
    "platform_dir": null,               // 交付树里的平台目录名；null ⇒ 从各段导出目录自动认（抖音）
    "out": "/run/media/puyu/C0DE6A4BDE6A39B4/out/2026-09-12艾瑞泽8CTCC职业联赛（上海站）（渠道七七）/抖音/all_users_正面_3张以上",
    "force": true                       // 目标非空时整棵重来（否则报错退出）
  },

  "draw": {                             // 独立描框步骤（draw_boxes.py）；核心解析已自带逐帧标注图，默认关
    "enabled": true,
    "source": null,
    "at": 8.0,
    "window": 5.0,
    "out": null,
    "width": 5,
    "quality": 90,
    "labels": true
  },

  "steps": {
    // 顺序**不能乱**：filter（逐段）→ qualify（跨段判合格）→ export（逐段）→ collect（拼树）。
    // 逐段步（panels/parse/filter/export/draw）两段各跑一遍；全局步（emoji_tables/qualify/collect）整批一次。
    "order": ["emoji_tables", "panels", "parse", "filter", "qualify",
              "export", "collect", "draw"],
    "skip": ["emoji_tables", "draw"]    // 表情表已建好（/run/media/puyu/C0DE6A4BDE6A39B4/out/douyin_emoji/）；独立描框用不上
  }
}
