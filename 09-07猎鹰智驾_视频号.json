// （手机 App 竖屏 592×1280）→ 结构化评论
//
// 素材 = 「/home/puyu/work/data/2026-09-07猎鹰智驾瑞虎9羌塘无人区（渠道）/视频号/」
// 下的**五段**录屏（第六个文件只取直播中的部分，见下）（账号「奇瑞汽车」）：
//   上午场 `9.7视频号丨奇瑞汽车丨9：00-11：56/`
//     seg1  `09：06-10：00.mp4`  54.1min
//     seg2  `10：00-11：00.mp4`  60.5min
//     seg3  `11：00-11：55.mp4`  56.6min
//   下午场 `9.7视频号丨奇瑞汽车丨16：27-19：00/`
//     seg4  `16：27-17：41.mp4`  75.1min
//     seg5  `17：42-18：49.mp4`  67.0min
//     seg6  `18：49-19：00.mp4`  ⚠ 原文件 65.8min，但直播在 **737s（约 19:01）结束**，
//           之后 ~53min 全是「直播已结束」推荐页（和小米 SU7 广告卡，OCR 会读成匿名
//           评论）。已用 ffmpeg **无损流拷贝**只保留直播段：
//             ffmpeg -i <原文件> -t 738 -c copy <副本>
//           副本：out/2026-09-07猎鹰智驾瑞虎9羌塘无人区（渠道）/media/
//                 wx_eve_18-49-19-00_live.mp4（12.3min，正立 592×1280）
//   六段一次配全（input.videos 显式数组 = 时间顺序）。每段在 output.dir 下开一个
//   子目录（seg1..seg6），逐段步各跑一遍、跨段步（qualify/collect）整批跑一次。
//   管线本身串行循环（这台机器并行 OCR 会 OOM）。
//
// 行版式：`[✦N 等级药丸] [粉丝药丸] 昵称：正文`（与 09-06 视频号同版式/同分辨率）。
//   · ✦N 画在昵称左边、独占徽章列；OCR 常把它读成 `+1` / `+.13` 或并进正文 ⇒ badge_alias。
//   · 行首还有**「粉丝」文字药丸**（实测 `粉丝` 块 x1≈26~27）⇒ fan_badge_x_max=32 +
//     fan_badge_with_level。
//   · 本批昵称基本不打码（`六月的雨` / `小兔子乖乖`；打码名 `一个诚实的老...` 个别）
//     ⇒ 与 09-05/09-06 猎鹰三平台一致：account_key=username。
//   · 评论列表顶部会压「通知卡 / 主题卡 / 公众号卡」，按 skip_phrases + overlay_cards 吃掉。
//   · 下午场右侧有**广告/商品卡**（`环球极智行` / `北京-上海` / `闪充一次` /
//     `1.1万` 等），卡块 x1≥352 ⇒ x_ignore_from=350 把右侧整块丢掉；评论正文块都
//     从左边起（x1≈24~75），不会被误伤。
//   · 主播打开输入框时会出现「闪光语录」面板，评论列表会整体上移到视频上方（y<650）；
//     固定 rect 接不到这类帧，评论在输入框收起后会重新滚下来被拍到。
//
// 这块素材量到的（2026-11-09，每文件 4 帧，592×1280）：
//   ✅ 行距 **41.5**（相邻评论首行中心差众数 42.0 / 41.5 / 41.0；与 09-06 同网格）
//   ✅ 首行中心 ≈757（rect y1=740 ⇒ 相位 ~17；逐帧还会重估）
//   ✅ x_text **34**（徽章列右沿）：无药丸昵称块 x1∈[34,39]、续行 x1∈[21,35]、
//      ✦N 药丸块 x∈[21,28]、`粉丝` 药丸块 x1∈[26,27]
//   ✅ 续行是**缩进**的（x1=21~35，比首行还靠左）⇒ 必须开 wrap_indent
//   ✅ 续行间距 ~25.5px = **0.61 行距**；独立评论/通知行实测 0.95~1.0 ⇒ wrap_gap_ratio 0.85
//   ✅ rect：视频区/评论区分界实测 **657**；y1=740 跳过顶部通知/主题卡（它们会切到
//      y≈730）；输入栏 `聊一聊` 上沿 1140 ⇒ rect y2=1128
//   ✅ 评论文字右沿最大 422（含 `[2条]` 标记）⇒ x2_from=window（rect x2=592 超集）
//   ✅ 表情用内置 wechat 表（out/wechat_emoji/wechat-emoji.json，已建好）
//
// 跑法（OCR 要带 rapidocr 的解释器）：
//   P=/home/puyu/anaconda3/envs/vlx/bin/python
//   ① 抽行（慢；六段合计约 5.4h 录屏）：
//        export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
//        $P -m livepipe run 09-07猎鹰智驾_视频号.json --only panels,parse
//        ⚠ 中断了直接重跑同一条命令：<段目录>/rows.jsonl 已在 ⇒ 自动零 OCR 复算/续跑。
//   ② 筛 + 判合格 + 出图 + 拼交付树（**要 key**，只走环境变量）：
//        NLP_API_KEY=sk-xxxx $P -m livepipe run 09-07猎鹰智驾_视频号.json \
//            --only filter,qualify,export,collect
//   ③ 先看后交：产物在
//        out/2026-09-07猎鹰智驾瑞虎9羌塘无人区（渠道）/视频号/all_users_正面_3张以上/
//
// 校验（不跑、安全）：
//   python3 -m livepipe check 09-07猎鹰智驾_视频号.json
//   python3 -m livepipe run   09-07猎鹰智驾_视频号.json --dry-run
// ============================================================================
{
  "version": 1,
  "name": "猎鹰智驾瑞虎9羌塘无人区（渠道）2026-09-07 · 视频号手机 App · 竖屏",

  // -------------------------------------------------------------------------
  // 平台档案：六段同一台设备、同一版 App（592×1280）⇒ 一套数字共用。
  // -------------------------------------------------------------------------
  "platforms": {
    "wechat_app": {
      "label": "视频号直播（手机 App 竖屏；等级标 ✦N 在昵称左边，行首还可能有「粉丝」药丸）",
      "emoji": "wechat",                // → emoji.tables 的 wechat 表（内置，表已建好）

      // 交付认人口径：本批昵称基本不打码 ⇒ 只看昵称。
      //   见 CONFIG.md 的 `account_key` 小节。
      "account_key": "username",

      // 行距（像素）—— **实测**（2026-11-09，每文件 4 帧）：单行评论首行中心差
      //   众数 42.0 / 41.5 / 41.0，取 41.5（与 09-06 同网格）。
      "row_pitch": 41.5,

      // 首行中心距面板顶（裁剪内坐标）—— 实测首行中心 ≈757（rect y1=740 ⇒ 相位 ~17）；
      //   逐帧由 estimate_phase 重估，这个只兜底。
      "y_phase": 17,

      // 正文列左沿（徽章列右沿，**裁剪内**坐标）—— **实测**：
      //   无药丸昵称块 x1∈[34,39] · 续行 x1∈[21,35] · ✦N 药丸块 x∈[21,28]。
      //   取 **34**（小于真昵称最小左沿 35）。
      "x_text": 34,

      // 徽章列宽（ROI 左沿 = x_text − badge_span）—— 34−44 = −10 ⇒ ROI 左沿夹到面板左沿。
      "badge_span": 44,

      // 裁切右沿：**取窗口右沿**（App 评论列表满宽、不随内容伸缩）——超集，按构造不裁内容。
      "x2_from": "window",

      // 折行续行：视频号的续行**贴左沿**（x1=21~35），而本档案 x_text=34 ⇒
      //   必须显式开 wrap_indent（与 09-05 / 09-06 同口径）。
      "wrap_indent": true,

      // 续行间距比上限 —— 实测续行在首行下方 ~25.5px = **0.61 行距**；
      //   独立评论/通知行实测 0.95~1.0。取 0.85 夹在两簇中间。
      "wrap_gap_ratio": 0.85,

      // 行首「粉丝」药丸**被 OCR 并进正文**时的几何闸（`粉丝` 两个字既不是数字也不是
      //   标点，不剥就把真昵称啃掉头两个字）。
      //   **实测**：粉丝块 x1∈[26,27]、真昵称（无药丸）x1∈[34,39] ⇒ 取 **32**。
      "fan_badge_x_max": 32,

      // 「✦N 等级药丸 + 粉丝药丸」一起并进正文（`+1粉丝…`）时，允许行首再带一个等级前缀。
      "fan_badge_with_level": true,

      // 行首等级药丸被 OCR 并进正文（`+1六月的雨` / `+.13橙子君`）
      //   ⇒ 同一人被读成好几个账号，按几何见证归一（详见 CONFIG.md 的同名小节）。
      "badge_alias": true,

      // 昵称末尾被检测框切掉 1~2px（或整个末字漏读）⇒ 同一个人被拆成两个账号，
      //   按「同一条评论的两种读法同现」归一（见 normalize_username_alias）。
      "username_alias": true,

      // 右侧广告/商品卡的左界（裁剪内 x）—— **实测**下午场卡块 `环球极智行` / `北京-上海`
      //   / `1.1万` 最小左沿 352；评论正文块 x1 都 ≤75 ⇒ 空带取 **350**。
      //   上午场没有卡（实测无 x1≥350 的块），这条对它无害。
      "x_ignore_from": 350,

      // 冒号像素检测阈值（见 parsing/ocr/colon.py）：视频号气泡半透明、底偏亮，
      //   默认 bg_max_v=110 会整类短路 ⇒ 放开背景亮度、把亮度差降到 30。
      "colon_bg_max_v": 255,
      "colon_v_delta": 30,
      // 冒号的**绝对亮度下限**（默认 100 太高）：灰色冒号下点被重采样时 V 会掉到 78~86。
      "colon_v_min": 80,

      // OCR 把冒号吃掉时，按像素位置补回文本；打码昵称单星号形态也放行。
      "colon_text_fix": true,
      "colon_text_fix_masked_only": true,

      // 评论列表上的浮层卡 / 通知（**只作用于没有冒号的行**）：
      //   内置反诈提示被 OCR 切成多行（只认「欢迎来到直播间」首行接不住后续行）
      //   ⇒ 按本素材实测短语补：`直播间内禁` / `主播诱导` / `私下交易` 等；
      //   卡片标签 `通知` / `主题` / `公众号`；右侧分享图标 `口` / `》口`；点赞 `++`；
      //   直播结束后推荐页的 `直播已结束` / `推荐直播` / `前往直播广场`（seg6 已裁掉，
      //   这里只留兜底）。
      "overlay_cards": "欢迎来到直播间|直播间内禁|未成年人打赏|诱导主播|主播诱导|诱导观|私下交易|违法违规|色情低俗|抽烟喝酒|理性消费|人身损失|及时投诉|吸烟酗酒|低俗色情|人身财产损失|严禁未成年人|诱导打赏|^通知$|^主题$|^公众号$|^口$|^》口$|^\\+\\+$|推荐了直播|直播已结束|推荐直播|前往直播广场|^互动$|^[A-Za-z0-9@#%&+=×?·._\\-/]{1,16}$",

      // 整行**完全等于**这些词就丢（忽略空白）。只认整行，真评论（`小王：…`）不受影响。
      //   典型：公众号卡（OCR 只剩 `奇瑞汽车` / `奇瑞汽车>`）、主题卡两行、分享图标。
      "skip_phrases": [
        "奇瑞汽车",
        "奇瑞汽车>",
        "公众号奇瑞汽车",
        "奇瑞猎鹰驾驶智行中国",
        "新公路之王-瑞虎9 勇闯羌塘无人区",
        "口",
        "》口",
        "直播已结束",
        "推荐直播",
        "前往直播广场"
      ]
    }
  },

  // 表情表用内置的 `wechat`（out/wechat_emoji/wechat-emoji.json）
  // ⇒ 这里一个字段都不用写：emoji.tables 的默认值就是它，emoji.enabled 默认 true。

  "input": {
    // 六段素材：**显式数组**（段顺序 = 时间顺序）。
    //   seg6 用裁掉「直播已结束」推荐页的副本（见文件头 ⚠）。
    "videos": [
      "/home/puyu/work/data/2026-09-07猎鹰智驾瑞虎9羌塘无人区（渠道）/视频号/9.7视频号丨奇瑞汽车丨9：00-11：56/09：06-10：00.mp4",
      "/home/puyu/work/data/2026-09-07猎鹰智驾瑞虎9羌塘无人区（渠道）/视频号/9.7视频号丨奇瑞汽车丨9：00-11：56/10：00-11：00.mp4",
      "/home/puyu/work/data/2026-09-07猎鹰智驾瑞虎9羌塘无人区（渠道）/视频号/9.7视频号丨奇瑞汽车丨9：00-11：56/11：00-11：55.mp4",
      "/home/puyu/work/data/2026-09-07猎鹰智驾瑞虎9羌塘无人区（渠道）/视频号/9.7视频号丨奇瑞汽车丨16：27-19：00/16：27-17：41.mp4",
      "/home/puyu/work/data/2026-09-07猎鹰智驾瑞虎9羌塘无人区（渠道）/视频号/9.7视频号丨奇瑞汽车丨16：27-19：00/17：42-18：49.mp4",
      "out/2026-09-07猎鹰智驾瑞虎9羌塘无人区（渠道）/media/wx_eve_18-49-19-00_live.mp4"
    ],
    "segment_names": null,              // 段名（= 子目录名）；null ⇒ seg1..seg6
    "video": null,                      // 单段写法（与 videos 互斥，本件用不到）              --video
    "rows": null,                       // 单段复算用；多段不用写（<段目录>/rows.jsonl 在就自动复算）
    "text": null,                       // 纯文本行文件；"-" 读 stdin                            --text
    "start": 0.0,                       // 起始时间（秒）                                      --start
    "duration": null,                   // 处理多长（秒）；null = 整段                          --duration
    "interval": 2.0,                    // 固定间隔抽样用（本件用 adaptive，此项不生效）          --interval
    "max_frames": null,                 // 最多抽几帧；null = 不限                              --max-frames
    "resume": true,                     // 断点续跑：rows.jsonl 已在就接着它跑（已处理帧跳过）   --resume

    // 抽帧策略：手机 App 是平滑滚动 ⇒ 长录屏用 adaptive（静止段几乎不拍、滚动段不漏条）。
    "sample": {
      "mode": "adaptive",               //   interval / backoff / adaptive                     --sample-mode
      "stride": 2,                      //   每 N 个解码帧估一次位移（1 = 每帧都估）
      "safety_rows": 5.0,               //   累计位移 ≥ 这么多行 ⇒ 强制拍（上限 5）
      "settle_frames": 3,               //   动过之后静止这么多帧 ⇒ 拍一次
      "eps_px": 1.0,                    //   位移小于它算「没动」
      "entry_thr": 8.0,                 //   底部入口行变化多少像素算「新评论弹进来」
      "max_gap_s": 5.0,                 //   最长多久必须拍一次（0 = 不限）
      "min_interval": 0.2,              //   两次拍摄的最小间隔（秒）
      "max_interval": 6.0,              //   两次拍摄的最大间隔（秒）
      "min_score": 0.3                  //   位移估计的匹配分下限
    }
  },

  // -------------------------------------------------------------------------
  // 面板：**手写**（评论列表位置已量好，不需要再跑模型定位）。
  // rect 是**原图像素**的评论区窗口：[x1, y1, x2, y2]
  //   · y1=740：视频区/评论区分界实测 657；顶部通知卡/主题卡切到 y≈730，y1 抬到
  //     卡片之下（首个完整评论框顶 ≈743）；
  //   · y2=1128：输入栏 `聊一聊` 上沿实测 1140，切在它之上；
  //   · x1=0 / x2=592：列表满宽（x2_from=window）。
  //   · 六段同一台设备、同一版 App（592×1280）⇒ 共用一套 rect。
  // -------------------------------------------------------------------------
  "panels": {
    "mode": "manual",                   // manual=手写面板直接写进 file（交付走 manual）
    "file": null,                       // null ⇒ 每段各一个 <段目录>/panels.json（多段）
    "files": null,                      // 也可显式一份一段地列出面板文件路径（顺序 = 段顺序）
    "overwrite": false,                 // manual：配置与面板文件不一致就按配置重写
    "auto": {                           // 自动定位参数（mode=locate/auto/batch 时用；本件用不到）
      "method": "hybrid",
      "at": 900,
      "frames": 5,
      "span": null,
      "split_x": null,                  //   ⚠ null = **不切分**（竖屏单直播间是一列评论）
      "pad_x": 60,
      "pad_top": 80,
      "pad_y": 16,
      "sub_width": 500,                 //   ⚠ 竖屏整帧裁切必须降下来，否则 4bit 模型 CUDA OOM
      "model": "nvidia/LocateAnything-3B",
      "quant": "4bit",
      "device": "cuda",
      "platforms": {                    //   只在 mode=auto/builtin/batch 时用
        "left": "wechat_app",           //   不切分后唯一的窗口叫 left
        "right": null
      },
      "frame_width": 592
    },
    // mode=manual：手写面板，**一段一项**（顺序与 input.videos 的段顺序一致）。
    "manual": [
      {                                //   seg1  `09：06-10：00.mp4`  592×1280
        "comments": {"rect": [0, 740, 592, 1128], "platform": "wechat_app"}
      },
      {                                //   seg2  `10：00-11：00.mp4`  592×1280
        "comments": {"rect": [0, 740, 592, 1128], "platform": "wechat_app"}
      },
      {                                //   seg3  `11：00-11：55.mp4`  592×1280
        "comments": {"rect": [0, 740, 592, 1128], "platform": "wechat_app"}
      },
      {                                //   seg4  `16：27-17：41.mp4`  592×1280
        "comments": {"rect": [0, 740, 592, 1128], "platform": "wechat_app"}
      },
      {                                //   seg5  `17：42-18：49.mp4`  592×1280
        "comments": {"rect": [0, 740, 592, 1128], "platform": "wechat_app"}
      },
      {                                //   seg6  裁掉推荐页的副本（原 18：49-19：00）592×1280
        "comments": {"rect": [0, 740, 592, 1128], "platform": "wechat_app"}
      }
    ],
    "batch": {                          // mode=batch：稳定性研究（挑固定矩形用；不动 file）
      "count": 30,
      "start": 0.0,
      "span": 600.0,
      "anchor": "panel"
    }
  },

  "parse": {
    "sep": " ",                         // 续行拼接用的分隔符                                      --sep
    "max_username_len": 24,             // 冒号前超过这个长度就不当用户名                          --max-username-len
    "merge_continuation": true,         // 是否把「无用户名的行」并进上一条评论                   取反 --no-merge
    "adjacency": true,                  // 「续行必须相邻」守卫                                  取反 --no-adjacency
    "dedup": true,                      // 按滚动对齐跨帧去重出唯一评论表                        取反 --no-dedup
    // 关掉自标定：行距/相位/续行开关都已实测写死；自标定只在开头采 4 帧，
    //   本素材开场有整屏通知卡，样本会被带偏（与 10-31 / 风云A9L 视频号同口径）。
    "calibrate": false,                 // 面板几何自标定（行距/浮层右界/续行；相位逐帧估）      取反 --no-calibrate
    "right_pad": 0,                     // ROI 右边界距面板右边的余量；0 = 贴面板边圈住框外表情    --right-pad
    "emoji_workers": 8                  // 表情扫描线程数；只影响速度、不改变结果
  },

  "output": {
    // 多段时这里是**段的父目录**：实际各写 <dir>/seg1..seg6；
    // 跨段产物落在这儿：merged_users.json（qualify）；交付树见 collect.out。
    "dir": "out/2026-09-07猎鹰智驾瑞虎9羌塘无人区（渠道）/视频号",
    "write": true,                      // 是否写盘（comments.jsonl + summary.json 成对）
    "rows": true,                       // 另存 rows.jsonl（**可回喂复算**）
    "panels": true,                     // mode=auto 时把定位结果存成 panels.json
    // frames：**抽样帧**一张图 frames/<t>_roi.jpg（≈0.55MB/张），不是每条评论一张。
    "frames": true,                     // 取反 --no-frames
    "print": false                      // 除写盘外也把评论打到 stdout                            --print
  },

  // 评论 → 合格用户：用户名 ≥min_positive 条**正面**评论（正面由大模型判定，表情也发），
  // 并排除用户名命中关键词的官方侧账号。**要花钱**；key **只走环境变量**（本项目铁律）。
  //
  // ⚠ 本件是**六段素材**，交付要求「该账号 ≥3 条正面」是**按六段合计**判的 ⇒
  //   这里 `min_positive: 1`（只出全量用户表），合格与否交给 `qualify` 步按合计判。
  "filter": {
    "enabled": true,                    // 打开才会调模型；只想抽评论就先 --skip filter
    "source": null,                     // 评论来源；null ⇒ <段目录>/comments.jsonl
    "out": null,                        // 合格用户 JSONL；null ⇒ <段目录>/users.jsonl
    "cache": null,                      // 判定缓存；null ⇒ 六段共用 <output.dir>/judgments.jsonl
    "min_positive": 1,                  // 单段阈值（**合计口径见上面 ⚠**；qualify 一开就自动取 stage_min）
    "exclude_keywords": [               // 用户名含任一即排除（不区分大小写）
      // ⚠ 沿用**奇瑞那条线**的表（品牌 + 4S + 车型 + 高管姓名）；本场官方号 / 主播 /
      //   试驾员还没按本场补。填错的代价是把真观众挡在名单外 ⇒ 等名单出来再逐条加。
      "奇瑞", "4s", "店", "qq3", "汽车",
      "尹同跃", "张国忠", "鲍思语", "王津华", "王孝伟", "胡敬源", "尹祥领",
      "王来春", "李晶", "商文江", "杨棉之", "叶盛基", "路风", "黎汝雄",
      "李学用", "张贵兵", "代立宏", "章红玉", "高新华", "戚士龙", "王琅"
    ],
    "nlp": {
      "api_key": null,                  // **留 null**：key 只走环境变量（本项目铁律）
      "api_key_env": "NLP_API_KEY",     // ← 环境变量的**名字**（把 key 写到这行永远取不到）
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "deepseek-v4.1-flash",   // ⚠ 模型名会随平台改，写错就是 404（不是 key 的问题）
      "batch_size": 20,
      "concurrency": 4,
      "timeout": 60.0,
      "retries": 3,
      "limit": null,                    // 最多调多少批（控成本）
      "prompt": null                    // null ⇒ 用 user_filter.DEFAULT_PROMPT
    }
  },

  // -------------------------------------------------------------------------
  // 跨段的两步（顺序有依赖：filter（逐段）→ qualify（跨段）→ export（逐段）→ collect（拼树））
  // -------------------------------------------------------------------------

  // 跨段判合格（**全局步**）：把六段的 users.jsonl 按**账号合计**算正面条数，≥min_positive
  // 的才算合格，再把合格用户**回写**成每段的 users_qualified.jsonl 交给 export。
  "qualify": {
    "enabled": true,                    // 单段素材开着也无害（退化成「按本段判」）
    "min_positive": 3,                  // 交付阈值（**跨段合计**）—— 与 08-09CTCC 参考语料一致
    "stage_min": 1                      // 各段 filter/export 用的阈值（先出全量，合格留给这一步判）
  },

  // 逐段出交付图（**逐段步**）：读该段 users_qualified.jsonl，按**原帧**画绿框，一人一个目录
  // `<昵称>-<本段条数>`（跨段同名目录由 collect 并成一个）。
  "export": {
    "enabled": true,
    "base": "frame",                    // frame=原帧（参考语料形态）/ annotated=标注图      --base
    "labels": "正面",                   // 只出正面评论                                        --labels
    "min_positive": null,               // null ⇒ qualify.stage_min（合格已在 qualify 判完）
    "min_scope": "platform",            // 平台内各自够数；六段同一平台 ⇒ 等同于按合计         --min-scope
    "users": null,                      // null ⇒ <段目录>/users_qualified.jsonl
    "color": "0,255,0", "width": 3,     // 绿框（对齐参考语料）
    "pad": 0, "pad_ratio": 0.25, "quality": 90,
    "force": true                       // 重跑覆盖上一轮的导出目录
  },

  // 拼最终交付树（**全局步**）：把六段的导出目录按账号身份并成一个目录、图号 1..N
  // **跨段连续**，后缀取**合计**条数，顺带写 正面账号.txt + manifest.json。
  // out 显式写死：output.dir 已经带 `/视频号`，再让 collect 自动拼 `<平台目录>` 会变成
  // …/视频号/视频号/…。
  "collect": {
    "enabled": true,
    "stage_min": null,                  // 各段导出目录名里的数字；null ⇒ qualify.stage_min
    "platform_dir": null,               // 交付树里的平台目录名；null ⇒ 从各段导出目录自动认（视频号）
    "out": "out/2026-09-07猎鹰智驾瑞虎9羌塘无人区（渠道）/视频号/all_users_正面_3张以上",
    "force": true                       // 目标非空时整棵重来（否则报错退出）
  },

  "draw": {                             // 独立描框步骤（draw_boxes.py）；核心解析已自带逐帧标注图，默认关
    "enabled": true,
    "source": null,
    "at": 8.0,
    "window": 5.0,
    "out": null,
    "width": 5,
    "quality": 90,
    "labels": true
  },

  "steps": {
    // 顺序**不能乱**：filter（逐段）→ qualify（跨段判合格）→ export（逐段）→ collect（拼树）。
    // 逐段步（panels/parse/filter/export/draw）六段各跑一遍；全局步（emoji_tables/qualify/collect）整批一次。
    "order": ["emoji_tables", "panels", "parse", "filter", "qualify",
              "export", "collect", "draw"],
    "skip": ["emoji_tables", "draw"]    // 表情表已建好（out/wechat_emoji/）；独立描框用不上
  }
}
