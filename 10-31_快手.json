// ============================================================================
// 奇瑞「电感智行·大美中国 48小时周末出游计划」2026-10-31 · 快手直播
// （手机 App 竖屏 590×1280）→ 结构化评论
//
// 素材 = 「/run/media/puyu/A1B7-2982/10.31」快手/ 下的**三段**录屏
// （同一场直播、时间**不重叠**，都是奇瑞汽车官方号）：
//   seg1  `16： 00-17： 40.mp4`  100.3min
//   seg2  `17： 41-19： 28.mp4`  107.3min
//   seg3  `19： 28-21： 08.mp4`  100.2min
//   三段一次配全（input.videos 显式数组 = 时间顺序），每段在 output.dir 下开一个
//   子目录（seg1/seg2/seg3），逐段步各跑一遍、跨段步（qualify/collect）整批跑一次。
//   管线本身串行循环（这台机器并行 OCR 会 OOM）。
//
// 行版式（快手 App，590×1280；与抖音/视频号都不同）：
//   `[✦N 粉丝团等级] [粉丝团] [榜N 观众榜] 昵称：正文`
//   · 药丸簇**内联**在行首：粉丝团等级数字 ≈x44~75、`粉丝团` 文字药丸 ≈x78~147、
//     观众榜 `榜N`（粉）≈x169~220；**没有**固定的左侧徽章列 —— 没药丸的评论
//     昵称直接从 x≈34~42 起，带药丸的昵称被顶到 x≈107（只带榜N）或 x≈238（三连药丸）。
//     ⚠ 所以 x_text 不能按「徽章列右沿」理解：取 **105** 只用来丢**纯药丸碎片**
//     （无冒号、纯数字的等级块、`粉丝团`），真评论（带冒号）无论 x1 多大都保留；
//     `榜N` 块落在 x_text 右边，交给 overlay_cards 的 `^榜\s*\d+$` 丢。
//   · 系统行：`恭喜X成为在线观众榜前N` / `X 加入，来自 关注/推广` / `X送出N个人气票` /
//     `X 点亮粉丝团` —— 内置通知短语 + 本档案的 overlay_cards 补。
//   · 昵称**没有打码**（`噜闪闪` / `烟比女好只伤肺不伤心`），认人只用昵称。
//   · 底部会压「打卡领亲密值 / 倒计时 / 1快币」任务卡（y≈1126~1174）——
//     块左沿 <105 的被徽章闸丢掉，右边 `打卡`/`1快币` 由 overlay_cards 短语丢。
//
// 这块素材量到的（2026-11-05，seg1 六帧，590×1280）：
//   ✅ 行距 60.0（相邻评论**首行**中心差：单行气泡 59~61、两行气泡 105～106.5
//      ⇒ 60 = 行高 45 + 气泡间距 15；折行续行在首行下方 ~45px = **0.75 行距**）
//      ⚠ 快手的气泡高度随折行数变，**没有**严格等距的行网格；60 是让「单行/两行气泡
//      首行」都落在槽位容差（±0.5 行距）内的最优值（22X/25Y 的间距也都落在容差内）。
//   ✅ wrap_gap_ratio 0.80：续行间距实测 45/60 = 0.75，默认 0.73 差一点会整类丢续行；
//      上沿 0.80 仍能把「占满一个行距」的左对齐系统横幅（1.0~1.3）挡在外面。
//   ✅ 相位 10（首行中心 ≈695~710，rect y1=640 ⇒ 55~70；兜底值，逐帧估）
//   ✅ x_text 105：纯等级数字块 x∈[44,75]、`粉丝团` x∈[78,147] 落在它左边被丢；
//      真昵称 x1≥107（榜N 行）/238（三连药丸行）/34~42（无药丸行）都保留（冒号闸）。
//   ✅ rect [0,640,590,1185]：y1=640 在最早一条评论（y≈653）之上、直播画面底沿之下；
//      y2=1185 在输入栏 `说点什么…`（实测 1217~1251）之上；列表满宽 ⇒ x2_from=window
//   ✅ 表情表：快手官方 207 个（out/kuaishou_emoji/kuaishou-emoji.json，已建好；
//      来源 live.kuaishou.com 的 emojiPanel，`livepipe/kuaishou_emoji_table.py` 建表）。
//      渲染高 30px / 行距 60 ⇒ 表情高比按表里的实测值走（Build 时已写）。
//   ⚠ 已知残留（与 08-08CTCC 快手同款）：药丸簇被 OCR 并进昵称的读法会污染用户名
//      （例如 `13粉丝团榜1烟比女好只伤肺不伤心` 里的药丸被读成昵称前缀）——快手的药丸
//      **没有左侧徽章列**可丢，也没有通用文本判据；交付时留意名单里的这类名字。
//
// 跑法（OCR 要带 rapidocr 的解释器）：
//   P=/home/puyu/anaconda3/envs/vlx/bin/python
//   ① 抽行（慢；三段合计约 5.1h 录屏）：
//        export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
//        $P -m livepipe run 10-31_快手.json --only panels,parse
//        ⚠ 中断了直接重跑同一条命令：<段目录>/rows.jsonl 已在 ⇒ 自动零 OCR 复算/续跑。
//   ② 筛 + 判合格 + 出图 + 拼交付树（**要 key**，只走环境变量）：
//        NLP_API_KEY=sk-xxxx $P -m livepipe run 10-31_快手.json \
//            --only filter,qualify,export,collect
//   ③ 先看后交：产物在
//        out/10.31/快手/all_users_正面_3张以上/
//
// 校验（不跑、安全）：
//   python3 -m livepipe check 10-31_快手.json
//   python3 -m livepipe run   10-31_快手.json --dry-run
// ============================================================================
{
  "version": 1,
  "name": "奇瑞电感智行·大美中国 2026-10-31 · 快手手机 App · 竖屏",

  // -------------------------------------------------------------------------
  // 平台档案：面板文件里只填平台名。`kuaishou` 是 2026-11-02 新增的档案
  // （以前只有导出层的平台名映射，没有解析用的行网格）—— 数字全部在本素材上量过。
  // -------------------------------------------------------------------------
  "platforms": {
    "kuaishou": {
      "label": "快手直播（手机 App 竖屏；行首药丸簇内联，无固定徽章列）",
      "emoji": "kuaishou",              // → emoji.tables 的 kuaishou 表（207 个官方表情）

      // 行距（像素）—— **实测**（2026-11-05，seg1 六帧）：单行气泡首行间距 59~61、
      //   两行气泡 105~106.5（= 2×45 + 15）⇒ 取 60：折行续行落在首行下方 ~45px
      //   （0.75 行距），由 wrap_gap_ratio 认。
      "row_pitch": 60.0,

      // 续行间距比上限 —— **实测** 45/60 = 0.75；默认 0.73 会把整类续行挡在门外。
      //   上沿仍远小于 1.0，占满一个行距的左对齐系统横幅照旧被挡掉。
      "wrap_gap_ratio": 0.80,

      // 首行中心距面板顶（裁剪内坐标）—— 实测相位落在 10 附近（首行中心 ≈695~710，
      //   rect y1=640 ⇒ 55~70）；逐帧估不准时兜底。
      "y_phase": 10,

      // 昵称**末尾**被检测框切掉 1~2px（或整个末字漏读）⇒ 同一人被拆成两个账号，
      //   按「同一条评论的两种读法同现」归一（normalize_username_alias，详见 CONFIG.md）。
      //   快手的昵称末尾常带等级/粉丝团字样，截断会落在最后一个字上。
      "username_alias": true,

      // 正文列左沿（裁剪内）—— **实测**：纯等级数字块 x∈[44,75]、`粉丝团` 文字药丸
      //   x∈[78,147]、真昵称 x1≥107（榜N 行）/238（三连药丸行）、无药丸昵称 x≈34~42。
      //   取 **105**：只让无冒号的纯药丸碎块落进「徽章列」被丢；带冒号的评论无论
      //   x1 多大都保留。`榜N` 块（x1≈169~220）落在右边，由 overlay_cards 丢。
      "x_text": 105,

      // ROI 左沿（标注图/交付裁图圈的那一圈）—— 惯用徽章列宽；快手药丸簇最左 ~44，
      //   105−74 = 31 能把整簇圈进去。
      "badge_span": 74,

      // 裁切右沿：**取窗口右沿**（App 评论列表满宽、不随内容伸缩）。
      "x2_from": "window",

      // 评论列表上的浮层卡 / 系统行（只作用于**没有冒号**的行）：
      //   `恭喜X成为在线观众榜前N` / `X 送出粉丝团灯牌` 已被内置通知短语收走；
      //   这里补本素材实测到的几类（2026-11-04/05，08-08CTCC + 本场复核）：
      //   · 进房行「X 加入」(整行以「加入」收尾) · 「点亮了」· 「X 点亮粉丝团」；
      //   · 送礼浮层卡：`抓住机会…` / `1快币` / `立刻送出…` / `x30` / `人气票` /
      //     `免费票次日…`（卡片盖住评论列表时这些字会被当匿名评论）；
      //   · 系统行右侧按钮块：`送票助我上榜吧去助力` / `去助力` / `去点赞`；
      //   · 赞助商横幅/主页卡：`CHERY…`；
      //   · **本场新增**：观众榜药丸 `榜N`（落在 x_text 右边，几何闸丢不掉）·
      //     `粉丝团` 文字药丸 · `送出N个人气票` 系统通知 · 底部任务卡
      //     （`打卡领亲密值` / `倒计时00：57` / `打卡` / `1快币`）·
      //     顶部榜单卡残句（`风云榜单` / `距离上日榜还需…`）·
      //     被折行切开的进房通知碎片（`加入，来` / `来自 关注` / `加入来`）——
      //     内置短语要求整句「X 加入，来自 关注」，切块后匹配不上，会漏成匿名行
      //     （2026-11-05 试跑实测 `加入来` / `加入，来…` / `来自关注` 三条）。
      "overlay_cards": "加入\\s*$|点亮了|点亮粉丝团|送票助我上榜吧|去助力\\s*$|去点赞\\s*$|抓住机会|快币|免费票次日|^人气票$|^[xX×]\\s*\\d+$|成为在线|^CHERY|^榜\\s*\\d+$|^粉丝团$|送出\\d+个人气票|打卡|亲密值|倒计时|风云榜单|距离上日榜|加入[，,]?来|来自\\s*(关注|推广)",

      // 带冒号的系统行：浮层判据只认无冒号行，拦不住「昵称：正文」形状的 UI 通知。
      //   本场未实测到同类残句（08-08CTCC 的 `主播拍了拍我的头像：美呆了！` 不在本素材）；
      //   换素材后若出现同类，按整行加到这里。
      "skip_phrases": [],

      // 冒号像素检测阈值（见 parsing/ocr/colon.py）：快手气泡是深底白字，
      //   默认阈值本来就能工作；这里与同批配置保持同一口径（不影响暗底）。
      "colon_bg_max_v": 255,
      "colon_v_delta": 30,

      // OCR 把冒号吃掉时，按像素位置补回文本。
      "colon_text_fix": true
    }
  },

  // 表情：快手官方表情表（207 个），来源 live.kuaishou.com 页面内嵌的 emojiPanel。
  //   表已建好（out/kuaishou_emoji/kuaishou-emoji.json）；`emoji_tables` 步在 steps.skip 里，
  //   换机器时把它移出 skip 即可自动建表（约 1MB 图）。
  "emoji": {
    "enabled": true,
    "tables": {
      "kuaishou": {
        "path": "out/kuaishou_emoji/kuaishou-emoji.json",
        "build": {"enabled": true, "mode": "web", "out": "out/kuaishou_emoji",
                  "src": null, "no_download": false, "no_sheet": false}
      }
    }
  },

  "input": {
    // 三段素材：**显式数组**（段顺序 = 时间顺序）。
    // 目录里曾有一个重复下载的 `17： 41-19： 28(1).mp4`（同大小、md5 不同），已按
    // 无后缀的那份取用；要在别的机器上重下请确认**(1) 不要**进 videos。
    "videos": [
      "/run/media/puyu/A1B7-2982/10.31/快手/16： 00-17： 40.mp4",
      "/run/media/puyu/A1B7-2982/10.31/快手/17： 41-19： 28.mp4",
      "/run/media/puyu/A1B7-2982/10.31/快手/19： 28-21： 08.mp4"
    ],
    "segment_names": null,              // 段名（= 子目录名）；null ⇒ seg1、seg2、seg3
    "video": null,                      // 单段写法（与 videos 互斥，本件用不到）              --video
    "rows": null,                       // 单段复算用；多段不用写（<段目录>/rows.jsonl 在就自动复算）
    "text": null,                       // 纯文本行文件；"-" 读 stdin                            --text
    "start": 0.0,                       // 起始时间（秒）                                      --start
    "duration": null,                   // 处理多长（秒）；null = 整段                          --duration
    "interval": 2.0,                    // 固定间隔抽样用（本件用 adaptive，此项不生效）          --interval
    "max_frames": null,                 // 最多抽几帧；null = 不限                              --max-frames
    "resume": true,                     // 断点续跑：rows.jsonl 已在就接着它跑（已处理帧跳过）   --resume

    // 抽帧策略：手机 App 是平滑滚动 ⇒ 长录屏用 adaptive（静止段几乎不拍、滚动段不漏条）。
    "sample": {
      "mode": "adaptive",               //   interval / backoff / adaptive                     --sample-mode
      "stride": 2,                      //   每 N 个解码帧估一次位移（1 = 每帧都估）
      "safety_rows": 5.0,               //   累计位移 ≥ 这么多行 ⇒ 强制拍（上限 5）
      "settle_frames": 3,               //   动过之后静止这么多帧 ⇒ 拍一次
      "eps_px": 1.0,                    //   位移小于它算「没动」
      "entry_thr": 8.0,                 //   底部入口行变化多少像素算「新评论弹进来」
      "max_gap_s": 5.0,                 //   最长多久必须拍一次（0 = 不限）
      "min_interval": 0.2,              //   两次拍摄的最小间隔（秒）
      "max_interval": 6.0,              //   两次拍摄的最大间隔（秒）
      "min_score": 0.3                  //   位移估计的匹配分下限
    }
  },

  // -------------------------------------------------------------------------
  // 面板：**手写**（评论列表位置已在每段首帧量好，不需要再跑模型定位）。
  // rect 是**原图像素**的评论区窗口：[x1, y1, x2, y2]
  //   · y1=640：评论列表顶（最早一条评论 y≈653）；其上是直播画面。
  //   · y2=1185：输入栏 `说点什么…` 实测 1217~1251，切在它之上。
  //   · x1=0 / x2=590：列表满宽（x2_from=window 取窗口右沿）。
  //   · 三段同一台设备、同一版 App（590×1280）⇒ 共用一套 rect。
  //   · 改了 rect 直接重跑即可：manual 下配置是唯一来源（与面板文件不一致时按配置重写）。
  // -------------------------------------------------------------------------
  "panels": {
    "mode": "manual",                   // manual=手写面板直接写进 file（交付走 manual）
    "file": null,                       // null ⇒ 每段各一个 <段目录>/panels.json（多段）
    "files": null,                      // 也可显式一份一段地列出面板文件路径（顺序 = 段顺序）
    "overwrite": false,                 // manual：配置与面板文件不一致就按配置重写；locate：已存在就不动
    "auto": {                           // 自动定位参数（mode=locate/auto/batch 时用；本件用不到）
      "method": "hybrid",
      "at": 900,
      "frames": 5,
      "span": null,
      "split_x": null,                  //   ⚠ null = **不切分**（竖屏单直播间是一列评论）
      "pad_x": 60,
      "pad_top": 80,
      "pad_y": 16,
      "sub_width": 500,                 //   ⚠ 竖屏整帧裁切必须降下来，否则 4bit 模型 CUDA OOM
      "model": "nvidia/LocateAnything-3B",
      "quant": "4bit",
      "device": "cuda",
      "platforms": {                    //   只在 mode=auto/builtin/batch 时用
        "left": "kuaishou",             //   不切分后唯一的窗口叫 left
        "right": null
      },
      "frame_width": 590
    },
    // mode=manual：手写面板，**一段一项**（顺序与 input.videos 的段顺序一致）。
    // **配置是唯一来源**：段目录里的 panels.json 只是它的落盘副本。
    "manual": [
      {                                //   seg1  `16： 00-17： 40.mp4`  590×1280
        "comments": {"rect": [0, 720, 590, 1185], "platform": "kuaishou"}
      },
      {                                //   seg2  `17： 41-19： 28.mp4`  590×1280
        "comments": {"rect": [0, 720, 590, 1185], "platform": "kuaishou"}
      },
      {                                //   seg3  `19： 28-21： 08.mp4`  590×1280
        "comments": {"rect": [0, 720, 590, 1185], "platform": "kuaishou"}
      }
    ],
    "batch": {                          // mode=batch：稳定性研究（挑固定矩形用；不动 file）
      "count": 30,
      "start": 0.0,
      "span": 600.0,
      "anchor": "panel"
    }
  },

  "parse": {
    "sep": " ",                         // 续行拼接用的分隔符                                      --sep
    "max_username_len": 24,             // 冒号前超过这个长度就不当用户名                          --max-username-len
    "merge_continuation": true,         // 是否把「无用户名的行」并进上一条评论                   取反 --no-merge
    "adjacency": true,                  // 「续行必须相邻」守卫                                  取反 --no-adjacency
    "dedup": true,                      // 按滚动对齐跨帧去重出唯一评论表                        取反 --no-dedup
    // ⚠ 关掉自标定：快手评论之间夹着大量系统行（恭喜/送出人气票/加入），
    //   `calibrate_panels` 按「评论头行」中心估行距，间隔正好翻倍；而且本素材的行间距是
    //   双峰（单行气泡 60 / 两行气泡 105），PITCH_RANGE 只到 100，标定会直接失败。
    //   行距 60、续行比 0.80、相位、浮层卡都已实测写死，关掉最稳。
    "calibrate": false,                 // 面板几何自标定（行距/浮层右界/续行；相位逐帧估）      取反 --no-calibrate
    "right_pad": 0,                     // ROI 右边界距面板右边的余量；0 = 贴面板边圈住框外表情    --right-pad
    "emoji_workers": 1                  // 表情扫描线程数；1=串行（结果逐字节确定），4~8 更快
  },

  "output": {
    // 多段时这里是**段的父目录**：实际各写 <dir>/seg1、seg2、seg3；
    // 跨段产物落在这儿：merged_users.json（qualify）；交付树见 collect.out。
    // 按平台分目录：同素材另有「抖音/」「视频号/」，各用各的 output.dir，段目录不会撞。
    "dir": "out/10.31/快手",            // 输出根目录                                             --out
    "write": true,                      // 是否写盘（comments.jsonl + summary.json 成对）
    "rows": true,                       // 另存 rows.jsonl（**可回喂复算**）
    "panels": true,                     // mode=auto 时把定位结果存成 panels.json
    // frames：**抽样帧**一张图 frames/<t>_roi.jpg（≈0.55MB/张），不是每条评论一张。
    "frames": true,                     // 取反 --no-frames
    "print": false                      // 除写盘外也把评论打到 stdout                            --print
  },

  // 评论 → 合格用户：用户名 ≥min_positive 条**正面**评论（正面由大模型判定，表情也发），
  // 并排除用户名命中关键词的官方侧账号。**要花钱**；key **只走环境变量**（本项目铁律）。
  //
  // ⚠ 本件是**三段素材**，交付要求「该账号 ≥3 条正面」是**按三段合计**判的 ⇒
  //   这里 `min_positive: 1`（只出全量用户表），合格与否交给 `qualify` 步按合计判。
  "filter": {
    "enabled": true,                    // 打开才会调模型；只想抽评论就先 --skip filter
    "source": null,                     // 评论来源；null ⇒ <段目录>/comments.jsonl
    "out": null,                        // 合格用户 JSONL；null ⇒ <段目录>/users.jsonl
    "cache": null,                      // 判定缓存；null ⇒ 三段共用 <output.dir>/judgments.jsonl
    "min_positive": 1,                  // 单段阈值（**合计口径见上面 ⚠**；qualify 一开就自动取 stage_min）
    "exclude_keywords": [               // 用户名含任一即排除（不区分大小写）
      // ⚠ 沿用**奇瑞那条线**的表（品牌 + 4S + 车型 + 高管姓名）；本场官方号 / 主播 /
      //   试驾员还没按本场补。填错的代价是把真观众挡在名单外 ⇒ 等名单出来再逐条加。
      "奇瑞", "4s", "店", "qq3", "汽车",
      "尹同跃", "张国忠", "鲍思语", "王津华", "王孝伟", "胡敬源", "尹祥领",
      "王来春", "李晶", "商文江", "杨棉之", "叶盛基", "路风", "黎汝雄",
      "李学用", "张贵兵", "代立宏", "章红玉", "高新华", "戚士龙", "王琅"
    ],
    "nlp": {
      "api_key": null,                  // **留 null**：key 只走环境变量（本项目铁律）
      "api_key_env": "NLP_API_KEY",     // ← 环境变量的**名字**（把 key 写到这行永远取不到）
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "deepseek-v4.1-flash",   // ⚠ 模型名会随平台改，写错就是 404（不是 key 的问题）
      "batch_size": 20,
      "concurrency": 4,
      "timeout": 60.0,
      "retries": 3,
      "limit": null,                    // 最多调多少批（控成本）
      "prompt": null                    // null ⇒ 用 user_filter.DEFAULT_PROMPT
    }
  },

  // -------------------------------------------------------------------------
  // 跨段的两步（顺序有依赖：filter（逐段）→ qualify（跨段）→ export（逐段）→ collect（拼树））
  // -------------------------------------------------------------------------

  // 跨段判合格（**全局步**）：把三段的 users.jsonl 按**账号合计**算正面条数，≥min_positive
  // 的才算合格，再把合格用户**回写**成每段的 users_qualified.jsonl 交给 export。
  "qualify": {
    "enabled": true,                    // 单段素材开着也无害（退化成「按本段判」）
    "min_positive": 3,                  // 交付阈值（**跨段合计**）—— 与 08-09CTCC 参考语料一致
    "stage_min": 1                      // 各段 filter/export 用的阈值（先出全量，合格留给这一步判）
  },

  // 逐段出交付图（**逐段步**）：读该段 users_qualified.jsonl，按**原帧**画绿框，一人一个目录
  // `<昵称>-<本段条数>`（跨段同名目录由 collect 并成一个）。
  "export": {
    "enabled": true,
    "base": "frame",                    // frame=原帧（参考语料形态）/ annotated=标注图      --base
    "labels": "正面",                   // 只出正面评论                                        --labels
    "min_positive": null,               // null ⇒ qualify.stage_min（合格已在 qualify 判完）
    "min_scope": "platform",            // 平台内各自够数；三段同一平台 ⇒ 等同于按合计         --min-scope
    "users": null,                      // null ⇒ <段目录>/users_qualified.jsonl
    "color": "0,255,0", "width": 3,     // 绿框（对齐参考语料）
    "pad": 0, "pad_ratio": 0.25, "quality": 90,
    "force": true                       // 重跑覆盖上一轮的导出目录
  },

  // 拼最终交付树（**全局步**）：把三段的导出目录按账号身份并成一个目录、图号 1..N
  // **跨段连续**，后缀取**合计**条数，顺带写 正面账号.txt + manifest.json。
  // out 显式写死：output.dir 已经带 `/快手`，再让 collect 自动拼 `<平台目录>` 会变成
  // …/快手/快手/…。
  "collect": {
    "enabled": true,
    "stage_min": null,                  // 各段导出目录名里的数字；null ⇒ qualify.stage_min
    "platform_dir": null,               // 交付树里的平台目录名；null ⇒ 从各段导出目录自动认（快手）
    "out": "out/10.31/快手/all_users_正面_3张以上",
    "force": true                       // 目标非空时整棵重来（否则报错退出）
  },

  "draw": {                             // 独立描框步骤（draw_boxes.py）；核心解析已自带逐帧标注图，默认关
    "enabled": true,
    "source": null,
    "at": 8.0,
    "window": 5.0,
    "out": null,
    "width": 5,
    "quality": 90,
    "labels": true
  },

  "steps": {
    // 顺序**不能乱**：filter（逐段）→ qualify（跨段判合格）→ export（逐段）→ collect（拼树）。
    // 逐段步（panels/parse/filter/export/draw）三段各跑一遍；全局步（emoji_tables/qualify/collect）整批一次。
    "order": ["emoji_tables", "panels", "parse", "filter", "qualify",
              "export", "collect", "draw"],
    "skip": ["emoji_tables", "draw"]    // 表情表已建好（out/kuaishou_emoji/）；独立描框用不上
  }
}
