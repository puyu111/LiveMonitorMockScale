// ============================================================================
// 风云T7上市 2026-08-26 · 抖音直播（手机 App 竖屏）→ 结构化评论
//
// 素材 = 「20-2026-08-26风云T7上市」抖音/风云新能源/ 下的**七段**录屏（同一场直播、
// 时间**不重叠**，中间 16：23~17：13 缺录）：
//   seg1  `12：01-13：00.mp4`  720×1600  59.6min
//   seg2  `13：00-13：49.mp4`  720×1600  48.8min
//   seg3  `13：49-14：26.mp4`  720×1600  37.2min
//   seg4  `14：27-15：29.mp4`  720×1600  62.9min
//   seg5  `15：30-16：23.mp4`  720×1600  53.9min
//   seg6  `17：13-17：33.mp4`  720×1600  19.6min
//   seg7  `17：20-18：19.mp4`  590×1280  58.7min   ← **另一台设备/另一种缩放**（0.82×）
//   合计 340.7min ≈ 5.7h。七段一次配全（input.videos 吃通配符），每段在 output.dir 下
//   开一个子目录（seg1..seg7），逐段步各跑一遍、跨段步（qualify/collect）整批跑一次。
//   必须**串行**跑（这台机器可用内存 5G，并行 OCR 会 OOM）—— 管线本来就是串行循环。
//
// 行版式：`[◆N 粉丝团药丸] 昵称***：正文`（药丸画在昵称**左边**、独占左侧徽章列）
//   · 药丸 = 菱形图标 + **粉丝团等级数字**（`9`/`24`/`38`…），画在 x∈[22,95]（720 宽时）。
//     OCR 有时把药丸数字并进正文块 ⇒ 用户名长出数字前缀（`22阳***` / `5漆***` / `29海***`），
//     同一个人被算成好几个账号 ⇒ 归一见 `badge_alias`（⚠ 只部分生效，见档案里的说明）。
//   · **没有**「粉丝」两个字那种文字药丸（视频号 App 才有）⇒ 本档案不配 fan_badge_x_max。
//   · 昵称一律打码成 `X***`（抖音打 3 颗星）；没药丸的观众（非粉丝团）昵称直接顶到 x≈10。
//   · 折行续行（长评论的第 2、3 行）缩进到 x1≈37~45，**落在药丸带里** —— 这是抖音手机版
//     与桌面网页版最大的不同，x_text 取值必须绕开它，见档案里 x_text 的说明。
//
// ⚠⚠ 平台名取 `douyin_app`，**不要**用内置的 `douyin`：内置那份量的是**桌面网页版**
//   （row_pitch 68 / y_phase 17 / x_text 70，见 livepipe/csj.json 的说明），
//   手机 App 实测 53.5 / 10 / 96 —— 数字一个都不能照抄，照抄行网格全错、整片认不出。
//   同名档案的**交付目录**都在 `抖音/`（见 export_user_images.PLATFORM_CN，加档案名时别忘了加一行）。
//
// 这块素材量到的（证据写在各参数的行内注释里）：
//   ✅ 行距 53.5 · 相位 10（兜底值，实测逐帧估）· x_text 96 · 裁切右沿按内容（rect x2=600）
//      · 药丸并进正文的几何闸（badge_alias）· 公告横幅的素材短语（overlay_cards）
//      · 商品讲解卡的浮层左界（x_ignore_from 400，seg7 360 —— 用「评论簇/浮层簇」之间
//        的空带取值，见档案里该键的说明）
//      · 表情用抖音那套表（out/douyin_emoji/douyin-emoji.json，2026-10-06 已建好）
//   ⚠ 已知残留（都在下面标了原因，量的时候看见的，别当没发生）：
//      ① `X***分享了直播` 这类**系统行**会漏成匿名评论 —— 内置 `_NOTICE_RE` 认的是
//         `赞了直播/为主播点赞/入了直播间/关注了主播`，没有 `分享了直播`。它不是本素材
//         独有（2026-06-17 艾瑞泽8 的抖音交付语料里就有 3 条），所以没在素材配置里硬塞，
//         改内置表要按老规矩在**六套语料**上逐条 diff（见 CONFIG.md 的「改正则」惯例）。
//         实测量（v1 的 150s 切片）：5 条里漏 1 条（`贝***分享了直播`）；v6 111 条里漏 5 条。
//      ② 商品讲解卡的文字块跟评论行**同槽**会被 `assemble_row` 拼成一句
//         （`1***：几点发布会风云T7600k`）—— **已由 x_ignore_from 消掉**（见档案里该键的
//         开关差分：seg1 13 条 → 5 条、seg6 4 条污染 → 0 条）。开这个键之前它在 s1 的
//         1927 行里占 85 行 = 4.4%。
//      ③ s7 是 0.82× 缩放的另一台设备，只有它一段的 rect / 行距 / x_text / 浮层右界要单独写。
//
// 跑法（OCR 要带 rapidocr 的解释器）：
//   P=/home/puyu/anaconda3/envs/vlx/bin/python
//   ① 抽行（免费、慢：七段合计约 5.7h 素材，按 ctcc 实测 3~4s/帧估 ≈ 6~8h）：
//        export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
//        $P -m livepipe run livepipe/风云T7.json                    # = panels → parse
//        $P -m livepipe run livepipe/风云T7.json --only panels,parse
//        ⚠ 某段中断了直接重跑同一条命令：<段目录>/rows.jsonl 已在 ⇒ 自动零 OCR 复算/续跑。
//   ② 筛 + 判合格 + 出图 + 拼交付树（**要 key**，只走环境变量）：
//        NLP_API_KEY=sk-xxxx $P -m livepipe run livepipe/风云T7.json \
//            --only filter,qualify,export,collect
//   ③ 先看后交：产物在 out/风云T7_20260826_01/抖音/all_users_正面_2张以上/，
//      核对完再整个目录拷到 work/data/20-2026-08-26风云T7上市/抖音/。
//
// 校验（不跑、安全）：
//   python3 -m livepipe check livepipe/风云T7.json
//   python3 -m livepipe run  livepipe/风云T7.json --dry-run
// ============================================================================
{
  "version": 1,                        // 配置格式版本，必须是 1
  "name": "风云T7上市 2026-08-26 · 抖音手机 App · 竖屏",   // 只出现在日志里

  // -------------------------------------------------------------------------
  // 平台档案：面板文件里只填平台名，行距 / 表情表 / 裁切策略 / 药丸闸都从这里取。
  // **抖音手机 App 的版式与内置 `douyin`（桌面网页版）不是一套数字**，所以另起一个名字，
  // 不去覆盖内置的 douyin（覆盖会让 csj.json 那条桌面线跟着变）。
  // 下面每个数字后面都写了它是**怎么量出来的**；换素材时照着量一遍再改。
  // -------------------------------------------------------------------------
  "platforms": {
    "douyin_app": {
      "label": "抖音直播（手机 App 竖屏；行首 ◆N 粉丝团药丸在昵称左边）",
      "emoji": "douyin",                // → emoji.tables 的 douyin 表（内置，表已建好）

      // 行距（像素）—— **实测**（720×1600，2026-10-13）：
      //   ① 像素级：seg1 t=900 连续三行中心 1358 / 1414 / 1467 ⇒ 间隔 56/53；
      //   ② 行投影：seg6 的 766 行行中心，12+ 个连续间隔落在 52~54（众数 53/54）；
      //   ③ 解析自标定：seg6 出 53（置信度高）、seg7 出 43.5（置信度 0.79）。
      //   取 **53.5**。内置 douyin 的 68 是桌面网页版的，差 14.5px ⇒ 槽位逐行漂移、越往下越错。
      "row_pitch": 53.5,

      // 首行中心距面板顶（**裁切内**坐标）—— **实测**：seg1/seg6 的行中心（裁切内）mod 53.5
      //   的众数落在 10（5px 分桶）。手机 App 平滑滚动、相位**逐帧变**（estimate_phase 逐帧估），
      //   这个值只在某帧估不出来（行数 < 3）时兜底，差 10px 以内都不影响吸附（容差是半个行距）。
      "y_phase": 10,

      // 正文列左沿 = 徽章列右沿（**裁切内**坐标）—— **实测**（seg1+seg6 共 2693 行，2026-10-13）：
      //   带冒号的行左沿成两簇：
      //     93~101（真昵称 —— 被药丸顶到徽章列右边；seg6 的 766 行里这是大多数）
      //     45~60 （药丸数字被并进正文：`22阳***：…` / `5漆***：…` / `29海***：…`）
      //   没药丸的行（非粉丝团观众，如 `I***：外观真亮眼`）昵称顶到 **10~15**。
      //   取 **96**（= 药丸列右沿；药丸实测画在 x∈[22,95]，宽度正好 = BADGE_SPAN−BADGE_INSET = 50）。
      //   三条判据都靠它，缺一不可：
      //     ① 真昵称（≥93）落在 x_text 右边 ⇒ `_has_own_badge` 成立 ⇒ 照旧是新评论的首行；
      //     ② **贴左沿的整行**（无药丸昵称 10~15、折行续行 37~45）落在 `x_text−50 = 46` 以左
      //        ⇒ 走「贴左沿一律算整行正文」那一支 ⇒ **不需要 wrap_indent 自标定**。
      //        这一点是这块素材的关键：seg6 的缩进续行自标定**失败**（静音段没测到）、
      //        seg7 又**误开**成 0.95，靠贴左沿这一支正好绕开自标定的不确定性。
      //     ③ 落在 [46,96) 的**无冒号**碎片（药丸数字并进正文的通知行 `22阳*** 分享了直播`）
      //        按徽章碎片丢掉 —— 想要的正是这个效果。
      //   ⚠ 别再往下调：调小（如内置的 70）会把 37~45 的折行续行推进「缩进带」，那条路上
      //     要靠自标定开 wrap_indent 才认，一失败多行评论就散成匿名残句（微博踩过同款坑：
      //     x_text=45 时 10 条评论里 8 条昵称消失）。
      "x_text": 96,

      // 裁切右沿：**按内容**（rect 的 x2 = 600 就是量出来的内容右沿，裁切内再没有别的东西）。
      //   抖音 App 的评论列表满宽，但**文字有换行边距**：气泡右沿 ~590、正文最长读到 584
      //   （seg1 的 1927 行、seg6 的 766 行里 x2 的最大值），右边 600~720 是点赞/评论/分享
      //   图标列 + 「本场点赞」文字 ⇒ 裁切停在 600：少扫 17% 面积，也不会把图标列读成评论。
      //   为什么不用 window（视频号 App 用的那个）：本档案的评论列右边就是内容右边
      //   （没有「内容随窗口伸缩」的问题），用 content 省面积；ROI 右边界两种情况都取裁切边。
      "x2_from": "content",

      // 行首**药丸数字被并进正文** ⇒ 同一人被读成好几个账号，按几何见证归一（CONFIG.md 同名小节）。
      // **实测**（seg6 的 766 行）：并进药丸的读法 x1 ∈ [45,60]、干净读法 x1 ∈ [93,101]
      //   ⇒ 两簇相距 ≥33px；MIN_GAP=20 夹在中间，同时把「OCR 丢一个行首字」（≈13/24px）排除在外。
      // **判据：等级标（`◆N`）一致才算同一个人**（2026-10-14）。◆N 是粉丝团等级、挂在人身上
      //   与昵称绑定 ⇒ 它同时是①归一脏读法的**钥匙**（`22阳***`+等级 22 ⇒ 就是 `阳***`）、
      //   ②不并错人的**硬闸**（`小明` 等级 6 与 `1小明` 等级 1 发同一句话也不并）。
      //   两条取证通道都按它判：A 同一 rid 组（形状不像药丸的两位数前缀，**只有**读数对得上才认）；
      //   B **跨 rid** 的同一句话（实测同一人的两种读法 13/13 都落在相邻但不同的 rid 上 ⇒
      //   A 通道结构上看不见它们；B 要「正文一字不差 + 文字框左沿差 ≥20px + 读数对得上」三样齐）。
      //   ⚠ 依旧**读不全**：徽章块检出率约 4 成（seg6 的 1047 行里 571 行有读数），
      //   检不出读数的脏读法只能退回形状判据 —— 那就是改不动的那些（`）海***` 这种
      //   「OCR 把药丸咬成括号」的读数也取不到）。宁可漏归一，不可错归并。
      "badge_alias": true,

      // 交付这一层认人：**按 (昵称, 等级标 ◆N)**，不是只按昵称（CONFIG.md 同名小节）。
      //   为什么必须带上等级标：本素材的昵称在屏幕上就是**打码**的（`X***`），一个显示名
      //   底下是几十个不同的人 —— 只按昵称聚合，等于把一群人的评论记到一个人的名下
      //   （人数虚低、条数虚高，正好能把「凑不够 3 条」的人凑合格）。
      //   判据与解析层的 badge_alias **同一条**（等级一致才是同一个人）；差别是这里的
      //   「一致」按**逐条读数**算：读不到等级的那些单独成一档，不与任何读到的并
      //   —— 徽章检出率只有 4 成，赌一处读数就是把别人的评论记错人。宁可漏归一。
      //   实测差量（v6/v7 两个 150s 切片，见 STATUS；数字**不含匿名**那一档）：
      //   账号 75→78 / 131→150，「≥3 条」的账号 3→2 / 14→7（老口径那些合格账号大半是假的），
      //   `紫***` 这种一个名字下读出 {26:3, 14:2, 15:1} 的（三个不同的人）现在分开了。
      //   ⚠ 只影响**交付名单**（filter/qualify/export/collect 的账号划分）；解析层一个字节没动。
      "account_key": "nickname_level",

      // 直播间浮层的左界（**裁切内** x）—— **实测写死**（2026-10-13，4 段 13 帧的 OCR 块直方图）：
      //   评论侧文字块左沿实测**最大 325**（`互粉` 252 / `加油` 293），浮层（商品讲解卡）最左
      //   那块实测 **478**（`风云T7600k`；同一张卡还有 `讲解中` 488 / `稳稳的` 507 / `立即预` 532）
      //   ⇒ 两簇之间 [325, 478) 是 **153px 的空带**，取 **400**，两边各留 75px。
      //   一箭双雕消掉两种残留：① 浮层**自己的行**（`讲解中`/`立即预` 漏成匿名垃圾评论）；
      //   ② 浮层的文字块跟评论行**同槽**、被 `assemble_row` 拼成一句
      //   （`魏***：多少钱风云T7600k` —— 之前记成「并了就分不开」，实测是两块同槽拼的，
      //   OCR 并没有并成一块，所以**分得开**）。
      //   开关差分（同一段 150s 切片，只差这一个键）：seg1 评论 13 条 → **5 条**，
      //   去掉的 8 条全是浮层污染，4 条真评论一条不少、也没有丢续行；seg7 242 → **见 STATUS**。
      //   ⚠ **必须写死**，不能交给自标定：浮层只在一部分时间出现（seg1 在 t≈314~370 才有），
      //   而自标定只 OCR 开头 CALIB_FRAMES=4 帧 ⇒ seg1 那 4 帧里没有浮层、标不出界；
      //   seg6 标到 **479**，而浮层最左那块实测在 **478** ⇒ **1px 之差**整块漏下来
      //   （实测污染 4 条评论 = 3.6%）。`calibrate_panels` 已改成**不覆盖手写值**
      //   （见该函数 ② 段；仓库里没有别的配置写过这个键 ⇒ 对既有语料是空操作）。
      "x_ignore_from": 400,

      // 评论列表上压**浮层卡**（不是评论、又没有冒号 ⇒ 会被当匿名评论收进来）。本素材两张：
      //   ① **公告横幅**（滚动条：`风云T7全球品质纯电SUV上市发布会，` / `一起驶向稳稳的幸福！`）——
      //      它是列表里的**一行**、跟列表一起滚，所以「列表滚了它没动」那条跨帧判据
      //      （frozen_overlay_texts）认不出它，只能靠**素材短语**认。实测它的 x1 ∈ [94,97]，
      //      恰好压在 x_text=96 上：94/95 会被当徽章碎片丢掉、96/97 不会 ⇒ 不给短语的话，
      //      它漏不漏由 1px 的 OCR 抖动决定（seg1 里两种形态各 76/79 次，同一片里都有）。
      //   ② **商品讲解卡**（右侧 `风云T7` + `讲解中` 红标）—— 它的文字块（实测 x1 ≥ 478）
      //      一律由上面的 `x_ignore_from` 丢掉：独立行（`讲解中`/`立即预`）和「跟评论行同槽
      //      被 `assemble_row` 拼成一句」（`1***：几点发布会风云T7600k`，seg1 的 1927 行里
      //      85 行 = 4.4%）一起消掉。⚠ 早先这里写过「并了就分不开」—— **是错的**：
      //      块级 dump 显示评论块（x 101~266）与卡块（x 478~595）是**两次独立的 OCR 检测**，
      //      只是拼在同一个行槽上，而闸门在**分组之前**。
      // 取值给**字符串** = 内置短语表 ＋ 这段正则；给 true 只有内置表。
      // 内置表是**视频号**那套词（`抽烟酗酒`/`色情低俗`/`人身损失`），抖音 App 的临时提示卡
      // 用的是另一套词（`吸烟酗酒`/`低俗色情`/`人身财产损失`）⇒ 一并补上（它们是 UI 短语、
      // 不是素材词，本来该在内置表里；放这儿是**零风险**的选择 —— 内置表动一次得在六套语料上
      // 逐条 diff，而那批卡的残留影响只是多几条无用户名的假评论）。
      // 判据只作用于**没有冒号的行**（有冒号的行按定义是评论），所以真评论不会被误伤。
      "overlay_cards": "风云T7全球品质|一起驶向稳稳|吸烟酗酒|低俗色情|人身财产损失|严禁未成年人|诱导打赏",

      // 以下版式量**不用写** —— 解析时从采样帧自标定（本素材实测自标定出的值）：
      //   "wrap_gap_ratio": 0.73,       // 续行间距比上限（≥1 个行距的是左对齐横幅）—— 本素材
      //                                 // 折行续行间距实测 37~38px = 0.70 个行距，与模块默认 0.73
      //                                 // 同量级；而且本档案靠 x_text 的「贴左沿」那一支认续行，
      //                                 // 不依赖这个自标定值（seg7 自标定出的 0.95 是虚高，别照抄）。
    },

    // -----------------------------------------------------------------------
    // 微博直播（手机 App 竖屏）—— **另一套版式**，与上面的 douyin_app 一个数字都不通用。
    // 量法：`16：38-17：22.mp4`（978×2176）抽帧，面板 rect = [10, 950, 950, 1850]
    //   （= 现有 seg1/panels.json，绿框正好卡在第一条评论与底部输入栏之间）；
    //   下面所有坐标都是**裁切内**（x_text=28 ⇒ 原图 x=38）。
    //   · 行距 **74**：连续 8 行中心间隔实测 73~75（内置 douyin 的 68 差 6px ⇒ 越往下越错）；
    //   · 相位 **45**：首行中心距裁切顶 45px（逐帧估不出时兜底）；
    //   · x_text **28**：正文列左沿。文档里写的 38 是**面板 rect x1=0** 时的值
    //     （README / CONFIG 的 weibo 档案、以及解析层注释里的 38 都按那套坐标量的）；
    //     本件的 rect x1=10 ⇒ 裁切内要减 10。实测昵称块 x1 ∈ [25,34]、折行续行同样从
    //     这里起（**没有左侧徽章列**，这个值就是正文列左沿，语义与 douyin_app 的 96 不同）。
    //     写成 38 的后果是**每一条带药丸的评论都丢掉昵称**：昵称块（无冒号、x1<38）会被
    //     `_in_badge_gutter` 当徽章列碎片扔掉，只剩药丸右边的正文（实测 13 条里 9 条没昵称）。
    //   · x2_from **content**：评论列右边就是内容右边（截到 rect 的 950）。
    // rank_pill：等级标是昵称**右边**的「榜N」橙色药丸（榜一…榜九）—— 不开会被并进用户名；
    //   冒号再被 OCR 吃掉时，两条不相干的评论还会搅成一条（见 _split_rank_pill）。
    // wrap_at_text_left：没有徽章列 ⇒ 折行续行与首行**同一个左沿**（实测两簇 x1 完全重叠），
    //   形状判据认不出，改按「与上一行的间距 ≈0.6 个行距」认（见 group_rows 的间距入口）。
    // ⚠ 表情表 out/weibo_emoji/weibo-emoji.json 本机还没建（表在仓库外）：
    //   python3 livepipe/weibo_emoji_table.py --out out/weibo_emoji 建一次即可；
    //   缺表只会打警告、认不出表情，不影响主流程。
    //   表里的 thresholds 是「部分标定」（partial，2026-10-26）：min_score=0.82 / min_margin=0.12 /
    //   min_saturation=30 由本素材的 [打call] 量出，别的字形没交叉验证过 —— 换素材先复核。
    // ⚠ 微博这一侧**不要开 parse.badge_reread**：二次读数按「正文框左边一竖条」裁药丸，
    //   而微博的药丸在昵称右边 ⇒ 每条评论都白裁一次（读不到，只是浪费取帧 + 识别）。
    "weibo": {
      "label": "微博直播（手机 App 竖屏；等级标是昵称右边的「榜N」药丸）",
      "emoji": "weibo",
      "row_pitch": 74,
      "y_phase": 45,
      "x_text": 28,
      "x2_from": "content",
      "rank_pill": true,
      "wrap_at_text_left": true
    }
  },

  // 表情表用内置的 `douyin`（out/douyin_emoji/douyin-emoji.json，2026-10-06 建好）
  // ⇒ 这里一个字段都不用写：emoji.tables 的默认值就是它，emoji.enabled 默认 true。

  "input": {
    // 七段素材：通配符展开后按**文件名排序** = 时间顺序
    //   `12：01…` < `13：00…` < `13：49…` < `14：27…` < `15：30…` < `17：13…` < `17：20…`
    //   ⇒ seg1..seg7 正好对上（下面 panels.manual 的七项就是按这个顺序）。
    "videos": "/home/puyu/work/data/2-2026-06-17艾瑞泽8征服版上市/微博/*.mp4",
    "segment_names": null,              // 段名（= 子目录名）；null ⇒ seg1、seg2…
    "video": null,                      // 单段写法（与 videos 互斥，本件用不到）              --video
    "rows": null,                       // 单段复算用；多段不用写这个（<段目录>/rows.jsonl 在就自动复算）
    "text": null,                       // 纯文本行文件；"-" 读 stdin                            --text
    "start": 0.0,                       // 起始时间（秒）                                      --start
    "duration": null,                   // 处理多长（秒）；null = 整段                          --duration
    "interval": 2.0,                    // 固定间隔抽样用（本配置用 adaptive，此项不生效）        --interval
    "max_frames": null,                 // 最多抽几帧；null = 不限                              --max-frames
    "resume": true,                     // 断点续跑：rows.jsonl 已在就接着它跑（已处理帧跳过）   --resume

    // 抽帧策略：**手机 App 是平滑滚动**（相位逐帧变，实测同一条评论 2 秒里移动 2.8 个行距），
    // 固定间隔会在两次拍摄之间漏条 ⇒ 长录屏用 adaptive（静止段几乎不拍、滚动段不漏条）。
    // 下面这组是 ctcc.json（同为手机 App 竖屏长录屏）跑通的那组，本素材照搬；
    // 逐段跑完看 `<段目录>/summary.json` 里的 sample 统计（gap/entry/settle）核对。
    "sample": {
      "mode": "adaptive",               //   interval / backoff / adaptive                     --sample-mode
      "stride": 2,                      //   每 N 个解码帧估一次位移（1 = 每帧都估）
      "safety_rows": 5.0,               //   累计位移 ≥ 这么多行 ⇒ 强制拍（上限 5，防重复评论）
      "settle_frames": 3,               //   动过之后静止这么多帧 ⇒ 拍一次（抓住稳定的一屏）
      "eps_px": 1.0,                    //   位移小于它算「没动」
      "entry_thr": 8.0,                 //   底部入口行变化多少像素算「新评论弹进来」
      "max_gap_s": 5.0,                 //   最长多久必须拍一次（0 = 不限）
      "min_interval": 0.2,              //   两次拍摄的最小间隔（秒）
      "max_interval": 6.0,              //   两次拍摄的最大间隔（秒）
      "min_score": 0.3                  //   位移估计的匹配分下限
    }
  },

  // -------------------------------------------------------------------------
  // 面板：**手写**（评论列表的位置已逐段量好，不需要再跑模型定位）。
  // rect 是**原图像素**的评论区窗口：[x1, y1, x2, y2]
  //   · y1=762（seg1~seg6）：**七段共用一个边界**（同一台设备同一版 App，见下面量法）——
  //       视频画面底沿在 704~758 之间，762 切在它之下、第一行评论之上（实测 seg1 首行中心 799.5）。
  //   · y2=1500（seg1~seg6）：输入框 `说点什么…` 的占位文字实测在 y1531~1565、
  //       输入框上沿 ≈1510 ⇒ 1500 卡在「最后一行气泡的下沿（实测 1495~1500）」与输入框之间。
  //   · x1=0 / x2=600：评论列满宽，但文字右沿到 584、气泡右沿到 ~590 ⇒ 600 是内容右沿
  //       （见 x2_from 的说明；600~720 是右侧图标列，切掉）。
  //   · seg7 是 590×1280 的另一台设备（0.82×）：整流平移到 [0, 580, 510, 1140]
  //       （580 = 缩放的视频底沿，实测该段第一行中心在 582~590；1140 在输入框 1136 之上）。
  //       **它还要单独覆盖三个档案量**（行距 43.5 / x_text 86 / 相位 5），见 panels.manual 第 7 项。
  //   ⚠ 改了 rect 要记得删 <段目录>/panels.json 再跑（overwrite=false 不覆盖它）。
  //
  // 怎么确认这七段共用一套几何（2026-10-13）：七段各抽一帧（30% 处）拼成一张对照图，
  //   把候选 rect 画上去 —— 六段 720×1600 的绿框正好卡在「视频底沿之下、输入框之上」，
  //   seg7 用 0.82× 的那组值同样卡住。同一台设备录的，所以共用。
  // -------------------------------------------------------------------------
  "panels": {
    "mode": "manual",                   // manual=手写面板直接写进 file（交付走 manual：
                                        //   手写 rect 的 y2 是「切在输入框之上」（量好的），
                                        //   locate 只看「哪几行有冒号」，量不出输入框在哪）
    "file": null,                       // null ⇒ 每段各一个 <段目录>/panels.json（多段）
    "files": null,                      // 也可显式一份一段地列出面板文件路径（顺序 = 段顺序）
    "overwrite": false,                 // manual：配置与面板文件不一致就按配置重写（true=无条件重写）；locate：已存在就不动
    "auto": {                           // 自动定位参数（mode=locate/auto/batch 时用；本配置用不到）
      "method": "hybrid",
      "at": 1000,
      "frames": 5,
      "span": null,
      "split_x": null,                  //   ⚠ null = **不切分**（整帧一个窗口）。竖屏单直播间是
                                        //   一列评论，按半宽切会把它劈成两半（ctcc 实测两个窗口一起失败）。
      "pad_x": 60,
      "pad_top": 80,
      "pad_y": 16,
      "sub_width": 500,                 //   ⚠ 竖屏整帧裁切必须降下来（1000 时 720x1600 → (1000,2222)
                                        //   = 2.22Mpx，4bit 模型 CUDA OOM）
      "model": "nvidia/LocateAnything-3B",
      "quant": "4bit",
      "device": "cuda",
      "platforms": {                    //   只在 mode=auto/builtin/batch 时用
        "left": "weibo",           //   ⚠ 不切分后唯一的窗口叫 left（写 "comments" 会一个都匹配不上）
        "right": null
      },
      "frame_width": null
    },
    // mode=manual：手写面板，**一段一项**（顺序与 input.videos 展开的段顺序一致）。
    // 段目录里的 panels.json 已经在了 ⇒ 本步不动它（overwrite=false）；这一段的作用是
    // 「白纸重来/删掉某个 segN/panels.json 时，靠它就能把矩形恢复出来」，别让数字只活在 out/ 里。
    "manual": [
      {                                //   seg1  16：38-17：22.mp4  978×2176（微博）
        // 与现有 out/征服8/seg1/panels.json 一致（删掉该文件时靠这一项恢复矩形）：
        // 上沿切在「更多直播」栏之下、第一条评论之上；下沿切在最后一条通知与输入栏之间。
        "comments": {"rect": [10, 950, 950, 1850], "platform": "weibo"}
      },
    ],
    "batch": {                          // mode=batch：稳定性研究（挑固定矩形用；不动 file）
      "count": 30,
      "start": 0.0,
      "span": 600.0,
      "anchor": "panel"
    }
  },

  "parse": {
	"colon_marks": true,
    "sep": " ",                         // 续行拼接用的分隔符                                      --sep
    "max_username_len": 24,             // 冒号前超过这个长度就不当用户名                          --max-username-len
    "merge_continuation": true,         // 是否把「无用户名的行」并进上一条评论；false ⇒ 不并    取反 --no-merge
    "adjacency": true,                  // 「续行必须相邻」守卫；false ⇒ 回到纯文本判续行        取反 --no-adjacency
    "dedup": true,                      // 按滚动对齐跨帧去重出唯一评论表；false ⇒ 每帧各一条    取反 --no-dedup
    "badge_reread": false,              // 等级标二次读数：面板整屏 det+rec 读不出的药丸，按行裁药丸带
                                        //   只跑识别 + 跨帧投票补回来（要配视频）。只补不改
                                        //   **微博关掉**：它按「正文框左边一竖条」裁药丸，而微博的
                                        //   「榜N」药丸在昵称**右边** ⇒ 每条评论白裁一次（见 weibo 档案）
    "calibrate": true,                  // 面板几何自标定（行距/浮层右界/续行；相位逐帧估）     取反 --no-calibrate
    "right_pad": 0,                     // ROI 右边界距面板右边的余量；0 = 贴面板边圈住框外表情   --right-pad
    "emoji_workers": 8                  // 表情扫描线程数；1 = 不开（默认）；4~8 ⇒ 整段快 1.5~2.5×
                                        //   （只影响速度、不改变结果 —— 并行是逐行独立的）
  },

  "output": {
    // 多段时这里是**段的父目录**：实际各写 <dir>/seg1..seg7；
    // 跨段的两个产物也落在这儿：merged_users.json（qualify）+ 抖音/all_users_正面_2张以上/（collect）。
    "dir": "out/征服8",       // 输出根目录                                            --out
    "write": true,                      // 是否写盘（comments.jsonl + summary.json 成对）
    "rows": true,                       // 另存 rows.jsonl（**可回喂复算**）             --dump-rows <段目录>/rows.jsonl
    "panels": true,                     // mode=auto 时把定位结果存成 panels.json         --dump-panels <段目录>/panels.json
    // frames：**抽样帧**一张图 frames/<t>_roi.jpg（≈0.55MB/张），不是每条评论一张。
    // 七段整段跑（按 ctcc 的密度估 ≈4500 帧）≈ 2.5GB ⇒ 默认关，要抽查某几帧时再开。
    "frames": true,                    // 取反 --no-frames
    "print": false                      // 除写盘外也把评论打到 stdout                            --print
  },

  // 评论 → 合格用户：用户名 ≥min_positive 条**正面**评论（正面由大模型判定，表情也发），
  // 并排除用户名命中关键词的官方侧账号。**要花钱**，所以默认关；
  // key **只走环境变量**（本项目铁律：不写进任何配置文件）：
  //   NLP_API_KEY=sk-… $P -m livepipe run livepipe/风云T7.json --only filter
  //
  // ⚠ 本件是**七段素材**，交付要求「该账号 ≥3 条正面」是**按七段合计**判的 ⇒
  //   这里 `min_positive: 1`（只出全量用户表），合格与否交给 `qualify` 步按合计判 ——
  //   否则 seg1 两条 + seg6 两条 = 4 条的那个账号会被判掉两遍（详情见下面 qualify 的注释）。
  "filter": {
    "enabled": true,                    // 打开才会调模型；只想抽评论就先 --skip filter
    "source": null,                     // 评论来源；null ⇒ <段目录>/comments.jsonl
    "out": null,                        // 合格用户 JSONL；null ⇒ <段目录>/users.jsonl
    "cache": null,                      // 判定缓存；null ⇒ 多段共用 <output.dir>/judgments.jsonl
                                        //   （同一句话只判一次：省钱 + 七段口径一致）
    "min_positive": 1,                  // 单段阈值（**合计口径见上面 ⚠**；qualify 一开就自动取 stage_min）
    "exclude_keywords": [               // 用户名含任一即排除（不区分大小写）
      // ⚠ 这份表沿用的是**奇瑞那条线**的（品牌 + 4S + 车型 + 高管姓名）—— 风云是奇瑞旗下的品牌，
      //   主播/官方号名字里带「奇瑞」，所以这份表对它有效；但是否要按本场补官方侧账号
      //   （`风云新能源` 这种主播自己号 / 经销商号），**等名单出来再逐条加**：
      //   填错的代价是**把真观众挡在名单外**，所以宁可先不填。
      "奇瑞", "4s", "店", "qq3", "汽车",
      "尹同跃", "张国忠", "鲍思语", "王津华", "王孝伟", "胡敬源", "尹祥领",
      "王来春", "李晶", "商文江", "杨棉之", "叶盛基", "路风", "黎汝雄",
      "李学用", "张贵兵", "代立宏", "章红玉", "高新华", "戚士龙", "王琅"
    ],
    "nlp": {
      "api_key": "sk-4d55468816fe4637994bf8350217aabf",                  // **留 null**：key 只走环境变量（本项目铁律），
                                        //   写成字符串会跟着配置进仓库
      "api_key_env": "NLP_API_KEY",     // ← 这里是环境变量的**名字**（把 key 写到这行永远取不到，等于没配）
      "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "deepseek-v4.1-flash",   // ⚠ 模型名会随平台改，写错就是 404（不是 key 的问题）；
                                        //   换名前先看一眼现名：curl -s $BASE_URL/models -H "Authorization: Bearer $KEY"
      "batch_size": 20,                 // 一次调用判几条：越大越省，越大越怕一条坏整批
      "concurrency": 4,
      "timeout": 60.0,
      "retries": 3,
      "limit": null,                    // 最多调多少批（控成本）
      "prompt": null                    // null ⇒ 用 user_filter.DEFAULT_PROMPT
    }
  },

  // -------------------------------------------------------------------------
  // 跨段的两步（顺序有依赖：filter（逐段）→ qualify（跨段判合格）→ export（逐段）→ collect（拼树））
  // -------------------------------------------------------------------------

  // 跨段判合格（**全局步**，整批只跑一次）：把七段的 users.jsonl 按**用户名合计**算正面条数，
  // ≥3 的才算合格，再把合格用户**回写**成每段的 users_qualified.jsonl 交给 export。
  // 为什么必须跨段：一个账号 seg1 两条、seg6 两条，合起来 4 条就该交付；各段自判 ≥3 会把它
  // 在两段各判掉一次 —— 名单上少了人，而且是**静默**少的，事后极难发现。
  // 代价：判定量按合计算（≈数倍单段），所以各段 filter 的阈值被强制放到最松（stage_min）。
  "qualify": {
    "enabled": true,                    // 单段素材开着也无害（退化成「按本段判」）
    "min_positive": 2,                  // 交付阈值（**跨段合计**）—— 用户 2026-10-14 拍板「降到 2」
                                        // （参考语料是 3；读数修准后拆出来的档变多，3 会把「真人只说了
                                        //  两次」的一律判掉。交付树目录名跟着变成 `all_users_正面_2张以上`）
    "stage_min": 1                      // 各段 filter/export 用的阈值（先出全量，合格留给这一步判）
  },

  // ⑥ 逐段出交付图（**逐段步**）：读该段 users_qualified.jsonl，按**原帧**画绿框，一人一个目录
  // `<昵称>-<本段条数>`（跨段同名目录由 collect 并成一个）。
  "export": {
    "enabled": true,
    "base": "frame",                    // frame=原帧（参考语料形态）/ annotated=标注图      --base
    "labels": "正面",                   // 只出正面评论                                        --labels
    "min_positive": null,               // null ⇒ qualify.stage_min（合格已在 qualify 判完）
    "min_scope": "platform",            // 平台内各自够数；七段是同一个平台 ⇒ 等同于按合计     --min-scope
    "users": null,                      // null ⇒ <段目录>/users_qualified.jsonl
    "color": "0,255,0", "width": 3,     // 绿框（对齐参考语料）
    "pad": 0, "pad_ratio": 0.25, "quality": 90,
    "force": true                       // 重跑覆盖上一轮的导出目录
  },

  // 拼最终交付树（**全局步**）：把七段的导出目录按**昵称**并成一个账号目录、图号 1..N **跨段连续**，
  // 后缀取**合计**条数（`张三-4`，不再是 `张三-2` + `张三-2-2`），顺带写 正面账号.txt + manifest.json。
  // platform_dir=null ⇒ 从各段导出目录自动认（douyin_app → `抖音`，见 export_user_images.PLATFORM_CN）。
  "collect": {
    "enabled": true,
    "stage_min": null,                  // 各段导出目录名里的数字；null ⇒ qualify.stage_min
    "platform_dir": null,               // 交付树里的平台目录名；null ⇒ 自动认（抖音）
    "out": null,                        // null ⇒ <output.dir>/<平台目录>/all_users_正面_<合计阈值>张以上
    "force": true                       // 目标非空时整棵重来（否则报错退出）
  },

  "draw": {                             // 独立描框步骤（draw_boxes.py）；核心解析已自带逐帧标注图，故默认关
    "enabled": true,
    "source": null,
    "at": 8.0,
    "window": 5.0,
    "out": null,
    "width": 5,
    "quality": 90,
    "labels": true
  },

  "steps": {
    // 顺序**不能乱**：filter（逐段）→ qualify（跨段判合格）→ export（逐段）→ collect（拼树）。
    // 逐段步（panels/parse/filter/export/draw）七段各跑一遍；全局步（emoji_tables/qualify/collect）整批一次。
    "order": ["emoji_tables", "panels", "parse", "filter", "qualify",
              "export", "collect", "draw"],
    "skip": ["emoji_tables", "draw"]    // 表情表已建好（out/douyin_emoji/）；独立描框用不上
  }
}

// ---------------------------------------------------------------------------
// panels.mode 取值：
//   locate   ① 定位评论区 → 写出面板文件（platform 留空），交给人工标注。**工作流第一步**
//   reuse    ② 复用面板文件（人工标注过 platform）→ 按平台处理
//   manual   手写面板（rect + platform）直接写进 file。**本配置**（rect 已量好）
//   auto     解析时自己定位，平台按 auto.platforms 归属（无人值守快捷路径，需 GPU）
//   batch    跑批量定位 + 稳定性统计（挑固定矩形用；不动 file）
//   builtin  用脚本内置的 DEFAULT_PANELS（只对特定录屏有效）
//
// 本件与另外几份素材配置的关系：
//   · ctcc.json —— 视频号**手机 App** 竖屏（同一族的另一平台：等级药丸是 ✦N、x_text 取 30、
//     裁切右沿取 window）。抖音 App 与它**版式最像**（都是行首药丸 + 满宽列表 + 平滑滚动），
//     差异在：抖音的药丸是 ◆N 且 x_text 必须取药丸列**右沿**（96，让折行续行落进「贴左沿」），
//     视频号的续行缩进更浅、靠 wrap_indent 自标定认。
//   · csj.json —— 抖音 + 视频号的**桌面网页版**（row_pitch 68 / x_text 70，双窗口），
//     跟本件的 douyin_app 不是一套数字。
//
// 换素材要重新量的量（本件的量法都在上面各参数的行内注释里）：
//   ① 行距/相位：抽一帧看连续几行的行中心间隔；② x_text：把带冒号的行左沿做直方图，
//   找「真昵称簇」（最大那簇）与「药丸并进正文簇」之间；③ rect：视频底沿、输入框上沿、
//   内容右沿各抓一帧看像素；④ 折行续行 x1：找一条长评论的次行，看它左沿落在哪一段
//   （必须落在 x_text−50 以左，否则要靠 wrap_indent 自标定，静音段会失败）。
// ---------------------------------------------------------------------------
