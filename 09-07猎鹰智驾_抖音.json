      "overlay_cards": "本直播间已接入|三方管理工具|讲解中|奇瑞猎鹰驾辅|新公路之王|勇闯羌塘无人区|立即预约|人已预约|身伤害等直播内容|理性消费|诱导打赏|私下交易|人身财产损失|网络诈骗|实际下载应用|明示信息|闪光语录|新话术|用车场景|智能辅助|性价比|车型配置|走最野的路|荒原上的一天|这车陪你看世界|远方再远|野路子|翻山越岭|露营一把好手|吸烟酗酒|低俗色情|严禁未成年人|关注了主|赞了直播|加入了直播|推荐了直播|^CHERY$|^互动$|^[A-Za-z0-9@#%&+=×?·._\\-/]{1,16}$",

      // 冒号像素检测阈值（见 parsing/ocr/colon.py）：抖音气泡半透明、底偏亮，
      //   默认 bg_max_v=110 会整类短路 ⇒ 放开背景亮度、把亮度差降到 30。
      "colon_bg_max_v": 255,
      "colon_v_delta": 30,

      // OCR 把冒号吃掉时，按像素位置补回文本。
      "colon_text_fix": true,

      // 长表情评论折成多行：第二行没有 OCR 文字、落在两条已检出行之间
      //   ⇒ 抽行时在空档里补扫（emoji_gap_sweep），parse 时把纯表情续行并进上一条
      //   （merge_emoji_continuation）。两个都开才完整。
      "merge_emoji_continuation": true,
      "emoji_gap_sweep": true
    },

    // 下午场是 480×1068（同一版 App，缩放更小）⇒ 行距/列宽全部重测。
    "douyin_app_480": {
      "label": "抖音直播（手机 App 480×1068；行首 ◆N 药丸在昵称左边，整体缩小）",
      "emoji": "douyin",
      "account_key": "username",

      // 行距（像素）—— **实测**（2026-11-09，每文件 4 帧）：相邻评论首行中心差
      //   众数 35.5 / 36.0，取 35.6。
      "row_pitch": 35.6,

      // 首行中心距面板顶（裁剪内坐标）—— 实测首行中心 ≈571（rect y1=550 ⇒ 相位 ~22）。
      "y_phase": 22,

      // 正文列左沿（徽章列右沿，**裁剪内**）—— **实测**：药丸数字 x∈[33,64] ·
      //   真昵称 x1≈67~70 · 折行续行 x1≈25~32。取 **66**。
      "x_text": 66,

      // ROI 左沿 = 66−36 = 30，圈得住最左的 ◆ 药丸。
      "badge_span": 36,

      // 裁切右沿：**按内容**。评论正文最长读到 386，rect x2=480 是上界。
      "x2_from": "content",

      "badge_alias": true,
      "username_alias": true,
      "badge_name_recover": true,

      // 折行续行间距比上限 —— 与 720 档同版式（续行 ~0.75 行距），取 0.85。
      "wrap_gap_ratio": 0.85,

      // 本批 480 档没见到右侧商品卡 / 浮层 ⇒ 不设 x_ignore_from。
      "x_ignore_from": null,

      // 与 720 档共用同一套系统行 / 闪光语录短语。
      "overlay_cards": "本直播间已接入|三方管理工具|讲解中|奇瑞猎鹰驾辅|新公路之王|勇闯羌塘无人区|立即预约|人已预约|身伤害等直播内容|理性消费|诱导打赏|私下交易|人身财产损失|网络诈骗|实际下载应用|明示信息|闪光语录|新话术|用车场景|智能辅助|性价比|车型配置|走最野的路|荒原上的一天|这车陪你看世界|远方再远|野路子|翻山越岭|露营一把好手|吸烟酗酒|低俗色情|严禁未成年人|关注了主|赞了直播|加入了直播|推荐了直播|^CHERY$|^互动$|^[A-Za-z0-9@#%&+=×?·._\\-/]{1,16}$",

      "colon_bg_max_v": 255,
      "colon_v_delta": 30,
      "colon_text_fix": true,
      "merge_emoji_continuation": true,
      "emoji_gap_sweep": true
