{
  "version": 1,
  "name": "猎鹰智驾瑞虎9羌塘无人区（渠道）2026-09-07 · 抖音手机 App · 竖屏",

  // -------------------------------------------------------------------------
  // 平台档案：本批两档分辨率（720×1560 上午 / 480×1068 下午）⇒ 两个档案，
  // 面板文件里分段指定。
  // -------------------------------------------------------------------------
  "platforms": {
    "douyin_app": {
      "label": "抖音直播（手机 App 720×1560；行首 ◆N 粉丝团药丸在昵称左边）",
      "emoji": "douyin",                // → emoji.tables 的 douyin 表（内置，表已建好）

      // 交付认人口径：本批昵称基本不打码 ⇒ 只看昵称。
      //   见 CONFIG.md 的 `account_key` 小节。
      "account_key": "username",

      // 行距（像素）—— **实测**（2026-11-09，每文件 4 帧）：相邻评论首行中心差
      //   众数 53.0 / 52.5 / 51.0，取 53.0（与 09-06 同网格、同行版式）。
      "row_pitch": 53.0,

      // 首行中心距面板顶（裁剪内坐标）—— 实测首行中心 ≈791（rect y1=770 ⇒ 相位 ~22）；
      //   逐帧还会重估，这个只兜底。
      "y_phase": 22,

      // 正文列左沿 = 徽章列右沿（**裁剪内坐标**；rect x1=0 ⇒ 原图坐标）—— **实测**：
      //   药丸数字块 x∈[47,104] · 真昵称 x1≈100 · 折行续行 x1≈37~41。
      //   取 **96**：药丸碎片整块落在左边被丢；续行走整行正文那一支。
      "x_text": 96,

      // ROI 左沿（标注图/交付裁图圈的那一圈）—— 徽章列宽：96−74 = 22 圈住整颗药丸。
      "badge_span": 74,

      // 裁切右沿：**按内容**。评论正文最长读到 549，rect x2=620 留余量；
      //   再往右是商品卡区间（卡块由 x_ignore_from 丢，不进正文）。
      "x2_from": "content",

      // 行首**药丸数字被并进正文** ⇒ 同一人被读成好几个账号，按几何见证归一。
      "badge_alias": true,

      // 昵称**末尾**被检测框切掉 1~2px（或整个末字漏读）⇒ 同一人被拆成两个账号，
      //   按「同一条评论的两种读法同现」归一（normalize_username_alias）。
      "username_alias": true,

      // 等级药丸与昵称被 OCR 并成一块时，把昵称拼回用户名。
      "badge_name_recover": true,

      // 折行续行间距比上限 —— 实测续行 ~39~40px = **0.74~0.76 行距**；
      //   独立评论/通知行实测 ~0.99。取 0.85 夹在两簇中间。
      "wrap_gap_ratio": 0.85,

      // 直播间浮层的左界（裁剪内 x）—— **实测**写死：评论正文块 x1 都 ≤110、
      //   商品讲解卡文字块最小 476（`瑞虎9 2.0T`）⇒ 空带取 **470**。
      "x_ignore_from": 470,

      // 评论列表上的浮层卡 / 提示卡（只作用于**没有冒号**的行）：
